{
  "Database": {
    "AutoMigrate": false,
    "SeedOnStartup": false
  },
  "Authentication": {
    "AdminEmergencyBypassTwoFactor": false,
    "RequireStaffTwoFactor": false
  },
  "Storage": {
    "DataRoot": "",
    "MediaPublicRoot": "",
    "MediaRequestPath": "/uploads/rooms",
    "RequirePersistent": false,
    "MinimumFreeSpaceMb": 0
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Operations": {
    "SlowRequestThresholdMs": 1500,
    "ExposeHealthDetails": false
  },
  "Performance": {
    "PublicCacheEnabled": true,
    "PublicCacheSeconds": 900,
    "PublicCacheWarmupSeconds": 15
  },
  "Ai": {
    "GloballyEnabled": true
  },
  "IdentityDocuments": {
    "RetentionDaysAfterCheckout": 0
  }
}
