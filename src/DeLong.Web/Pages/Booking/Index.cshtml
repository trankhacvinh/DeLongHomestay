@page "/booking"
@model DeLong.Web.Pages.Booking.IndexModel
@{
    ViewData["Title"] = "Đặt phòng";
    ViewData["Robots"] = "noindex,follow";
}

@section Head {
    <link rel="stylesheet" href="~/css/public-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/booking-v2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/booking-conversion.css" asp-append-version="true" />
}

@if (Model.RequiresPropertySelection)
{
    <section class="public-page-hero public-booking-hero"><div class="public-container public-page-hero-inner"><div><span class="public-eyebrow">Đặt phòng online</span><h1>Bạn muốn đặt ở cơ sở nào?</h1><p>Chọn cơ sở trước để hệ thống kiểm tra đúng phòng, giá và lịch trống.</p></div><a class="public-text-link" href="/rooms">Xem tất cả phòng →</a></div></section>
    <section class="public-section"><div class="public-container"><div class="public-branch-grid">@foreach (var property in Model.Properties) { <article class="public-branch-card">@if (!string.IsNullOrWhiteSpace(property.CoverCardUrl)) { <a class="public-branch-media" href="@DeLong.Web.Features.Site.PublicUrlBuilder.Booking(property.SiteSlug)"><img src="@property.CoverCardUrl" alt="@property.SiteName" /></a> }<div class="public-branch-copy"><span class="public-eyebrow">@property.RoomCount phòng</span><h2>@property.SiteName</h2><p>@property.Tagline</p><a class="public-btn public-btn-primary" href="@DeLong.Web.Features.Site.PublicUrlBuilder.Booking(property.SiteSlug)">Đặt tại cơ sở này</a></div></article> }</div></div></section>
}
else
{
<div id="public-booking-page" class="public-booking-page" data-customer-authenticated="@(User.IsInRole("Customer") ? "true" : "false")" v-cloak>
    <script id="public-booking-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>

    <section class="public-page-hero public-booking-hero">
        <div class="public-container public-page-hero-inner">
            <div>
                <span class="public-eyebrow">Đặt phòng online</span>
                <h1>Chọn cách ở phù hợp với bạn</h1>
                <p>Đặt nhanh theo khung giờ hoặc chọn ngày nhận/trả nếu bạn muốn ở nhiều ngày. {{ propertyName }} sẽ liên hệ xác nhận trước khi giữ phòng và nhận cọc.</p>
            </div>
            <a class="public-text-link" v-bind:href="scopePrefix + '/rooms'">Xem mô tả phòng →</a>
        </div>
    </section>

    <section class="public-booking-journey-wrap">
        <div class="public-container">
            <div class="public-booking-journey" aria-label="Quy trình đặt phòng">
                <span v-bind:class="{ active: bookingStep === 1, done: bookingStep > 1 }"><b>01</b>{{ bookingType === 0 ? 'Chọn ngày' : 'Ngày nhận / trả' }}</span>
                <span v-bind:class="{ active: bookingStep === 2, done: bookingStep > 2 }"><b>02</b>Chọn phòng</span>
                <span v-bind:class="{ active: bookingStep === 3, done: bookingStep > 3 }"><b>03</b>{{ bookingType === 0 ? 'Chọn giờ' : 'Xem giá lưu trú' }}</span>
                <span v-bind:class="{ active: bookingStep === 4 }"><b>04</b>Gửi yêu cầu</span>
            </div>
        </div>
    </section>

    <section class="public-section public-booking-section">
        <div class="public-container public-booking-grid">
            <div class="public-booking-main">
                <div class="public-booking-mode" aria-label="Kiểu đặt phòng">
                    <button type="button" v-bind:class="{ active: bookingType === 0 }" v-on:click="switchMode(0)">
                        <strong>Theo khung giờ</strong>
                        <small>Phù hợp nghỉ ngắn, combo hoặc qua đêm theo khung có sẵn.</small>
                    </button>
                    <button type="button" v-bind:class="{ active: bookingType === 1 }" v-on:click="switchMode(1)">
                        <strong>Ở nhiều ngày</strong>
                        <small>Chọn ngày nhận và ngày trả; giá được tính riêng theo từng đêm.</small>
                    </button>
                </div>

                <div class="public-step-card">
                    <div class="public-step-head">
                        <span>01</span>
                        <div>
                            <h2>{{ bookingType === 0 ? 'Chọn ngày' : 'Chọn ngày nhận và ngày trả' }}</h2>
                            <p>{{ bookingType === 0 ? 'Phòng trống được kiểm tra theo từng khung giờ.' : 'Hệ thống kiểm tra phòng trống trên toàn bộ khoảng lưu trú.' }}</p>
                        </div>
                    </div>
                    <label v-if="bookingType === 0" class="public-date-field public-date-field-block">
                        <span>Ngày sử dụng</span>
                        <input type="date" v-model="date" v-bind:min="today" v-on:change="loadAvailability" required />
                    </label>
                    <div v-else class="public-stay-dates">
                        <label class="public-date-field public-date-field-block">
                            <span>Ngày nhận phòng</span>
                            <input type="date" v-model="checkInDate" v-bind:min="today" v-on:change="stayDatesChanged" required />
                        </label>
                        <label class="public-date-field public-date-field-block">
                            <span>Ngày trả phòng</span>
                            <input type="date" v-model="checkOutDate" v-bind:min="minimumCheckOut" v-on:change="loadStayAvailability" required />
                        </label>
                    </div>
                </div>

                <div id="booking-room-step" class="public-step-card">
                    <div class="public-step-head">
                        <span>02</span>
                        <div>
                            <h2>Chọn phòng</h2>
                            <p>{{ bookingType === 0 ? 'Nhấn một phòng để xem các khung còn trống.' : 'Chỉ các phòng đã cấu hình giá theo đêm mới xuất hiện ở đây.' }}</p>
                        </div>
                    </div>
                    <div class="public-conversion-loading" v-if="loading" role="status" aria-live="polite"><span class="public-loading-dot"></span><span>Đang kiểm tra phòng trống…</span></div>
                    <div class="public-inline-status error" v-else-if="availabilityError" role="alert"><div><strong>Chưa kiểm tra được phòng trống</strong><p>{{ availabilityError }}</p></div><button class="public-btn public-btn-ghost" type="button" v-on:click="reloadAvailability">Thử lại</button></div>
                    <div class="public-booking-room-list" v-else-if="roomList.length">
                        <button v-for="room in roomList" v-bind:key="room.id" type="button" class="public-booking-room"
                                v-bind:class="{ active: selectedRoomId === room.id, disabled: !roomSelectable(room) }"
                                v-bind:disabled="!roomSelectable(room)" v-on:click="chooseRoom(room)">
                            <span class="public-mini-room-art public-mini-room-photo" v-if="roomImage(room)">
                                <img v-bind:src="roomImage(room).thumbnailUrl" v-bind:alt="roomImage(room).altText || room.name" loading="lazy" />
                            </span>
                            <span v-else class="public-mini-room-art" v-bind:data-room-code="room.code">{{ room.code.split('-').slice(-1)[0] }}</span>
                            <span class="public-booking-room-copy">
                                <strong>{{ room.name }}</strong>
                                <small v-if="bookingType === 0">{{ room.capacity }} người · từ {{ money(room.fromPrice) }}</small>
                                <small v-else>{{ room.capacity }} người · {{ money(room.nightlyRate.price) }}/đêm</small>
                            </span>
                            <template v-if="bookingType === 0">
                                <span class="public-booking-room-state" v-if="availableCount(room) > 0">{{ availableCount(room) }} khung trống</span>
                                <span class="public-booking-room-state sold" v-else>Hết khung</span>
                            </template>
                            <template v-else>
                                <span class="public-booking-room-state" v-if="room.available">Còn phòng</span>
                                <span class="public-booking-room-state sold" v-else>Đã có khách</span>
                            </template>
                        </button>
                    </div>
                    <div class="public-booking-room-mobile-actions" v-if="selectedRoom && !loading">
                        <button type="button" v-on:click="openRoomPreview(selectedRoom)">Chi tiết phòng</button>
                        <button type="button" v-if="roomImageCount(selectedRoom) > 0" v-on:click="openRoomGallery(selectedRoom)">Xem ảnh ({{ roomImageCount(selectedRoom) }})</button>
                    </div>
                    <div v-if="!loading && !availabilityError && roomList.length && selectableRoomCount === 0" class="public-inline-status empty"><div><strong>{{ bookingType === 0 ? 'Ngày này đã hết khung phù hợp' : 'Khoảng ngày này chưa còn phòng' }}</strong><p>Đổi ngày để kiểm tra lại hoặc xem mô tả các phòng khác trước khi chọn.</p></div><button class="public-btn public-btn-ghost" type="button" v-on:click="focusDateInput">Đổi ngày</button></div>
                    <div v-else-if="bookingType === 1 && !loading && !availabilityError && !roomList.length" class="public-stay-empty">
                        <strong>Chưa mở đặt nhiều ngày online</strong>
                        Hiện chưa có phòng nào được cấu hình giá lưu trú theo đêm. Bạn có thể chọn “Theo khung giờ” hoặc liên hệ {{ propertyName }} để được tư vấn.
                    </div>
                    <div v-else-if="bookingType === 0 && !loading && !availabilityError && !roomList.length" class="public-inline-status empty"><div><strong>Chưa có phòng để đặt online</strong><p>Hãy thử tải lại hoặc xem danh sách phòng của {{ propertyName }}.</p></div><button class="public-btn public-btn-ghost" type="button" v-on:click="reloadAvailability">Tải lại</button></div>
                </div>

                <div id="booking-rate-step" class="public-step-card" v-if="selectedRoom">
                    <div class="public-step-head">
                        <span>03</span>
                        <div>
                            <h2>{{ bookingType === 0 ? 'Chọn khung giờ' : 'Giá và giờ lưu trú' }}</h2>
                            <p>{{ bookingType === 0 ? 'Giá hiển thị là giá của khung đặt nhanh.' : 'Giá/đêm và giờ nhận/trả được cấu hình riêng cho phòng này.' }}</p>
                        </div>
                    </div>
                    <div v-if="bookingType === 0" class="public-rate-choice-grid">
                        <button v-for="rate in timeSlotRates(selectedRoom)" v-bind:key="rate.id" type="button" class="public-rate-choice"
                                v-bind:class="{ active: selectedRateId === rate.id, disabled: !rate.available }" v-bind:disabled="!rate.available"
                                v-on:click="selectedRateId = rate.id">
                            <span><strong>{{ rate.name }}</strong><small>{{ rate.startTime }} → {{ rate.endTime }} <template v-if="rate.type === 1">· qua đêm</template></small></span>
                            <strong>{{ money(rate.price) }}</strong>
                        </button>
                    </div>
                    <div v-else class="public-nightly-summary">
                        <div class="public-nightly-summary-copy">
                            <strong>{{ selectedRate.name }}</strong>
                            <small>Nhận phòng {{ selectedRate.startTime }} · Trả phòng {{ selectedRate.endTime }} ngày cuối</small>
                            <span class="public-summary-night-count">{{ stayNights }} đêm</span>
                        </div>
                        <div class="public-nightly-price">
                            <strong>{{ money(selectedRoom.totalAmount) }}</strong>
                            <small>{{ stayNights }} × {{ money(selectedRate.price) }}</small>
                        </div>
                    </div>
                </div>

                <div id="booking-contact-step" class="public-step-card public-contact-step" v-if="selectedRate">
                    <div class="public-step-head"><span>04</span><div><h2>Thông tin liên hệ</h2><p>Nhân viên sẽ gọi lại để xác nhận phòng và tiền cọc.</p></div></div>
                    <div class="public-form-grid">
                        <label v-bind:class="{ invalid: fieldErrors.customerPhone }"><span>Số điện thoại *</span><input ref="customerPhone" data-booking-customer-phone v-model.trim="form.customerPhone" v-on:input="clearFieldError('customerPhone')" v-bind:aria-invalid="!!fieldErrors.customerPhone" maxlength="30" inputmode="tel" autocomplete="off" placeholder="09xx xxx xxx" /><small class="public-field-error" v-if="fieldErrors.customerPhone">{{ fieldErrors.customerPhone }}</small></label>
                        <label v-bind:class="{ invalid: fieldErrors.customerName }"><span>Họ và tên *</span><input ref="customerName" data-booking-customer-name v-model.trim="form.customerName" v-on:input="clearFieldError('customerName')" v-bind:aria-invalid="!!fieldErrors.customerName" maxlength="200" autocomplete="off" placeholder="Nguyễn Minh Anh" /><small class="public-field-error" v-if="fieldErrors.customerName">{{ fieldErrors.customerName }}</small></label>
                        <label class="public-form-full"><span>Ghi chú</span><textarea v-model.trim="form.note" maxlength="1000" placeholder="Ví dụ: muốn nhận phòng trễ hơn 30 phút..."></textarea></label>
                        <label class="public-honeypot" aria-hidden="true"><span>Website</span><input v-model="form.website" tabindex="-1" autocomplete="off" /></label>
                    </div>
                    <div class="public-booking-notice">Yêu cầu này <strong>chưa tự động giữ phòng</strong>. {{ propertyName }} sẽ liên hệ xác nhận trước khi lượt đặt chuyển sang trạng thái giữ/xác nhận.</div>
                    <button class="public-btn public-btn-primary public-submit-booking" type="button" v-bind:disabled="submitting" v-on:click="submitRequest">{{ submitting ? 'Đang gửi...' : 'Gửi yêu cầu đặt phòng' }}</button>
                    <p class="public-form-error" v-if="errorMessage">{{ errorMessage }}</p>
                </div>
            </div>

            <aside class="public-booking-summary" v-if="selectedRoom && selectedRate">
                <div class="public-summary-room-art public-summary-room-photo" v-if="roomImage(selectedRoom)">
                    <img v-bind:src="roomImage(selectedRoom).cardUrl" v-bind:alt="roomImage(selectedRoom).altText || selectedRoom.name" />
                </div>
                <div v-else class="public-summary-room-art" v-bind:data-room-code="selectedRoom.code">
                    <small>{{ propertyName }}</small>
                    <strong>{{ selectedRoom.name }}</strong>
                </div>
                <div class="public-summary-content">
                    <span class="public-eyebrow">Yêu cầu của bạn</span>
                    <h3>{{ selectedRoom.name }}</h3>
                    <div class="public-summary-room-actions">
                        <button type="button" v-on:click="openRoomPreview(selectedRoom)">Chi tiết phòng</button>
                        <button type="button" v-if="roomImageCount(selectedRoom) > 0" v-on:click="openRoomGallery(selectedRoom)">Xem ảnh ({{ roomImageCount(selectedRoom) }})</button>
                    </div>
                    <dl v-if="bookingType === 0">
                        <div><dt>Ngày</dt><dd>{{ dateText }}</dd></div>
                        <div><dt>Khung giờ</dt><dd>{{ selectedRate.startTime }} → {{ selectedRate.endTime }}</dd></div>
                        <div><dt>Gói</dt><dd>{{ selectedRate.name }}</dd></div>
                        <div class="total"><dt>Tạm tính</dt><dd>{{ money(selectedRate.price) }}</dd></div>
                    </dl>
                    <dl v-else>
                        <div><dt>Nhận phòng</dt><dd>{{ stayDateText(checkInDate) }} · {{ selectedRate.startTime }}</dd></div>
                        <div><dt>Trả phòng</dt><dd>{{ stayDateText(checkOutDate) }} · {{ selectedRate.endTime }}</dd></div>
                        <div><dt>Thời gian</dt><dd>{{ stayNights }} đêm</dd></div>
                        <div><dt>Giá mỗi đêm</dt><dd>{{ money(selectedRate.price) }}</dd></div>
                        <div class="total"><dt>Tạm tính</dt><dd>{{ money(selectedRoom.totalAmount) }}</dd></div>
                    </dl>
                    <p>Giờ thực tế có thể được nhân viên điều chỉnh khi xác nhận theo ghi chú của bạn.</p>
                </div>
            </aside>
        </div>
    </section>

    <div class="public-booking-room-modal-backdrop" v-if="roomPreview.open" v-on:click.self="closeRoomPreview">
        <section class="public-booking-room-modal" role="dialog" aria-modal="true" aria-label="Chi tiết phòng">
            <div class="public-booking-room-modal-head"><div><span class="public-eyebrow">Xem nhanh phòng</span><h2>{{ roomPreview.data?.name || selectedRoom?.name || 'Chi tiết phòng' }}</h2></div><button type="button" aria-label="Đóng" v-on:click="closeRoomPreview">×</button></div>
            <div class="public-conversion-loading" v-if="roomPreview.loading"><span class="public-loading-dot"></span><span>Đang tải chi tiết phòng…</span></div>
            <div class="public-inline-status error" v-else-if="roomPreview.error"><div><strong>Chưa xem được phòng</strong><p>{{ roomPreview.error }}</p></div></div>
            <div class="public-booking-room-preview" v-else-if="roomPreview.data">
                <img class="public-booking-room-preview-cover" v-if="roomPreview.data.images && roomPreview.data.images.length" v-bind:src="roomPreview.data.images[0].cardUrl || roomPreview.data.images[0].largeUrl" v-bind:alt="roomPreview.data.images[0].altText || roomPreview.data.name" />
                <div class="public-booking-room-preview-copy">
                    <p>{{ roomPreview.data.shortDescription || ('Không gian riêng tư dành cho tối đa ' + roomPreview.data.capacity + ' người.') }}</p>
                    <div class="public-booking-room-preview-facts"><span><strong>{{ roomPreview.data.capacity }}</strong><small>người tối đa</small></span><span><strong>{{ money(roomPreview.data.quickFromPrice) }}</strong><small>giá từ</small></span><span v-if="roomPreview.data.images"><strong>{{ roomPreview.data.images.length }}</strong><small>ảnh</small></span></div>
                    <div v-if="roomPreview.data.highlights && roomPreview.data.highlights.length"><h3>Điểm nổi bật</h3><div class="public-booking-room-preview-chips"><span v-for="item in roomPreview.data.highlights.slice(0, 5)" v-bind:key="item">✓ {{ item }}</span></div></div>
                    <div v-if="roomPreview.data.amenities && roomPreview.data.amenities.length"><h3>Tiện nghi</h3><div class="public-booking-room-preview-chips"><span v-for="item in roomPreview.data.amenities.slice(0, 8)" v-bind:key="item">{{ item }}</span></div></div>
                </div>
            </div>
            <div class="public-booking-room-modal-actions" v-if="roomPreview.data"><button class="public-btn public-btn-ghost" type="button" v-if="roomPreview.data.images && roomPreview.data.images.length" v-on:click="openGalleryFromPreview">Xem ảnh ({{ roomPreview.data.images.length }})</button><a class="public-btn public-btn-primary" v-bind:href="roomDetailUrl(roomPreview.data)" target="_blank" rel="noopener">Vào trang chi tiết ↗</a></div>
        </section>
    </div>

    <div class="public-booking-gallery-backdrop" v-if="gallery.open" v-on:click.self="closeGallery">
        <section class="public-booking-gallery" role="dialog" aria-modal="true" v-bind:aria-label="'Thư viện ảnh ' + gallery.roomName">
            <div class="public-booking-gallery-head"><div><span class="public-eyebrow">Thư viện phòng</span><h2>{{ gallery.roomName }}</h2></div><div><span v-if="gallery.images.length">{{ gallery.index + 1 }} / {{ gallery.images.length }}</span><button type="button" aria-label="Đóng" v-on:click="closeGallery">×</button></div></div>
            <div class="public-conversion-loading" v-if="gallery.loading"><span class="public-loading-dot"></span><span>Đang tải thư viện ảnh…</span></div>
            <div class="public-inline-status error" v-else-if="gallery.error"><div><strong>Chưa xem được ảnh</strong><p>{{ gallery.error }}</p></div></div>
            <div class="public-booking-gallery-stage" v-else-if="galleryImage">
                <button class="public-booking-gallery-nav previous" type="button" aria-label="Ảnh trước" v-if="gallery.images.length > 1" v-on:click="previousGalleryImage">‹</button>
                <img v-bind:src="galleryImage.largeUrl" v-bind:alt="galleryImage.altText || gallery.roomName" />
                <button class="public-booking-gallery-nav next" type="button" aria-label="Ảnh tiếp theo" v-if="gallery.images.length > 1" v-on:click="nextGalleryImage">›</button>
            </div>
            <div class="public-booking-gallery-thumbs" v-if="gallery.images.length > 1"><button type="button" v-for="(image, index) in gallery.images" v-bind:key="image.id" v-bind:class="{ active: index === gallery.index }" v-on:click="setGalleryImage(index)"><img v-bind:src="image.thumbnailUrl || image.cardUrl" v-bind:alt="image.altText || gallery.roomName" /></button></div>
        </section>
    </div>

    <div class="public-booking-mobile-bar" v-if="selectedRoom && selectedRate" aria-live="polite">
        <div><small>{{ selectedRoom.name }} · {{ bookingType === 0 ? dateText : stayNights + ' đêm' }}</small><strong>{{ bookingTotalText }}</strong></div>
        <button class="public-btn public-btn-primary" type="button" v-bind:disabled="submitting" v-on:click="mobilePrimaryAction">{{ submitting ? 'Đang gửi…' : (canSubmit ? 'Gửi yêu cầu' : 'Nhập thông tin') }}</button>
    </div>
</div>
}

@section Scripts {
    <script src="~/js/pages/public-booking.js" asp-append-version="true"></script>
}
