@page "/booking/lookup"
@model DeLong.Web.Pages.Booking.LookupModel
@inject DeLong.Web.Features.Site.SiteContentService SiteContentService
@{
    ViewData["Title"] = "Tra cứu đặt phòng";
    ViewData["Robots"] = "noindex,follow";
    ViewData["MetaDescription"] = "Tra cứu đặt phòng bằng mã và số điện thoại, hoặc nhận thông tin qua email đã dùng đặt phòng.";
    var lookupContacts = await SiteContentService.GetPublicContactsAsync(HttpContext.RequestAborted);
    var lookupHotline = lookupContacts
        .Where(x => Model.SiteSlug is null || string.Equals(x.SiteSlug, Model.SiteSlug, StringComparison.OrdinalIgnoreCase))
        .Select(x => x.Phone).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
}

@section Head {
    <link rel="stylesheet" href="~/css/booking-lookup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/booking-guide.css" asp-append-version="true" />
}

<section class="lux-page-hero" aria-labelledby="lookup-title">
    <span class="lux-page-hero-moon" aria-hidden="true"></span>
    <span class="lux-page-hero-arch" aria-hidden="true"></span>
    <div class="public-container">
        <span class="lux-eyebrow">Tra cứu đơn</span>
        <h1 id="lookup-title" class="lux-display">Đơn của bạn <em>đang ở đâu?</em></h1>
        <p>Nhập mã đặt phòng và số điện thoại đã dùng khi đặt để xem trạng thái đơn, hoặc nhận thông tin qua email.</p>
    </div>
</section>

<main id="booking-lookup" class="lookup-page lux-paper" v-cloak data-site-slug="@Model.SiteSlug">
    <section class="public-container lookup-shell lux-lookup-shell">
        <form class="lookup-form" v-on:submit.prevent="lookup">
            <fieldset class="lookup-modes">
                <legend>Cách tra cứu</legend>
                <label><input type="radio" value="code" v-model="mode" v-bind:disabled="loading" v-on:change="resetResult" /> Mã đặt phòng + SĐT</label>
                <label><input type="radio" value="email" v-model="mode" v-bind:disabled="loading" v-on:change="resetResult" /> Nhận qua email</label>
            </fieldset>
            <label v-if="mode === 'code'">
                <span>Mã đặt phòng</span>
                <input v-model.trim="form.code" autocomplete="off" maxlength="50" placeholder="Ví dụ: BK7M4P9X2A" required />
            </label>
            <label v-if="mode === 'code'">
                <span>Số điện thoại</span>
                <input v-model.trim="form.phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" placeholder="09xx xxx xxx" required />
            </label>
            <label class="lookup-email-field" v-if="mode === 'email'">
                <span>Email đã dùng đặt phòng</span>
                <input v-model.trim="email" type="email" autocomplete="email" maxlength="320" placeholder="ten@email.com" required />
                <small>Thông tin được gửi về email, không hiển thị trên website.</small>
            </label>
            <button class="public-btn public-btn-primary" type="submit" v-bind:disabled="loading || !canSubmit">
                {{ loading ? 'Đang xử lý…' : (mode === 'email' ? 'Gửi thông tin về email' : 'Tra cứu đặt phòng') }}
            </button>
            <p class="lookup-error" v-if="error">{{ error }}</p>
            <p class="lookup-message" v-if="message" role="status">{{ message }}</p>
        </form>

        <article class="lookup-result" v-if="result" aria-live="polite">
            <header>
                <div>
                    <span class="public-eyebrow">{{ result.code }}</span>
                    <h2>{{ result.roomName }}</h2>
                    <p>{{ result.customerName }}</p>
                </div>
                <span class="lookup-status" v-bind:data-status="result.status">{{ result.statusLabel }}</span>
            </header>

            <ol class="lux-timeline" v-if="timeline" aria-label="Tiến trình đơn">
                <li v-for="step in timeline" v-bind:key="step.label" v-bind:class="{ 'is-done': step.done }"><i aria-hidden="true"></i><span>{{ step.label }}</span></li>
            </ol>

            <dl class="lookup-details">
                <div><dt>Hình thức</dt><dd>{{ result.bookingType }}</dd></div>
                <div><dt>Nhận phòng</dt><dd>{{ dateTime(result.checkInLocal) }}</dd></div>
                <div><dt>Trả phòng</dt><dd>{{ dateTime(result.checkOutLocal) }}</dd></div>
                <div v-if="result.nightCount"><dt>Số đêm</dt><dd>{{ result.nightCount }} đêm</dd></div>
            </dl>

            <div class="lookup-money">
                <div><span>Tổng tiền</span><strong>{{ money(result.totalAmount) }}</strong></div>
                <div><span>Đã thanh toán</span><strong>{{ money(result.paidAmount) }}</strong></div>
                <div class="balance"><span>Còn lại</span><strong>{{ money(result.balance) }}</strong></div>
            </div>

            <section class="lookup-guide" v-if="result.guestGuideHtml">
                <div class="lookup-guide-head"><div><span class="public-eyebrow">Hướng dẫn phòng</span><h3>Nhận phòng, sử dụng và quy định</h3></div><button class="public-btn public-btn-ghost" type="button" v-bind:disabled="downloadingGuide" v-on:click="downloadGuide">{{ downloadingGuide ? 'Đang tạo PDF…' : 'Tải PDF' }}</button></div>
                <div class="public-rich-copy lookup-guide-copy" v-html="result.guestGuideHtml"></div>
            </section>

            <footer v-if="result.propertyPhone || result.propertyAddress">
                <strong>Cần hỗ trợ?</strong>
                <span v-if="result.propertyPhone">{{ result.propertyPhone }}</span>
                <span v-if="result.propertyAddress">{{ result.propertyAddress }}</span>
            </footer>
        </article>

        <div class="lux-lookup-cards">
            <article class="lux-lookup-card">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
                <h3>Mã đặt phòng ở đâu?</h3>
                <p>Mã hiển thị trên trang hoàn tất đặt phòng. Nếu chưa lưu lại, chọn “Nhận qua email” ở trên để nhận thông tin đơn.</p>
            </article>
            <article class="lux-lookup-card">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                <h3>Chưa thanh toán?</h3>
                <p>Đơn chưa thanh toán sẽ tự hết hạn khi hết thời gian giữ phòng hiển thị lúc thanh toán. Hãy đặt lại trên lịch phòng.</p>
            </article>
            <article class="lux-lookup-card is-dark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"></path></svg>
                <h3>Cần hỗ trợ</h3>
                @if (!string.IsNullOrWhiteSpace(lookupHotline))
                {
                    <p>Hotline <a href="tel:@lookupHotline.Replace(" ", string.Empty)">@lookupHotline</a>. Nhân viên kiểm tra đơn và đổi lịch giúp bạn.</p>
                }
                else
                {
                    <p>Liên hệ cơ sở qua thông tin ở cuối trang. Nhân viên kiểm tra đơn và đổi lịch giúp bạn.</p>
                }
            </article>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/pages/booking-lookup.js" asp-append-version="true"></script>
}
