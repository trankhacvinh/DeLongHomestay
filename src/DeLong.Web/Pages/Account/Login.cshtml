@page
@model DeLong.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<section class="auth-wrap">
    <form method="post" class="auth-card">
        <span class="eyebrow">Admin</span>
        <h1>Đăng nhập quản trị</h1>
        <p class="muted">Tài khoản production dùng ASP.NET Core Identity.</p>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <div class="field"><label asp-for="Input.Email"></label><input asp-for="Input.Email" autocomplete="username" /><span asp-validation-for="Input.Email" class="validation"></span></div>
        <div class="field"><label asp-for="Input.Password"></label><input asp-for="Input.Password" autocomplete="current-password" /><span asp-validation-for="Input.Password" class="validation"></span></div>
        <label class="check-row"><input asp-for="Input.RememberMe" /> Ghi nhớ đăng nhập</label>
        <button class="btn btn-primary" type="submit">Đăng nhập</button>
    </form>
</section>
