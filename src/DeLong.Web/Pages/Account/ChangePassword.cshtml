@page
@model DeLong.Web.Pages.Account.ChangePasswordModel
@{
    Layout = Model.IsRequired ? "_AuthLayout" : "_AdminLayout";
    ViewData["Title"] = Model.IsRequired ? "Đổi mật khẩu tạm" : "Đổi mật khẩu";
    var backUrl = Model.ReturnUrl ?? Url.Page("/Admin/Index") ?? "/Admin";
}
@if (!Model.IsRequired)
{
    <div class="page-header mb-3">
        <div class="page-pretitle">Bảo mật tài khoản</div>
        <h1 class="page-title">Đổi mật khẩu</h1>
    </div>
}
<form method="post" class="card @(Model.IsRequired ? "dl-auth-card" : string.Empty)" style="@(Model.IsRequired ? null : "max-width:34rem")">
    <div class="card-body d-grid gap-3">
        @if (Model.IsRequired)
        {
            <div>
                <div class="page-pretitle">Bảo mật tài khoản</div>
                <h1 class="h2 mb-1">Tạo mật khẩu riêng của bạn</h1>
                <p class="text-secondary mb-0">Bạn đang đăng nhập bằng mật khẩu tạm do quản trị viên cấp. Hãy đổi mật khẩu trước khi tiếp tục sử dụng hệ thống.</p>
            </div>
        }
        else
        {
            <p class="text-secondary mb-0">Đổi mật khẩu của tài khoản đang đăng nhập. Sau khi lưu, phiên hiện tại sẽ được làm mới và bạn có thể tiếp tục công việc.</p>
        }

        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <div>
            <label class="form-label" asp-for="Input.CurrentPassword"></label>
            <input class="form-control" asp-for="Input.CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
        </div>
        <div>
            <label class="form-label" asp-for="Input.NewPassword"></label>
            <input class="form-control" asp-for="Input.NewPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
        </div>
        <div>
            <label class="form-label" asp-for="Input.ConfirmPassword"></label>
            <input class="form-control" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
        </div>

        <div class="text-secondary small">Mật khẩu mới cần ít nhất 8 ký tự. Không dùng lại mật khẩu tạm hoặc mật khẩu đang chia sẻ ở dịch vụ khác.</div>

        <div class="d-flex gap-2 justify-content-end">
            @if (!Model.IsRequired)
            {
                <a class="btn" href="@backUrl">Quay lại</a>
            }
            <button class="btn btn-primary" type="submit">Lưu mật khẩu mới</button>
        </div>
    </div>
</form>
