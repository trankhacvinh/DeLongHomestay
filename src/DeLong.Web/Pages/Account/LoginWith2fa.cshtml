@page
@model DeLong.Web.Pages.Account.LoginWith2faModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Xác minh đăng nhập";
}
<form method="post" class="card dl-auth-card">
    <div class="card-body d-grid gap-3">
        <div>
            <div class="page-pretitle">Bảo mật</div>
            <h1 class="h2 mb-1">Xác minh đăng nhập</h1>
            <p class="text-secondary mb-0">Tài khoản này đã bật Google Authenticator. Nhập mã 6 số hiện tại để tiếp tục.</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
        <div>
            <label class="form-label" asp-for="Input.Code"></label>
            <input class="form-control" asp-for="Input.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" autofocus />
            <span asp-validation-for="Input.Code" class="text-danger small"></span>
        </div>
        <label class="form-check m-0"><input class="form-check-input" asp-for="Input.RememberBrowser" /><span class="form-check-label">Tin cậy trình duyệt này</span></label>
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <input type="hidden" name="rememberMe" value="@Model.RememberMe.ToString().ToLowerInvariant()" />
        <button class="btn btn-primary w-100" type="submit">Xác minh</button>
        <a class="btn w-100" asp-page="/Account/Login">Quay lại đăng nhập</a>
    </div>
</form>
