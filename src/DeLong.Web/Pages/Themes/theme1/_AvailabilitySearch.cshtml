@* Theme 1 · AvailabilitySearch block (moved unchanged from Index.cshtml). *@
@model DeLong.Web.Pages.Themes.ThemeSectionModel
@using System.Text.Json
@using System.Text.Json.Nodes
@using DeLong.Web.Features.Site
@using DeLong.Web.Pages.Themes
@{
    var Page = Model.Page;
    var H = Model.Home;
    var block = Model.Block;
    var siteName = H.SiteName;
    var roomCount = H.RoomCount;
    var fromPrice = H.FromPrice;
    var heroPriceShort = H.HeroPriceShort;
    var roomMarqueeText = H.RoomMarqueeText;
    string Text(JsonObject content, string key, string fallback = "") => ThemeHomeContext.Text(content, key, fallback);
    string V(JsonObject content, string path, bool image = false) => H.V(content, path, image);
    string Variant(string variant) => H.Variant(variant);
    string? RoomTone(Guid roomId) => H.RoomTone(roomId);
    string ScopedUrl(string url) => H.ScopedUrl(url);
}
@{
    var title = Text(block.Content, "title", "Chọn cơ sở và ngày bạn muốn ghé");
    <section class="public-check-section public-cms-availability variant-@(Variant(block.Variant))"><div class="public-container"><form class="public-check-card public-global-check-card" method="get" action="/booking"><div><span class="public-eyebrow">Đặt phòng nhanh</span><h2 class="@(V(block.Content, "title"))">@PublicTitleAccent.Render(title)</h2></div>@if (Page.GlobalCatalog.Properties.Count > 1) { <label class="public-date-field"><span>Cơ sở</span><select name="site" required><option value="">Chọn cơ sở</option>@foreach (var property in Page.GlobalCatalog.Properties) { <option value="@property.SiteSlug">@property.SiteName</option> }</select></label> } else if (Page.GlobalCatalog.Properties.Count == 1) { <input type="hidden" name="site" value="@Page.GlobalCatalog.Properties[0].SiteSlug" /> }<label class="public-date-field"><span>Ngày sử dụng</span><input type="date" name="date" value="@Page.DefaultDate" required /></label><button class="public-btn public-btn-primary" type="submit" @(Page.GlobalCatalog.Properties.Count == 0 ? "disabled" : null)>Tìm phòng</button></form></div></section>
}
