@* Theme 1 · FeatureGrid block (moved unchanged from Index.cshtml). *@
@model DeLong.Web.Pages.Themes.ThemeSectionModel
@using System.Text.Json
@using System.Text.Json.Nodes
@using DeLong.Web.Features.Site
@using DeLong.Web.Pages.Themes
@{
    var Page = Model.Page;
    var H = Model.Home;
    var block = Model.Block;
    var siteName = H.SiteName;
    var roomCount = H.RoomCount;
    var fromPrice = H.FromPrice;
    var heroPriceShort = H.HeroPriceShort;
    var roomMarqueeText = H.RoomMarqueeText;
    string Text(JsonObject content, string key, string fallback = "") => ThemeHomeContext.Text(content, key, fallback);
    string V(JsonObject content, string path, bool image = false) => H.V(content, path, image);
    string Variant(string variant) => H.Variant(variant);
    string? RoomTone(Guid roomId) => H.RoomTone(roomId);
    string ScopedUrl(string url) => H.ScopedUrl(url);
}
@{
    if (Page.ThemeStandard) { <text>@Html.Raw(ThemeHomeContext.HowBand(block.Content, siteName.ToUpperInvariant()))</text> }
    else
    {
    var items = block.Content["items"] as JsonArray;
    var featureImage = Text(block.Content, "imageUrl");
    if (string.IsNullOrWhiteSpace(featureImage)) featureImage = Page.GlobalCatalog.Properties.Select(x => x.CoverCardUrl).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? string.Empty;
    <section class="public-section public-section-soft public-cms-feature variant-@(Variant(block.Variant))"><div class="public-container public-story-shell @(!string.IsNullOrWhiteSpace(featureImage) ? "has-media" : string.Empty)">@if (!string.IsNullOrWhiteSpace(featureImage)) { <figure class="public-story-media @(V(block.Content, "imageUrl", true))"><img src="@featureImage" alt="Không gian tại @siteName" loading="lazy" /></figure> }<div class="public-story-grid"><div><span class="public-eyebrow @(V(block.Content, "eyebrow"))">@Text(block.Content, "eyebrow", siteName.ToUpperInvariant())</span><h2 class="@(V(block.Content, "title"))">@PublicTitleAccent.Render(Text(block.Content, "title"))</h2></div><div class="public-story-copy"><p class="@(V(block.Content, "body"))">@Text(block.Content, "body")</p>@if (items is not null) { <div class="public-benefits">@foreach (var pair in items.Select((item, index) => new { Item = item, Index = index })) { if (!string.IsNullOrWhiteSpace(pair.Item?.ToString())) { <span class="@(V(block.Content, $"items.{pair.Index}"))">@pair.Item</span> } }</div> }</div></div></div></section>
    }
}
