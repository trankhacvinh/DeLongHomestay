@* Theme 1 · Faq block (moved unchanged from Index.cshtml). *@
@model DeLong.Web.Pages.Themes.ThemeSectionModel
@using System.Text.Json
@using System.Text.Json.Nodes
@using DeLong.Web.Features.Site
@using DeLong.Web.Pages.Themes
@{
    var Page = Model.Page;
    var H = Model.Home;
    var block = Model.Block;
    var siteName = H.SiteName;
    var roomCount = H.RoomCount;
    var fromPrice = H.FromPrice;
    var heroPriceShort = H.HeroPriceShort;
    var roomMarqueeText = H.RoomMarqueeText;
    string Text(JsonObject content, string key, string fallback = "") => ThemeHomeContext.Text(content, key, fallback);
    string V(JsonObject content, string path, bool image = false) => H.V(content, path, image);
    string Variant(string variant) => H.Variant(variant);
    string? RoomTone(Guid roomId) => H.RoomTone(roomId);
    string ScopedUrl(string url) => H.ScopedUrl(url);
}
@{
    var faqItems = block.Content["items"] as JsonArray;
    <section class="public-section public-story-faq variant-@(Variant(block.Variant))"><div class="public-container"><div class="public-section-head"><div><span class="public-eyebrow @(V(block.Content, "eyebrow"))">@Text(block.Content, "eyebrow", "HỎI ĐÁP")</span><h2 class="@(V(block.Content, "title"))">@PublicTitleAccent.Render(Text(block.Content, "title", "Câu hỏi thường gặp"))</h2></div></div>@if (faqItems is not null) { <div class="public-faq-list">@foreach (var pair in faqItems.OfType<JsonObject>().Select((item, index) => new { Item = item, Index = index })) { var question = Text(pair.Item, "question"); var answer = Text(pair.Item, "answer"); if (!string.IsNullOrWhiteSpace(question) && !string.IsNullOrWhiteSpace(answer)) { <details><summary class="@(V(block.Content, $"items.{pair.Index}.question"))">@question<span>+</span></summary><p class="@(V(block.Content, $"items.{pair.Index}.answer"))">@answer</p></details> } }</div> }</div></section>
}
