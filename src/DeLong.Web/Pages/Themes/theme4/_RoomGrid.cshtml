@* Theme 4 · Rooms: a plain, readable grid: photo, who it fits, price, book. *@
@model DeLong.Web.Pages.Themes.ThemeSectionModel
@using System.Text.Json
@using System.Text.Json.Nodes
@using DeLong.Web.Features.Site
@using DeLong.Web.Pages.Themes
@{
    var Page = Model.Page;
    var H = Model.Home;
    var block = Model.Block;
    var siteName = H.SiteName;
    var roomCount = H.RoomCount;
    var fromPrice = H.FromPrice;
    var heroPriceShort = H.HeroPriceShort;
    var roomMarqueeText = H.RoomMarqueeText;
    string Text(JsonObject content, string key, string fallback = "") => ThemeHomeContext.Text(content, key, fallback);
    string V(JsonObject content, string path, bool image = false) => H.V(content, path, image);
    string Variant(string variant) => H.Variant(variant);
    string? RoomTone(Guid roomId) => H.RoomTone(roomId);
    string ScopedUrl(string url) => H.ScopedUrl(url);
}
@{
    var rooms = Page.SelectGlobalRooms(block.Content);
    var title = Text(block.Content, "title", "Các phòng");
    var body = Text(block.Content, "body");
}
<section class="t4-rooms" aria-labelledby="t4-rooms-title">
    <div class="public-container">
        <div class="t4-head">
            <div>
                <h2 id="t4-rooms-title">@PublicTitleAccent.Render(title)</h2>
                @if (!string.IsNullOrWhiteSpace(body)) { <p>@body</p> }
            </div>
            <a class="t4-link" href="@PublicUrlBuilder.BookingHome()">Xem lịch phòng</a>
        </div>
        <ul class="t4-room-grid">
            @foreach (var item in rooms)
            {
                var room = item.Room;
                var roomUrl = PublicUrlBuilder.Room(item.PropertySiteSlug, room.Slug);
                <li class="t4-room" style="@RoomTone(room.Id)" data-room-lightbox="@ThemeHomeContext.RoomPhotos(room)" data-room-lightbox-title="@room.Name">
                    <a class="t4-room-photo public-room-art" href="@roomUrl" aria-label="Xem @room.Name">
                        @if (!string.IsNullOrWhiteSpace(room.CoverCardUrl))
                        {
                            <img src="@room.CoverCardUrl" alt="@room.Name" width="900" height="675" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span class="t4-room-fallback" aria-hidden="true"></span>
                        }
                    </a>
                    <div class="t4-room-body">
                        <h3><a href="@roomUrl">@room.Name</a></h3>
                        <p>@(string.IsNullOrWhiteSpace(room.ShortDescription) ? $"{room.Capacity} người, {item.PropertyName}" : room.ShortDescription)</p>
                        <div class="t4-room-foot">
                            <span class="t4-room-price">Từ <strong>@room.QuickFromPrice.ToString("N0")đ</strong></span>
                            @if (room.IsBookingLocked)
                            {
                                <span class="t4-room-book is-locked" aria-disabled="true">Tạm ngừng nhận đặt</span>
                            }
                            else
                            {
                                <a class="t4-room-book" href="@PublicUrlBuilder.BookingHome(item.PropertySiteSlug)">Đặt phòng</a>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
</section>
