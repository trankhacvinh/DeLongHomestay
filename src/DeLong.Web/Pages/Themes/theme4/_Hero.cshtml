@* Theme 4 · Hero: a layered vector landscape (sky follows the visitor's local time), drifting slowly with scroll. *@
@model DeLong.Web.Pages.Themes.ThemeSectionModel
@using System.Text.Json
@using System.Text.Json.Nodes
@using DeLong.Web.Features.Site
@using DeLong.Web.Pages.Themes
@{
    var Page = Model.Page;
    var H = Model.Home;
    var block = Model.Block;
    var siteName = H.SiteName;
    var roomCount = H.RoomCount;
    var fromPrice = H.FromPrice;
    var heroPriceShort = H.HeroPriceShort;
    var roomMarqueeText = H.RoomMarqueeText;
    string Text(JsonObject content, string key, string fallback = "") => ThemeHomeContext.Text(content, key, fallback);
    string V(JsonObject content, string path, bool image = false) => H.V(content, path, image);
    string Variant(string variant) => H.Variant(variant);
    string? RoomTone(Guid roomId) => H.RoomTone(roomId);
    string ScopedUrl(string url) => H.ScopedUrl(url);
}
@{
    var title = Text(block.Content, "title", "Chậm lại một chút.");
    var body = Text(block.Content, "body", "Phòng riêng yên tĩnh theo giờ hoặc qua đêm. Chọn ngày, xem phòng trống, đặt trong vài phút.");
    var primaryText = Text(block.Content, "primaryText", "Đặt phòng");
    var primaryUrl = Text(block.Content, "primaryUrl", "/booking");
    var secondaryText = Text(block.Content, "secondaryText");
    var secondaryUrl = Text(block.Content, "secondaryUrl");
    // Pines along the near ridge: fixed positions so every render draws the same skyline.
    var pines = new[] { (60, 700, 1.0), (98, 694, 0.8), (140, 690, 1.25), (300, 698, 0.9), (338, 702, 1.1), (610, 694, 0.85), (650, 688, 1.3), (690, 692, 0.95), (1000, 694, 1.05), (1040, 699, 0.8), (1250, 688, 1.2), (1292, 684, 0.9), (1330, 686, 1.15), (1400, 680, 0.85) };
}
<section class="t4-hero" data-t4-hero data-t4-time="day">
    <script>(function(){var h=new Date().getHours(),s=document.currentScript.parentNode;s.setAttribute("data-t4-time",h>=5&&h<8?"dawn":h>=8&&h<16?"day":h>=16&&h<19?"dusk":"night");})();</script>
    <svg class="t4-scene" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="t4-sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" class="t4-stop-top" />
                <stop offset=".72" class="t4-stop-low" />
            </linearGradient>
            <linearGradient id="t4-lake" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" class="t4-stop-low" />
                <stop offset="1" class="t4-stop-deep" />
            </linearGradient>
            <radialGradient id="t4-glow"><stop offset="0" class="t4-stop-glow" /><stop offset="1" class="t4-stop-glow-out" /></radialGradient>
        </defs>
        <rect width="1440" height="900" fill="url(#t4-sky)" />
        <g class="t4-layer" data-depth="0.06">
            <g class="t4-sun">
                <circle cx="1060" cy="0" r="220" fill="url(#t4-glow)" />
                <circle cx="1060" cy="0" r="46" class="t4-orb" />
            </g>
        </g>
        <g class="t4-layer t4-clouds" data-depth="0.1">
            <g class="t4-cloud t4-cloud-a"><ellipse cx="260" cy="210" rx="150" ry="22" /><ellipse cx="330" cy="196" rx="90" ry="20" /></g>
            <g class="t4-cloud t4-cloud-b"><ellipse cx="900" cy="300" rx="190" ry="20" /><ellipse cx="980" cy="286" rx="100" ry="18" /></g>
            <g class="t4-cloud t4-cloud-c"><ellipse cx="1300" cy="160" rx="120" ry="16" /></g>
        </g>
        <g transform="translate(0 70)">
        <path class="t4-layer t4-far" data-depth="0.14" d="M0 560 C 90 520 170 470 270 500 S 420 560 520 520 S 690 430 800 470 S 960 540 1060 500 S 1250 440 1340 480 S 1440 500 1440 500 V900 H0Z" />
        <path class="t4-layer t4-mid" data-depth="0.26" d="M0 640 C 140 590 280 600 420 628 S 690 560 860 596 S 1150 640 1300 592 S 1440 604 1440 604 V900 H0Z" />
        <g class="t4-layer t4-near" data-depth="0.42">
            <path d="M0 724 C 190 668 370 694 520 716 S 860 672 1040 704 S 1320 690 1440 680 V900 H0Z" />
            @foreach (var (x, y, s) in pines)
            {
                <path d="M@(x) @(y - (int)(64 * s)) L@(x + (int)(17 * s)) @(y + 4) L@(x - (int)(17 * s)) @(y + 4)Z" />
            }
        </g>
        <g class="t4-layer t4-lake" data-depth="0.5">
            <rect y="770" width="1440" height="130" fill="url(#t4-lake)" />
            <rect class="t4-ripple" x="180" y="800" width="220" height="2" rx="1" />
            <rect class="t4-ripple t4-ripple-2" x="980" y="790" width="160" height="2" rx="1" />
            <rect class="t4-ripple t4-ripple-3" x="1010" y="818" width="90" height="2" rx="1" />
            <rect class="t4-ripple" x="640" y="840" width="300" height="2" rx="1" />
            <rect class="t4-ripple t4-ripple-2" x="90" y="862" width="140" height="2" rx="1" />
        </g>
        </g>
    </svg>
    <canvas class="t4-fireflies" data-t4-fireflies aria-hidden="true"></canvas>
    <div class="public-container t4-hero-copy" data-t4-copy>
        <p class="t4-greeting" data-t4-greeting data-t4-line></p>
        <h1 data-t4-line>@PublicTitleAccent.Render(title)</h1>
        <p class="t4-hero-lead" data-t4-line>@body</p>
        <div class="t4-hero-actions" data-t4-line>
            <a class="t4-btn t4-btn-solid" href="@ScopedUrl(primaryUrl)">@primaryText</a>
            @if (!string.IsNullOrWhiteSpace(secondaryText) && !string.IsNullOrWhiteSpace(secondaryUrl))
            {
                <a class="t4-btn t4-btn-quiet" href="@ScopedUrl(secondaryUrl)">@secondaryText</a>
            }
        </div>
    </div>
</section>
