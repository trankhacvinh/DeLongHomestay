@* Theme 7 · Quick search: a soft card resting on the bottom of the hero; date (and branch) then straight to the booking calendar. *@
@model DeLong.Web.Pages.Themes.ThemeSectionModel
@using System.Text.Json
@using System.Text.Json.Nodes
@using DeLong.Web.Features.Site
@using DeLong.Web.Pages.Themes
@{
    var Page = Model.Page;
    var H = Model.Home;
    var block = Model.Block;
    var siteName = H.SiteName;
    var roomCount = H.RoomCount;
    var fromPrice = H.FromPrice;
    var heroPriceShort = H.HeroPriceShort;
    var roomMarqueeText = H.RoomMarqueeText;
    string Text(JsonObject content, string key, string fallback = "") => ThemeHomeContext.Text(content, key, fallback);
    string V(JsonObject content, string path, bool image = false) => H.V(content, path, image);
    string Variant(string variant) => H.Variant(variant);
    string? RoomTone(Guid roomId) => H.RoomTone(roomId);
    string ScopedUrl(string url) => H.ScopedUrl(url);
}
@{
    var title = Text(block.Content, "title", "Bạn muốn ghé ngày nào?");
    var properties = Page.GlobalCatalog.Properties;
}
<section class="t7-search">
    <div class="public-container">
        <form class="t7-search-card" method="get" action="/booking" data-t7-reveal>
            <h2>@title</h2>
            @if (properties.Count > 1)
            {
                <label class="t7-field"><span>Cơ sở</span><select name="site" required><option value="">Chọn cơ sở</option>@foreach (var property in properties) { <option value="@property.SiteSlug">@property.SiteName</option> }</select></label>
            }
            else if (properties.Count == 1)
            {
                <input type="hidden" name="site" value="@properties[0].SiteSlug" />
            }
            <label class="t7-field"><span>Ngày</span><input type="date" name="date" value="@Page.DefaultDate" required /></label>
            <button class="t7-btn t7-btn-solid" type="submit" @(properties.Count == 0 ? "disabled" : null)>Xem phòng trống</button>
        </form>
    </div>
</section>
