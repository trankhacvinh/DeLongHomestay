@* Theme 7 · Highlights: small arched windows, each with a title and a line. Items "Tiêu đề — mô tả" split in two. *@
@model DeLong.Web.Pages.Themes.ThemeSectionModel
@using System.Text.Json
@using System.Text.Json.Nodes
@using DeLong.Web.Features.Site
@using DeLong.Web.Pages.Themes
@{
    var Page = Model.Page;
    var H = Model.Home;
    var block = Model.Block;
    var siteName = H.SiteName;
    var roomCount = H.RoomCount;
    var fromPrice = H.FromPrice;
    var heroPriceShort = H.HeroPriceShort;
    var roomMarqueeText = H.RoomMarqueeText;
    string Text(JsonObject content, string key, string fallback = "") => ThemeHomeContext.Text(content, key, fallback);
    string V(JsonObject content, string path, bool image = false) => H.V(content, path, image);
    string Variant(string variant) => H.Variant(variant);
    string? RoomTone(Guid roomId) => H.RoomTone(roomId);
    string ScopedUrl(string url) => H.ScopedUrl(url);
}
@{
    var items = (block.Content["items"] as JsonArray ?? new JsonArray()).Select(x => x?.ToString()).Where(x => !string.IsNullOrWhiteSpace(x)).Take(8).ToList();
    var body = Text(block.Content, "body");
}
<section class="t7-features">
    <div class="public-container">
        <div class="t7-head t7-head-center" data-t7-reveal>
            <p class="t7-kicker"><span>@Text(block.Content, "eyebrow", "Ở đây có gì")</span></p>
            <h2>@PublicTitleAccent.Render(Text(block.Content, "title", "Những điều nhỏ làm nên một kỳ nghỉ êm"))</h2>
            @if (!string.IsNullOrWhiteSpace(body)) { <p>@body</p> }
        </div>
        <ul class="t7-features-list">
            @{ var index = 0; }
            @foreach (var item in items)
            {
                index++;
                var parts = item!.Split(new[] { " — ", " – ", " - ", ": " }, 2, StringSplitOptions.TrimEntries);
                <li data-t7-reveal>
                    <span class="t7-feature-arch" aria-hidden="true">@index.ToString("00")</span>
                    <strong>@parts[0]</strong>
                    @if (parts.Length > 1) { <span>@parts[1]</span> }
                </li>
            }
        </ul>
    </div>
</section>
