@page
@model DeLong.Web.Pages.Admin.Properties.IndexModel
@{
    ViewData["Title"] = "Cơ sở";
}
@section Head {
    <link rel="stylesheet" href="~/css/site-cms.css" asp-append-version="true" />
}

<div id="properties-admin" class="site-admin-page" v-cloak>
    <div class="page-title-row site-page-head">
        <div>
            <div class="page-eyebrow">Hệ thống</div>
            <h1>Cơ sở</h1>
            <p>Tạo và quản lý các cơ sở. Sau khi tạo, cơ sở sẽ xuất hiện trong phần phân quyền nhân viên.</p>
        </div>
        <button class="btn btn-primary" type="button" v-on:click="openCreate"><svg><use href="#i-plus" /></svg>Thêm cơ sở</button>
    </div>

    <section class="site-property-grid" v-if="properties.length">
        <article class="panel site-property-card" v-for="property in properties" v-bind:key="property.id" v-bind:class="{ inactive: !property.isActive }">
            <div class="site-property-card-head">
                <div><span class="property-code">{{ property.code }}</span><h2>{{ property.name }}</h2></div>
                <span class="pill" v-bind:class="property.isActive ? 'success' : 'danger'">{{ property.isActive ? 'Hoạt động' : 'Đã ngừng' }}</span>
            </div>
            <dl>
                <div><dt>Múi giờ</dt><dd>{{ property.timeZoneId }}</dd></div>
                <div><dt>Phòng</dt><dd>{{ property.roomCount }}</dd></div>
                <div><dt>Tài khoản truy cập</dt><dd>{{ property.userCount }}</dd></div>
            </dl>
            <div class="site-property-actions">
                <a class="btn btn-light btn-sm" v-bind:href="'/Admin/Site?propertyId=' + property.id">Website & SEO</a>
                <button class="btn btn-light btn-sm" type="button" v-on:click="openEdit(property)">Sửa cơ sở</button>
            </div>
        </article>
    </section>
    <section class="panel empty-state" v-else-if="!loading"><strong>Chưa có cơ sở</strong>Tạo cơ sở đầu tiên để bắt đầu cấu hình phòng và phân quyền.</section>

    <div class="modal-backdrop" v-if="editor.open" v-on:click.self="closeEditor">
        <section class="modal-card property-editor" role="dialog" aria-modal="true" aria-labelledby="property-editor-title">
            <div class="modal-head">
                <div><h2 id="property-editor-title">{{ editor.mode === 'create' ? 'Thêm cơ sở' : 'Sửa cơ sở' }}</h2><p class="small muted">Mã cơ sở dùng nội bộ; tên cơ sở hiển thị trong Admin.</p></div>
                <button class="icon-btn" type="button" v-on:click="closeEditor" aria-label="Đóng">×</button>
            </div>
            <div class="site-modal-body">
                <div class="form-grid">
                    <div class="field"><label>Mã cơ sở *</label><input v-model.trim="form.code" maxlength="50" placeholder="DELONG" /><small>Chữ, số, dấu gạch ngang hoặc gạch dưới.</small></div>
                    <div class="field"><label>Tên cơ sở *</label><input v-model.trim="form.name" maxlength="200" placeholder="De Long Homestay" /></div>
                    <div class="field form-full"><label>Múi giờ *</label><input v-model.trim="form.timeZoneId" maxlength="100" placeholder="Asia/Ho_Chi_Minh" /><small>Ví dụ: Asia/Ho_Chi_Minh.</small></div>
                    <label class="site-toggle form-full"><input type="checkbox" v-model="form.isActive" /><span><strong>Cơ sở đang hoạt động</strong><small>Cơ sở đã ngừng sẽ không xuất hiện trong bộ chọn cơ sở và không nhận dữ liệu mới.</small></span></label>
                </div>
                <p class="form-error" v-if="error">{{ error }}</p>
            </div>
            <div class="modal-actions"><button class="btn btn-light" type="button" v-on:click="closeEditor">Hủy</button><button class="btn btn-primary" type="button" v-bind:disabled="saving" v-on:click="save">{{ saving ? 'Đang lưu…' : 'Lưu cơ sở' }}</button></div>
        </section>
    </div>
    <div class="toast" v-if="toast.show" v-bind:class="toast.type">{{ toast.message }}</div>
</div>

@section Scripts {
    <script src="~/js/pages/admin-properties.js" asp-append-version="true"></script>
}
