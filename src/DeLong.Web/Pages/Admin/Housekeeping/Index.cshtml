@page
@model DeLong.Web.Pages.Admin.Housekeeping.IndexModel
@{
    ViewData["Title"] = "Dọn phòng";
}
@section Head {
    <link rel="stylesheet" href="~/css/housekeeping-schedule.css" asp-append-version="true" />
}
<div id="housekeeping-page" v-cloak>
    <script id="housekeeping-page-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>

    <div class="page-title-row">
        <div>
            <div class="page-eyebrow">Vận hành phòng</div>
            <h1>Dọn phòng</h1>
            <p>Checkout tự chuyển phòng sang Bẩn. Cập nhật theo luồng Bẩn → Đang dọn → Sạch để lịch luôn phản ánh đúng tình trạng thực tế.</p>
        </div>
        <div class="housekeeping-summary" aria-live="polite">
            <strong>{{ mode === 'status' ? dirtyRooms.length + cleaningRooms.length : taskCount }}</strong>
            <span>{{ mode === 'status' ? 'phòng đang xử lý' : 'việc trong lịch' }}</span>
        </div>
    </div>

    <nav class="housekeeping-view-switch" aria-label="Chế độ xem dọn phòng">
        <button type="button" v-bind:class="{ active: mode === 'status' }" v-on:click="mode = 'status'">Tình trạng phòng</button>
        <button type="button" v-bind:class="{ active: mode === 'schedule' }" v-on:click="mode = 'schedule'">Lịch công việc</button>
        <button type="button" v-bind:class="{ active: mode === 'text' }" v-on:click="openTextMode">Văn bản</button>
        <a class="housekeeping-report-link" href="/Admin/RoomConditionReports?propertyId=@Model.PropertyId">Tình trạng phòng ↗</a>
    </nav>

    <div class="housekeeping-board" v-if="mode === 'status'">
        <section class="panel housekeeping-column">
            <div class="panel-head">
                <div class="housekeeping-heading">
                    <span class="housekeeping-status-dot dirty" aria-hidden="true"></span>
                    <div class="housekeeping-heading-copy"><h2>Phòng bẩn</h2><span>Cần bắt đầu dọn</span></div>
                </div>
                <span class="pill warning">{{ dirtyRooms.length }}</span>
            </div>
            <div class="panel-body housekeeping-list">
                <article class="housekeeping-card" v-for="room in dirtyRooms" v-bind:key="room.roomId">
                    <div class="housekeeping-room">
                        <span class="housekeeping-room-icon" aria-hidden="true"><svg><use href="#i-bed" /></svg></span>
                        <div class="housekeeping-room-copy"><strong>{{ room.roomName }}</strong><span>{{ room.roomCode }} · {{ updatedText(room) }}</span></div>
                    </div>
                    <div class="housekeeping-actions" v-if="canManage">
                        <button class="btn btn-primary btn-sm" type="button" v-bind:disabled="savingId === room.roomId" v-on:click="setStatus(room, 2)">Bắt đầu dọn</button>
                        <button class="btn btn-light btn-sm" type="button" v-bind:disabled="savingId === room.roomId" v-on:click="setStatus(room, 0)">Đánh dấu sạch</button>
                        <a class="btn btn-light btn-sm" v-bind:href="'/Admin/RoomConditionReports?propertyId=@Model.PropertyId&roomId=' + room.roomId">Báo cáo</a>
                    </div>
                </article>
                <div v-if="dirtyRooms.length === 0" class="empty-state"><strong>Không có phòng bẩn</strong>Phòng checkout mới sẽ tự xuất hiện ở đây.</div>
            </div>
        </section>

        <section class="panel housekeeping-column">
            <div class="panel-head">
                <div class="housekeeping-heading">
                    <span class="housekeeping-status-dot cleaning" aria-hidden="true"></span>
                    <div class="housekeeping-heading-copy"><h2>Đang dọn</h2><span>Đang được xử lý</span></div>
                </div>
                <span class="pill">{{ cleaningRooms.length }}</span>
            </div>
            <div class="panel-body housekeeping-list">
                <article class="housekeeping-card" v-for="room in cleaningRooms" v-bind:key="room.roomId">
                    <div class="housekeeping-room">
                        <span class="housekeeping-room-icon" aria-hidden="true"><svg><use href="#i-sparkles" /></svg></span>
                        <div class="housekeeping-room-copy"><strong>{{ room.roomName }}</strong><span>{{ room.roomCode }} · {{ updatedText(room) }}</span></div>
                    </div>
                    <div class="housekeeping-actions" v-if="canManage">
                        <button class="btn btn-primary btn-sm" type="button" v-bind:disabled="savingId === room.roomId" v-on:click="setStatus(room, 0)">Hoàn tất / Sạch</button>
                        <button class="btn btn-light btn-sm" type="button" v-bind:disabled="savingId === room.roomId" v-on:click="setStatus(room, 1)">Vẫn bẩn</button>
                        <a class="btn btn-light btn-sm" v-bind:href="'/Admin/RoomConditionReports?propertyId=@Model.PropertyId&roomId=' + room.roomId">Báo cáo</a>
                    </div>
                </article>
                <div v-if="cleaningRooms.length === 0" class="empty-state"><strong>Chưa có phòng đang dọn</strong>Bấm “Bắt đầu dọn” ở cột Phòng bẩn để chuyển trạng thái.</div>
            </div>
        </section>

        <section class="panel housekeeping-column">
            <div class="panel-head">
                <div class="housekeeping-heading">
                    <span class="housekeeping-status-dot" aria-hidden="true"></span>
                    <div class="housekeeping-heading-copy"><h2>Sẵn sàng</h2><span>Có thể nhận khách</span></div>
                </div>
                <span class="pill success">{{ cleanRooms.length }}</span>
            </div>
            <div class="panel-body housekeeping-list">
                <article class="housekeeping-card" v-for="room in cleanRooms" v-bind:key="room.roomId">
                    <div class="housekeeping-room">
                        <span class="housekeeping-room-icon" aria-hidden="true"><svg><use href="#i-bed" /></svg></span>
                        <div class="housekeeping-room-copy"><strong>{{ room.roomName }}</strong><span>{{ room.roomCode }} · {{ updatedText(room) }}</span></div>
                    </div>
                    <div class="housekeeping-actions" v-if="canManage">
                        <button class="btn btn-light btn-sm" type="button" v-bind:disabled="savingId === room.roomId" v-on:click="setStatus(room, 1)">Đánh dấu bẩn</button>
                        <a class="btn btn-light btn-sm" v-bind:href="'/Admin/RoomConditionReports?propertyId=@Model.PropertyId&roomId=' + room.roomId">Báo cáo</a>
                    </div>
                </article>
                <div v-if="cleanRooms.length === 0" class="empty-state"><strong>Chưa có phòng sẵn sàng</strong>Hoàn tất dọn phòng để chuyển phòng về trạng thái sạch.</div>
            </div>
        </section>
    </div>

    <section class="housekeeping-schedule-shell" v-else>
        <div class="housekeeping-schedule-toolbar">
            <div class="housekeeping-date-controls">
                <button class="btn btn-light btn-sm" type="button" v-on:click="moveDate(-1)" aria-label="Ngày trước">‹</button>
                <label><span>Ngày làm việc</span><input type="date" v-model="selectedDate" v-on:change="loadSchedule" /></label>
                <button class="btn btn-light btn-sm" type="button" v-on:click="goToday">Hôm nay</button>
                <button class="btn btn-light btn-sm" type="button" v-on:click="moveDate(1)" aria-label="Ngày sau">›</button>
            </div>
            <div class="housekeeping-task-filter" aria-label="Lọc loại công việc">
                <button type="button" v-bind:class="{ active: taskFilter === 'prepare' }" v-on:click="taskFilter = 'prepare'">Chuẩn bị đón khách</button>
                <button type="button" v-bind:class="{ active: taskFilter === 'turnover' }" v-on:click="taskFilter = 'turnover'">Sau trả phòng</button>
                <button type="button" v-bind:class="{ active: taskFilter === 'all' }" v-on:click="taskFilter = 'all'">Tất cả</button>
            </div>
        </div>
        <div class="housekeeping-offset-note">Đang áp dụng: dọn trước nhận phòng <strong>{{ schedule.settings?.beforeCheckInMinutes || 0 }} phút</strong> · dọn sau trả phòng <strong>{{ schedule.settings?.afterCheckOutMinutes || 0 }} phút</strong>. Thay đổi tại trang Cấu hình.</div>

        <div class="housekeeping-schedule-loading" v-if="scheduleLoading">Đang cập nhật lịch công việc…</div>

        <div class="housekeeping-schedule" v-if="mode === 'schedule' && !scheduleLoading">
            <section class="housekeeping-day" v-for="day in scheduleDays" v-bind:key="day.date">
                <div class="housekeeping-day-head"><div><span>{{ weekdayText(day.date) }}</span><strong>{{ dateText(day.date) }}</strong></div><span>{{ day.tasks.length }} việc</span></div>
                <div class="housekeeping-task-list" v-if="day.tasks.length">
                    <article class="housekeeping-task" v-for="task in day.tasks" v-bind:key="task.kind + '-' + task.bookingId">
                        <time>{{ taskTime(task) }}</time>
                        <span class="housekeeping-task-kind" v-bind:class="task.kind">{{ task.kind === 'prepare' ? 'Đón khách' : 'Trả phòng' }}</span>
                        <div><strong>{{ task.roomName }}</strong><span>{{ task.action }} · {{ task.bookingCode }}</span></div>
                        <button v-if="canManage" class="btn btn-light btn-sm" type="button" v-bind:disabled="savingId === task.roomId" v-on:click="startTask(task)">Bắt đầu dọn</button>
                    </article>
                </div>
                <div class="housekeeping-schedule-empty" v-else>Không có công việc phù hợp trong ngày này.</div>
            </section>
        </div>

        <div class="housekeeping-text-mode" v-if="mode === 'text' && !scheduleLoading">
            <div class="housekeeping-text-head"><div><strong>Nội dung gửi lao công</strong><span>Đã sắp theo ngày, giờ và phòng. Có thể sao chép để gửi Zalo.</span></div><button class="btn btn-primary btn-sm" type="button" v-bind:disabled="!scheduleText" v-on:click="copyScheduleText">{{ copied ? 'Đã sao chép' : 'Sao chép văn bản' }}</button></div>
            <textarea readonly v-bind:value="scheduleText" aria-label="Lịch dọn phòng dạng văn bản"></textarea>
            <div class="housekeeping-schedule-empty" v-if="!scheduleText">Không có công việc phù hợp để tạo văn bản.</div>
        </div>
    </section>

    <div class="toast" v-if="toast.show" v-bind:class="toast.type" aria-live="polite">{{ toast.message }}</div>
</div>

@section Scripts {
    <script>window.DeLongHousekeepingCanManage = @(User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff") || User.IsInRole("Housekeeping") ? "true" : "false");</script>
    <script src="~/js/pages/admin-housekeeping.js" asp-append-version="true"></script>
}
