@page
@model DeLong.Web.Pages.Admin.Housekeeping.IndexModel
@{
    ViewData["Title"] = "Dọn phòng";
}
<div id="housekeeping-page" v-cloak>
    <script id="housekeeping-page-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>

    <div class="page-title-row">
        <div>
            <div class="page-eyebrow">Vận hành phòng</div>
            <h1>Dọn phòng</h1>
            <p>Checkout tự chuyển phòng sang Bẩn. Cập nhật theo luồng Bẩn → Đang dọn → Sạch để lịch luôn phản ánh đúng tình trạng thực tế.</p>
        </div>
        <div class="housekeeping-summary" aria-live="polite">
            <strong>{{ dirtyRooms.length + cleaningRooms.length }}</strong>
            <span>phòng đang xử lý</span>
        </div>
    </div>

    <div class="housekeeping-board">
        <section class="panel housekeeping-column">
            <div class="panel-head">
                <div class="housekeeping-heading">
                    <span class="housekeeping-status-dot dirty" aria-hidden="true"></span>
                    <div class="housekeeping-heading-copy"><h2>Phòng bẩn</h2><span>Cần bắt đầu dọn</span></div>
                </div>
                <span class="pill warning">{{ dirtyRooms.length }}</span>
            </div>
            <div class="panel-body housekeeping-list">
                <article class="housekeeping-card" v-for="room in dirtyRooms" v-bind:key="room.roomId">
                    <div class="housekeeping-room">
                        <span class="housekeeping-room-icon" aria-hidden="true"><svg><use href="#i-bed" /></svg></span>
                        <div class="housekeeping-room-copy"><strong>{{ room.roomName }}</strong><span>{{ room.roomCode }} · {{ updatedText(room) }}</span></div>
                    </div>
                    <div class="housekeeping-actions" v-if="canManage">
                        <button class="btn btn-primary btn-sm" type="button" v-bind:disabled="savingId === room.roomId" v-on:click="setStatus(room, 2)">Bắt đầu dọn</button>
                        <button class="btn btn-light btn-sm" type="button" v-bind:disabled="savingId === room.roomId" v-on:click="setStatus(room, 0)">Đánh dấu sạch</button>
                    </div>
                </article>
                <div v-if="dirtyRooms.length === 0" class="empty-state"><strong>Không có phòng bẩn</strong>Phòng checkout mới sẽ tự xuất hiện ở đây.</div>
            </div>
        </section>

        <section class="panel housekeeping-column">
            <div class="panel-head">
                <div class="housekeeping-heading">
                    <span class="housekeeping-status-dot cleaning" aria-hidden="true"></span>
                    <div class="housekeeping-heading-copy"><h2>Đang dọn</h2><span>Đang được xử lý</span></div>
                </div>
                <span class="pill">{{ cleaningRooms.length }}</span>
            </div>
            <div class="panel-body housekeeping-list">
                <article class="housekeeping-card" v-for="room in cleaningRooms" v-bind:key="room.roomId">
                    <div class="housekeeping-room">
                        <span class="housekeeping-room-icon" aria-hidden="true"><svg><use href="#i-sparkles" /></svg></span>
                        <div class="housekeeping-room-copy"><strong>{{ room.roomName }}</strong><span>{{ room.roomCode }} · {{ updatedText(room) }}</span></div>
                    </div>
                    <div class="housekeeping-actions" v-if="canManage">
                        <button class="btn btn-primary btn-sm" type="button" v-bind:disabled="savingId === room.roomId" v-on:click="setStatus(room, 0)">Hoàn tất / Sạch</button>
                        <button class="btn btn-light btn-sm" type="button" v-bind:disabled="savingId === room.roomId" v-on:click="setStatus(room, 1)">Vẫn bẩn</button>
                    </div>
                </article>
                <div v-if="cleaningRooms.length === 0" class="empty-state"><strong>Chưa có phòng đang dọn</strong>Bấm “Bắt đầu dọn” ở cột Phòng bẩn để chuyển trạng thái.</div>
            </div>
        </section>

        <section class="panel housekeeping-column">
            <div class="panel-head">
                <div class="housekeeping-heading">
                    <span class="housekeeping-status-dot" aria-hidden="true"></span>
                    <div class="housekeeping-heading-copy"><h2>Sẵn sàng</h2><span>Có thể nhận khách</span></div>
                </div>
                <span class="pill success">{{ cleanRooms.length }}</span>
            </div>
            <div class="panel-body housekeeping-list">
                <article class="housekeeping-card" v-for="room in cleanRooms" v-bind:key="room.roomId">
                    <div class="housekeeping-room">
                        <span class="housekeeping-room-icon" aria-hidden="true"><svg><use href="#i-bed" /></svg></span>
                        <div class="housekeeping-room-copy"><strong>{{ room.roomName }}</strong><span>{{ room.roomCode }} · {{ updatedText(room) }}</span></div>
                    </div>
                    <div class="housekeeping-actions" v-if="canManage">
                        <button class="btn btn-light btn-sm" type="button" v-bind:disabled="savingId === room.roomId" v-on:click="setStatus(room, 1)">Đánh dấu bẩn</button>
                    </div>
                </article>
                <div v-if="cleanRooms.length === 0" class="empty-state"><strong>Chưa có phòng sẵn sàng</strong>Hoàn tất dọn phòng để chuyển phòng về trạng thái sạch.</div>
            </div>
        </section>
    </div>

    <div class="toast" v-if="toast.show" v-bind:class="toast.type" aria-live="polite">{{ toast.message }}</div>
</div>

@section Scripts {
    <script>window.DeLongHousekeepingCanManage = @(User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff") || User.IsInRole("Housekeeping") ? "true" : "false");</script>
    <script src="~/js/pages/admin-housekeeping.js" asp-append-version="true"></script>
}
