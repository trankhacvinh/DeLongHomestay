@page
@model DeLong.Web.Pages.Admin.Housekeeping.IndexModel
@{
    ViewData["Title"] = "Dọn phòng";
}
@section Head {
    <link rel="stylesheet" href="~/css/housekeeping-schedule.css" asp-append-version="true" />
}
<div id="housekeeping-page" v-cloak>
    <script id="housekeeping-page-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>

    <div class="page-title-row">
        <div>
            <div class="page-eyebrow">Vận hành phòng</div>
            <h1>Dọn phòng</h1>
            <p>Checkout tự chuyển phòng sang Bẩn. Cập nhật theo luồng Bẩn → Đang dọn → Sạch để lịch luôn phản ánh đúng tình trạng thực tế.</p>
        </div>
        <div class="housekeeping-summary" aria-live="polite">
            <strong>{{ taskCount }}</strong>
            <span>việc trong lịch</span>
        </div>
    </div>

    <nav class="housekeeping-view-switch" aria-label="Chế độ xem dọn phòng">
        <button type="button" v-bind:class="{ active: mode === 'text' }" v-on:click="openTextMode">Văn bản</button>
        <button type="button" v-bind:class="{ active: mode === 'schedule' }" v-on:click="mode = 'schedule'">Lịch công việc</button>
        <a class="housekeeping-report-link" href="/Admin/RoomConditionReports?propertyId=@Model.PropertyId">Tình trạng phòng ↗</a>
    </nav>

    <section class="housekeeping-schedule-shell">
        <div class="housekeeping-schedule-toolbar">
            <div class="housekeeping-date-controls">
                <button class="btn btn-light btn-sm" type="button" v-on:click="moveDate(-1)" aria-label="Ngày trước">‹</button>
                <label><span>Ngày làm việc</span><input type="date" v-model="selectedDate" v-on:change="loadSchedule" /></label>
                <button class="btn btn-light btn-sm" type="button" v-on:click="goToday">Hôm nay</button>
                <button class="btn btn-light btn-sm" type="button" v-on:click="moveDate(1)" aria-label="Ngày sau">›</button>
            </div>
            <div class="housekeeping-task-filter" aria-label="Lọc loại công việc">
                <button type="button" v-bind:class="{ active: taskFilter === 'prepare' }" v-on:click="taskFilter = 'prepare'">Chuẩn bị đón khách</button>
                <button type="button" v-bind:class="{ active: taskFilter === 'turnover' }" v-on:click="taskFilter = 'turnover'">Sau trả phòng</button>
                <button type="button" v-bind:class="{ active: taskFilter === 'all' }" v-on:click="taskFilter = 'all'">Tất cả</button>
            </div>
        </div>
        <div class="housekeeping-offset-note">Đang áp dụng: dọn trước nhận phòng <strong>{{ schedule.settings?.beforeCheckInMinutes || 0 }} phút</strong> · dọn sau trả phòng <strong>{{ schedule.settings?.afterCheckOutMinutes || 0 }} phút</strong>.<span v-if="schedule.settings?.staggerEnabled"> Giãn lịch: {{ schedule.settings.workerCount }} lao công · {{ schedule.settings.cleaningMinutes }} phút/phòng · sớm tối đa {{ schedule.settings.maxAdvanceMinutes }} phút.</span> Thay đổi tại trang Cấu hình.</div>

        <div v-if="mode === 'schedule'" class="housekeeping-task-filter" aria-label="Lọc thao tác đèn">
            <button type="button" v-bind:class="{ active: lightFilter === 'all' }" v-on:click="lightFilter = 'all'">Tất cả</button>
            <button type="button" v-bind:class="{ active: lightFilter === 'on' }" v-on:click="lightFilter = 'on'">Mở đèn</button>
            <button type="button" v-bind:class="{ active: lightFilter === 'off' }" v-on:click="lightFilter = 'off'">Tắt đèn</button>
        </div>
        <div class="housekeeping-schedule-loading" v-show="scheduleLoading" role="status">Đang cập nhật lịch công việc…</div>

        <div class="housekeeping-schedule" v-if="mode === 'schedule'">
            <section class="housekeeping-day" v-for="day in scheduleDays" v-bind:key="day.date">
                <div class="housekeeping-day-head"><div><span>{{ weekdayText(day.date) }}</span><strong>{{ dateText(day.date) }}</strong></div><span>{{ day.tasks.length }} việc</span></div>
                <div class="housekeeping-task-list" v-if="day.tasks.length">
                    <article class="housekeeping-task" v-for="task in day.tasks" v-bind:key="task.kind + '-' + task.bookingId">
                        <time>{{ taskTime(task) }}</time>
                        <span class="housekeeping-task-kind" v-bind:class="task.kind">{{ task.kind === 'prepare' ? 'Đón khách' : 'Trả phòng' }}</span>
                        <div><strong>{{ task.roomName }}</strong><span>{{ task.action }} · {{ task.bookingCode }}</span><small v-if="task.originalAtUtc">Đã chuyển sớm từ {{ taskTime({ atUtc: task.originalAtUtc }) }}</small><small class="text-danger" v-if="task.schedulingWarning">{{ task.schedulingWarning }}</small></div>
                        <button v-if="canManage" class="btn btn-light btn-sm" type="button" v-bind:disabled="savingId === task.roomId" v-on:click="startTask(task)">Bắt đầu dọn</button>
                    </article>
                </div>
                <div class="housekeeping-schedule-empty" v-else>Không có công việc phù hợp trong ngày này.</div>
            </section>
        </div>

        <div class="housekeeping-text-mode" v-if="mode === 'text'">
            <div class="housekeeping-text-head"><div><strong>Nội dung gửi lao công</strong><span>Đã sắp theo ngày, giờ và phòng. Có thể sao chép để gửi Zalo.</span></div><button class="btn btn-primary btn-sm" type="button" v-bind:disabled="!scheduleText" v-on:click="copyScheduleText">{{ copied ? 'Đã sao chép' : 'Sao chép văn bản' }}</button></div>
            <textarea ref="scheduleTextArea" readonly v-bind:value="scheduleText" aria-label="Lịch dọn phòng dạng văn bản"></textarea>
            <div class="housekeeping-schedule-empty" v-if="!scheduleText">Không có công việc phù hợp để tạo văn bản.</div>
        </div>
    </section>

    <div class="toast" v-if="toast.show" v-bind:class="toast.type" aria-live="polite">{{ toast.message }}</div>
</div>

@section Scripts {
    <script>window.DeLongHousekeepingCanManage = @(User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff") || User.IsInRole("Housekeeping") ? "true" : "false");</script>
    <script src="~/js/pages/admin-housekeeping.js" asp-append-version="true"></script>
}
