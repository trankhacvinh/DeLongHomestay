@page "/Admin/Inventory"
@model DeLong.Web.Pages.Admin.Inventory.IndexModel
@{ ViewData["Title"] = "Kho chung"; }
@section Head { <link rel="stylesheet" href="~/css/admin-operations-ledger.css" asp-append-version="true" /> }
<script id="inventory-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>
<div id="inventory-page" class="operations-ledger inventory-compact" v-cloak>
    <header class="inventory-head"><h1>Kho chung</h1></header>
    <div class="ops-error" v-if="error" role="alert">{{ error }}</div><div class="ops-success" v-if="message" role="status">{{ message }}</div>
    <section class="ops-panel" v-if="!snapshot.warehouse">
        <h2>Khởi tạo kho chung</h2><p class="ops-note">Chọn chi nhánh quản lý để cấp quyền kho. Chi nhánh nhận hàng sẽ được chọn riêng trên từng phiếu xuất.</p>
        <div class="ops-inline"><label>Chi nhánh quản lý<select v-model="ownerId"><option value="">Chọn chi nhánh</option><option v-for="p in properties" v-bind:value="p.id">{{ p.name }}</option></select></label><button class="btn btn-primary" v-if="canInitialize" v-bind:disabled="saving || !ownerId" v-on:click="initialize">Khởi tạo kho</button></div>
    </section>
    <template v-else>
        <section class="ops-panel inventory-toolbar">
            <label>Tháng<input type="month" v-model="month" v-on:change="load" /></label>
            <label class="inventory-search">Tìm mặt hàng<input type="search" v-model.trim="search" placeholder="Tên hoặc mã hàng" /></label>
            <div class="inventory-toolbar-actions"><button class="btn btn-light" v-on:click="load" v-bind:disabled="loading">{{ loading ? 'Đang tải…' : 'Tải lại' }}</button><a class="btn btn-light" v-bind:href="exportUrl">Xuất Excel</a><button class="btn btn-primary" v-if="canManage" v-on:click="openDocument(1)">Nhập kho</button><button class="btn btn-primary" v-if="canManage" v-on:click="openDocument(2)">Xuất kho</button></div>
        </section>
        <nav class="ops-tabs" aria-label="Nội dung kho"><button class="btn btn-light" v-for="t in tabs" v-bind:class="{active:tab===t.key}" v-on:click="tab=t.key">{{ t.name }}</button></nav>
        <section class="ops-panel" v-if="tab==='stock' && loadedMonth===month">
            <div class="ops-section-head"><h2>Tồn kho <small>{{ stockRows.length }} mặt hàng</small></h2><div class="inventory-stock-actions" v-if="canManage"><button class="btn btn-light" v-on:click="openDocument(0)">Tồn đầu</button><button class="btn btn-light" v-on:click="openImport('opening')">Import tồn đầu</button><button class="btn btn-light" v-on:click="openDocument(3)">Điều chỉnh +</button><button class="btn btn-light" v-on:click="openDocument(4)">Điều chỉnh −</button></div></div>
            <div class="ops-scroll inventory-stock-table" tabindex="0" aria-label="Bảng tồn kho, có thể cuộn ngang"><table><thead><tr><th>Mặt hàng</th><th>ĐVT</th><th class="number">Tồn đầu</th><th class="number">Nhập</th><th class="number">Xuất</th><th class="number">Điều chỉnh</th><th class="number">Tồn cuối</th></tr></thead><tbody><tr v-for="row in stockRows" v-bind:key="row.itemId"><td><button class="inventory-item-link" v-on:click="openHistory(row)">{{ row.name }}</button><small>{{ row.code }}</small></td><td>{{ row.unitName }}</td><td class="number">{{ qty(row.opening) }}</td><td class="number">{{ qty(row.received) }}</td><td class="number">{{ qty(row.issued) }}</td><td class="number">{{ qty(row.adjustments) }}</td><td class="number"><strong>{{ qty(row.closing) }}</strong></td></tr></tbody></table></div><p class="ops-empty" v-if="!stockRows.length">Chưa có mặt hàng phù hợp.</p>
        </section>
        <section class="ops-panel" v-if="tab==='documents' && loadedMonth===month">
            <h2>Phiếu kho</h2><div class="ops-toolbar"><label>Loại phiếu<select v-model="typeFilter"><option value="">Tất cả</option><option v-for="(name,i) in types" v-bind:value="String(i)">{{ name }}</option></select></label><label>Chi nhánh nhận<select v-model="recipientFilter"><option value="">Tất cả</option><option v-for="p in properties" v-bind:value="p.id">{{ p.name }}</option></select></label><label class="ops-check"><input type="checkbox" v-model="showVoided" /> Hiện phiếu đã hủy</label></div>
            
            <div class="ops-details"><article v-for="d in documents" v-bind:key="d.id" v-bind:class="{'ops-voided':d.isVoided}"><div class="ops-section-head"><strong>{{ typeText(d.type) }} · {{ dateText(d.occurredAtUtc) }} · {{ d.recipientName || 'Kho chung' }}</strong><button class="btn btn-light btn-sm" v-on:click="detail=d">Chi tiết</button></div><p>{{ d.lines.map(l=>`${l.itemName}: ${qty(l.quantity)} ${l.unitName}`).join(' · ') }}</p><small>{{ d.code }} · {{ d.recordedByName || 'Chưa có tên người ghi nhận' }}<span v-if="d.isVoided"> · Đã hủy: {{ d.voidReason }}</span></small></article></div><p class="ops-empty" v-if="!documents.length">Không có phiếu phù hợp.</p>
        </section>
        <section class="ops-panel" v-if="tab==='distribution' && loadedMonth===month"><h2>Xuất cấp cho chi nhánh</h2><div class="ops-scroll"><table><thead><tr><th>Chi nhánh</th><th>Mặt hàng</th><th>ĐVT</th><th class="number">Đã xuất</th><th class="number">Giá trị theo phiếu</th></tr></thead><tbody><tr v-for="row in distribution"><td>{{ row.recipientName }}</td><td>{{ row.itemName }}</td><td>{{ row.unitName }}</td><td class="number">{{ qty(row.quantity) }}</td><td class="number">{{ money(row.value) }}</td></tr></tbody></table></div></section>
        <section class="ops-panel" v-if="tab==='catalog'">
            <div class="ops-section-head"><h2>Mặt hàng</h2><div class="inventory-stock-actions" v-if="canManage"><button class="btn btn-light" v-on:click="openImport('catalog')">Import mặt hàng</button><button class="btn btn-primary" v-on:click="openItem()">Thêm mặt hàng</button></div></div>
            <form class="ops-inline" v-if="canManage" v-on:submit.prevent="addUnit"><label>Thêm đơn vị tính<input v-model.trim="unitName" maxlength="40" placeholder="Ví dụ: chai, kg, can" required /></label><button class="btn btn-light" v-bind:disabled="saving">Lưu đơn vị</button></form><p class="inventory-units">{{ snapshot.units.map(u=>u.name).join(' · ') }}</p>
            <div class="ops-scroll"><table><thead><tr><th>Mã</th><th>Tên</th><th>ĐVT</th><th>Giá tham khảo</th><th>Trạng thái</th><th></th></tr></thead><tbody><tr v-for="i in items" v-bind:key="i.id"><td>{{ i.code }}</td><td>{{ i.name }}</td><td>{{ i.unitName }}</td><td>{{ money(i.referencePrice) }}</td><td>{{ i.isActive ? 'Đang dùng' : 'Đã ẩn' }}</td><td><button class="btn btn-light btn-sm" v-if="canManage" v-on:click="openItem(i)">Sửa</button></td></tr></tbody></table></div>
        </section>
    </template>
    <div class="modal-backdrop" v-if="editor && editor!=='import'" v-on:click.self="closeEditor"><section class="modal ops-modal inventory-modal" role="dialog" aria-modal="true" aria-labelledby="inventory-editor-title"><h2 id="inventory-editor-title">{{ editor==='item' ? 'Mặt hàng' : typeText(documentForm.type) }}</h2>
        <form v-on:submit.prevent="editor==='item' ? saveItem() : saveDocument()"><fieldset v-bind:disabled="saving" class="ops-fieldset">
            <div class="ops-form" v-if="editor==='item'"><label class="wide">Tên mặt hàng<input v-model.trim="itemForm.name" maxlength="200" required /></label><label>Đơn vị<select v-model="itemForm.unitId" required><option value="">Chọn đơn vị</option><option v-for="u in snapshot.units" v-bind:value="u.id">{{ u.name }}</option></select></label><label>Giá tham khảo<input type="number" min="0" step="0.01" v-model.number="itemForm.referencePrice" required /></label><label class="ops-check wide"><input type="checkbox" v-model="itemForm.isActive" /> Đang sử dụng</label></div>
            <template v-else><div class="ops-form"><label>Ngày giờ ghi nhận<input type="datetime-local" v-model="documentForm.localAt" required /></label><label v-if="Number(documentForm.type)===2">Chi nhánh nhận<select v-model="documentForm.recipientPropertyId" required><option value="">Chọn chi nhánh</option><option v-for="p in properties" v-bind:value="p.id">{{ p.name }}</option></select></label><label class="wide">Ghi chú / lý do<textarea rows="2" v-model.trim="documentForm.note" maxlength="2000" v-bind:required="Number(documentForm.type)>=3"></textarea></label></div>
                <div class="ops-lines" aria-label="Các mặt hàng trong phiếu"><div class="ops-line" v-for="(line,index) in documentForm.lines" v-bind:key="index"><label>Mặt hàng<select v-model="line.itemId" v-on:change="lineChanged(line)" required><option value="">Chọn hàng</option><option v-for="i in snapshot.items.filter(x=>x.isActive)" v-bind:value="i.id">{{ i.code }} · {{ i.name }} ({{ i.unitName }})</option></select></label><label>Số lượng<input type="number" min="0.001" step="0.001" v-model.number="line.quantity" required /></label><label>Đơn giá<input type="number" min="0" step="0.01" v-model.number="line.unitPrice" required /></label><button class="btn btn-light" type="button" v-on:click="documentForm.lines.splice(index,1)" v-bind:disabled="documentForm.lines.length===1">Bỏ</button></div></div>
                <button type="button" class="btn btn-light inventory-add-line" v-on:click="documentForm.lines.push({itemId:'',quantity:1,unitPrice:0})" v-bind:disabled="documentForm.lines.length>=100">Thêm dòng</button>
            </template>
            <div class="ops-error" v-if="formError" role="alert">{{ formError }}</div><div class="ops-actions"><button type="button" class="btn btn-light" v-on:click="closeEditor">Hủy</button><button class="btn btn-primary" type="submit">{{ saving ? 'Đang ghi nhận…' : 'Ghi nhận' }}</button></div>
        </fieldset></form>
    </section></div>
    <div class="modal-backdrop" v-if="editor==='import'" v-on:click.self="closeEditor"><section class="modal ops-modal inventory-modal inventory-import-modal" role="dialog" aria-modal="true" aria-labelledby="inventory-import-title">
        <h2 id="inventory-import-title">{{ importForm.mode==='opening' ? 'Import tồn đầu' : 'Import mặt hàng' }}</h2>
        <form v-on:submit.prevent="previewImport"><fieldset class="ops-fieldset" v-bind:disabled="saving">
            <div class="ops-form">
                <label>File Excel (.xlsx)<input type="file" accept=".xlsx" v-on:change="importFileChanged" required /></label>
                <label>Khi trùng tên và đơn vị<select v-model="importForm.duplicates" v-on:change="clearPreview"><option value="skip">Bỏ qua danh mục đã có</option><option value="update">Cập nhật tên và giá</option></select></label>
                <label v-if="importForm.mode==='opening'">Ngày giờ tồn đầu<input type="datetime-local" v-model="importForm.localAt" v-on:change="clearPreview" required /></label>
                <label>Tên sheet (nếu file có nhiều bảng)<input v-model.trim="importForm.sheet" v-on:input="clearPreview" maxlength="31" placeholder="Tự nhận diện nếu chỉ có một bảng" /></label>
            </div>
            <div class="inventory-import-tools"><a class="inventory-item-link" v-bind:href="'/api/admin/inventory/import/template?mode='+importForm.mode">Tải file mẫu</a><span>.xlsx · tối đa 4 MB / 500 hàng</span><button type="submit" class="btn btn-light">{{ saving ? 'Đang đọc…' : 'Xem trước' }}</button></div>
        </fieldset></form>
        <template v-if="importPreview">
            <div class="inventory-import-summary"><strong>{{ importPreview.newItems }} mới</strong><span>{{ importPreview.updatedItems }} cập nhật</span><span>{{ importPreview.newUnits }} đơn vị mới</span><span v-if="importForm.mode==='opening'">{{ importPreview.openingItems }} ghi tồn đầu</span><span>{{ importPreview.skipped }} bỏ qua</span><strong v-if="importPreview.errors" class="inventory-invalid">{{ importPreview.errors }} lỗi</strong></div>
            <p class="inventory-import-hint" v-if="importForm.mode==='opening'">Tồn đã có phát sinh được giữ nguyên. Các dòng không được ghi tồn sẽ có lý do bên dưới.</p>
            <div class="ops-scroll inventory-preview-table" tabindex="0" aria-label="Xem trước import"><table><thead><tr><th>Dòng</th><th>Mặt hàng</th><th>ĐVT</th><th v-if="importForm.mode==='opening'">Tồn đầu</th><th>Giá</th><th>Xử lý</th></tr></thead><tbody><tr v-for="row in importPreview.rows" v-bind:key="row.row" v-bind:class="{'inventory-row-error':row.action==='error'}"><td>{{ row.row }}</td><td>{{ row.name }}</td><td>{{ row.unit }}</td><td v-if="importForm.mode==='opening'">{{ row.quantity===null ? '—' : qty(row.quantity) }}</td><td>{{ row.price===null ? '—' : money(row.price) }}</td><td>{{ row.message }}</td></tr></tbody></table></div>
        </template>
        <div class="ops-error" v-if="formError" role="alert">{{ formError }}</div>
        <div class="ops-actions inventory-import-footer"><button class="btn btn-light" v-bind:disabled="saving" v-on:click="closeEditor">Đóng</button><button class="btn btn-primary" v-if="importPreview && !importPreview.errors && importPreview.token" v-bind:disabled="saving" v-on:click="commitImport">{{ saving ? 'Đang nhập…' : 'Xác nhận import' }}</button></div>
    </section></div>
    <div class="modal-backdrop" v-if="detail" v-on:click.self="closeModal"><section class="modal ops-modal inventory-modal" role="dialog" aria-modal="true" aria-label="Chi tiết phiếu kho"><h2>{{ typeText(detail.type) }}</h2><p>{{ detail.code }} · {{ dateText(detail.occurredAtUtc) }}</p><p>Chi nhánh nhận: {{ detail.recipientName || 'Không áp dụng' }} · {{ detail.recordedByName || 'Chưa có tên người ghi nhận' }}</p><p>{{ detail.note }}</p><div class="ops-scroll"><table><thead><tr><th>Mặt hàng</th><th>ĐVT</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody><tr v-for="l in detail.lines"><td>{{ l.itemName }}</td><td>{{ l.unitName }}</td><td>{{ qty(l.quantity) }}</td><td>{{ money(l.unitPrice) }}</td><td>{{ money(l.quantity*l.unitPrice) }}</td></tr></tbody></table></div><p v-if="detail.isVoided">Đã hủy: {{ detail.voidReason }}</p><label v-if="canManage && !detail.isVoided">Lý do hủy<textarea v-model.trim="voidReason" maxlength="1000"></textarea></label><div class="ops-error" v-if="formError">{{ formError }}</div><div class="ops-actions"><button class="btn btn-light" v-bind:disabled="saving" v-on:click="detail=null">Đóng</button><button class="btn btn-danger" v-if="canManage && !detail.isVoided" v-bind:disabled="saving || !voidReason" v-on:click="voidDocument">Hủy phiếu</button></div></section></div>
    <div class="modal-backdrop" v-if="historyItem" v-on:click.self="closeModal"><section class="modal ops-modal inventory-modal" role="dialog" aria-modal="true" aria-label="Lịch sử mặt hàng"><h2>{{ historyItem.name }}</h2><p class="inventory-import-hint">Lịch sử nhập xuất</p><p v-if="historyLoading">Đang tải…</p><p v-else-if="!historyRows.length">Chưa có phát sinh.</p><div class="ops-details"><article v-for="d in historyRows" v-bind:key="d.id" v-bind:class="{'ops-voided':d.isVoided}"><strong>{{ typeText(d.type) }} · {{ dateText(d.occurredAtUtc) }}</strong><p v-for="l in d.lines">{{ qty(l.quantity) }} {{ l.unitName }} · {{ money(l.unitPrice) }} / {{ l.unitName }}</p><p>{{ d.recipientName }} · {{ d.note }}</p><small>{{ d.recordedByName || 'Chưa có tên người ghi nhận' }} · {{ d.isVoided ? 'Đã hủy: '+d.voidReason : 'Đã ghi nhận' }}</small></article></div><div class="ops-error" v-if="formError">{{ formError }}</div><div class="ops-actions"><button class="btn btn-light" v-if="historyMore" v-bind:disabled="historyLoading" v-on:click="moreHistory">Xem thêm</button><button class="btn btn-light" v-on:click="historyItem=null">Đóng</button></div></section></div>
</div>
@section Scripts {
    <script src="~/js/pages/operational-forms.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin-inventory.js" asp-append-version="true"></script>
}
