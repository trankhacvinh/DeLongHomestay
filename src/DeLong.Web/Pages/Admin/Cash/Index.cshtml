@page "/Admin/Cash"
@model DeLong.Web.Pages.Admin.Cash.IndexModel
@{ ViewData["Title"] = "Tiền mặt"; }
@section Head { <link rel="stylesheet" href="~/css/admin-operations-ledger.css" asp-append-version="true" /> }
<script id="cash-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>
<div id="cash-page" class="operations-ledger" v-cloak>
    <header><div class="page-eyebrow">Thu và chi thực tế</div><h1>Tiền mặt</h1><p class="ops-note">Tự lấy payment tiền mặt từ booking và thêm khoản thu ngoài. Không cộng chuyển khoản, thẻ hay QR. Chênh lệch thu–chi không phải số dư trong két và không phải lợi nhuận.</p></header>
    <div class="ops-error" v-if="error" role="alert">{{ error }}</div><div class="ops-success" v-if="message" role="status">{{ message }}</div>
    <section class="ops-panel ops-toolbar"><label>Tháng<input type="month" v-model="month" v-on:change="load" /></label><label>Chi nhánh<select v-model="scope" v-on:change="scopeChanged"><option v-if="properties.length>1" value="all">Tất cả chi nhánh</option><option v-for="p in properties" v-bind:value="p.id">{{ p.name }}</option></select></label><label>Phòng<select v-model="roomId" v-on:change="load"><option value="">Tất cả / gồm khoản chung</option><option v-for="r in roomOptions" v-bind:value="r.id">{{ propertyName(r.propertyId) }} · {{ r.name }}</option></select></label><button class="btn btn-light" v-bind:disabled="loading" v-on:click="load">{{ loading ? 'Đang tải…' : 'Tải lại' }}</button><a class="btn btn-light" v-bind:href="exportUrl">Xuất Excel</a><button class="btn btn-primary" v-if="canManage && editableProperties.length" v-on:click="openEditor('receipt')">Thêm thu ngoài</button><button class="btn btn-primary" v-if="canManage && editableProperties.length" v-on:click="openEditor('expense')">Thêm chi tiền mặt</button></section>
    <template v-if="loadedQuery===query">
    <section class="ops-kpis"><article><span>Thu booking tiền mặt</span><strong>{{ money(snapshot.totals.bookingReceipts) }}</strong></article><article><span>Thu ngoài booking</span><strong>{{ money(snapshot.totals.otherReceipts) }}</strong></article><article><span>Hoàn tiền mặt</span><strong>{{ money(snapshot.totals.refunds) }}</strong></article><article><span>Chi tiền mặt</span><strong>{{ money(snapshot.totals.expenses) }}</strong></article><article><span>Chênh lệch thu–chi</span><strong>{{ money(snapshot.totals.net) }}</strong></article></section>
    <p class="ops-note">Tính theo ngày giao dịch tại chi nhánh, không phải ngày khách nhận phòng. Khoản hủy không tính tổng. Chi chung không tự chia vào các phòng; khi lọc phòng chỉ tính giao dịch gắn phòng đó. Thu booking hiển thị theo phòng hiện đang gắn với booking.</p>
    <nav class="ops-tabs" aria-label="Báo cáo tiền mặt"><button class="btn btn-light" v-for="t in tabs" v-bind:class="{active:tab===t.key}" v-on:click="tab=t.key">{{ t.name }}</button></nav>
    <section class="ops-panel" v-if="tab==='ledger'"><div class="ops-section-head"><h2>Giao dịch trong tháng</h2><label class="ops-check"><input type="checkbox" v-model="showVoided" /> Hiện giao dịch đã hủy</label></div><div class="ops-scroll"><table><thead><tr><th>Ngày / nguồn</th><th>Chi nhánh / phòng</th><th>Nội dung</th><th class="number">Thu</th><th class="number">Chi / hoàn</th><th></th></tr></thead><tbody><tr v-for="e in entries" v-bind:key="e.source+e.id" v-bind:class="{'ops-voided':e.isVoided}"><td>{{ dateText(e) }}<small>{{ sourceText(e.source) }}{{ e.isVoided ? ' · Đã hủy' : '' }}</small></td><td>{{ e.propertyName }}<small>{{ e.roomName || 'Khoản chung' }}</small></td><td>{{ e.description }}<small>{{ e.note }}</small></td><td class="number">{{ money(e.inflow) }}</td><td class="number">{{ money(e.outflow) }}</td><td><button class="btn btn-light btn-sm" v-on:click="openEntry(e)">Chi tiết</button></td></tr></tbody></table></div><p class="ops-empty" v-if="!entries.length">Không có giao dịch trong bộ lọc này.</p></section>
    <section class="ops-panel" v-else><h2>{{ tabs.find(t=>t.key===tab)?.name }}</h2><p class="ops-note">Bấm một dòng để xem các giao dịch cấu thành tổng. Không tính giao dịch hủy.</p><div class="ops-scroll"><table><thead><tr><th>Nhóm</th><th class="number">Thu</th><th class="number">Hoàn</th><th class="number">Chi</th><th class="number">Chênh lệch</th></tr></thead><tbody><tr v-for="g in groups" v-bind:key="g.key"><td><button class="btn btn-light btn-sm" v-on:click="detailGroup={type:tab,...g}">{{ g.name }}</button></td><td class="number">{{ money(g.inflow) }}</td><td class="number">{{ money(g.refunds) }}</td><td class="number">{{ money(g.expenses) }}</td><td class="number">{{ money(g.net) }}</td></tr></tbody></table></div></section>
    </template>
    <div class="modal-backdrop" v-if="editor" v-on:click.self="closeEditor"><section class="modal ops-modal" role="dialog" aria-modal="true" aria-labelledby="cash-editor-title"><h2 id="cash-editor-title">{{ editor==='receipt' ? 'Thu ngoài booking bằng tiền mặt' : 'Chi tiền mặt' }}</h2><p class="ops-note" v-if="editor==='receipt'">Chỉ nhập khoản thu ngoài. Tiền đã ghi nhận trên booking được lấy tự động, không nhập lại tại đây.</p><form v-on:submit.prevent="save"><fieldset class="ops-fieldset" v-bind:disabled="saving"><div class="ops-form"><label>Chi nhánh<select v-model="form.propertyId" v-on:change="formPropertyChanged" required><option v-for="p in editableProperties" v-bind:value="p.id">{{ p.name }}</option></select></label><label>Phòng (nếu có)<select v-model="form.roomId"><option value="">Khoản chung của chi nhánh</option><option v-for="r in rooms.filter(x=>x.propertyId===form.propertyId)" v-bind:value="r.id">{{ r.name }}</option></select></label><label>Ngày giờ thực thu/chi<input type="datetime-local" v-model="form.localAt" required /></label><label>Số tiền<input type="number" v-model.number="form.amount" min="0.01" max="10000000000" step="0.01" required /></label><label v-if="editor==='expense'">Nhóm chi<input v-model.trim="form.category" maxlength="100" required placeholder="Ví dụ: Vật tư, sửa chữa, vệ sinh" /></label><label class="wide">Nội dung<input v-model.trim="form.description" maxlength="500" required /></label><label class="wide">Ghi chú<textarea v-model.trim="form.note" maxlength="2000"></textarea></label></div><p class="ops-note">Phương thức: Tiền mặt. Lỗi mạng có thể gửi lại cùng nội dung, không cần tạo khoản mới.</p><div class="ops-error" v-if="formError" role="alert">{{ formError }}</div><div class="ops-actions"><button class="btn btn-light" type="button" v-on:click="closeEditor">Hủy</button><button class="btn btn-primary" type="submit">{{ saving ? 'Đang ghi nhận…' : 'Ghi nhận' }}</button></div></fieldset></form></section></div>
    <div class="modal-backdrop" v-if="detailGroup" v-on:click.self="detailGroup=null"><section class="modal ops-modal" role="dialog" aria-modal="true" aria-label="Giao dịch cấu thành báo cáo"><h2>{{ detailGroup.name }}</h2><div class="ops-details"><article v-for="e in detailEntries" v-bind:key="e.source+e.id"><strong>{{ dateText(e) }} · {{ sourceText(e.source) }}</strong><p>{{ e.propertyName }} · {{ e.roomName || 'Khoản chung' }} · {{ e.description }}</p><p>Thu {{ money(e.inflow) }} · Chi/hoàn {{ money(e.outflow) }}</p><p>{{ e.note }}</p></article></div><div class="ops-actions"><button class="btn btn-light" v-on:click="detailGroup=null">Đóng</button></div></section></div>
    <div class="modal-backdrop" v-if="detailEntry" v-on:click.self="closeEntry"><section class="modal ops-modal" role="dialog" aria-modal="true" aria-label="Chi tiết giao dịch tiền mặt"><h2>{{ sourceText(detailEntry.source) }}</h2><p>{{ dateText(detailEntry) }} · {{ detailEntry.propertyName }} · {{ detailEntry.roomName || 'Khoản chung' }}</p><p>{{ detailEntry.description }}</p><p>{{ detailEntry.note }}</p><p>Thu {{ money(detailEntry.inflow) }} · Chi/hoàn {{ money(detailEntry.outflow) }}</p><p>Người ghi nhận: {{ detailEntry.recordedByName || 'Chưa có tên người ghi nhận' }}</p><p v-if="detailEntry.isVoided">Đã hủy: {{ detailEntry.voidReason }}</p><p class="ops-note" v-if="detailEntry.source.startsWith('booking-')">Khoản này lấy từ payment booking. Thực hiện sửa/hủy giao dịch tại booking để giữ đúng công nợ.</p><label v-if="canVoidEntry">Lý do hủy<textarea v-model.trim="voidReason" maxlength="1000"></textarea></label><div class="ops-error" v-if="formError">{{ formError }}</div><div class="ops-actions"><button class="btn btn-light" v-bind:disabled="saving" v-on:click="closeEntry">Đóng</button><button class="btn btn-danger" v-if="canVoidEntry" v-bind:disabled="saving || !voidReason" v-on:click="voidEntry">Hủy giao dịch</button></div></section></div>
</div>
@section Scripts {
    <script src="~/js/pages/operational-forms.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin-cash.js" asp-append-version="true"></script>
}
