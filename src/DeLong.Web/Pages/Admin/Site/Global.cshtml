
@page
@model DeLong.Web.Pages.Admin.Site.GlobalModel
@{
    ViewData["Title"] = "Trang chủ chung";
}
@section Head {
    <link rel="stylesheet" href="~/css/site-cms.css" asp-append-version="true" />
    <style>
        .global-branding-panel{margin-bottom:18px;padding:22px}.global-branding-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px}.global-branding-head h2{margin:4px 0 6px}.global-branding-head p{margin:0;color:#75827f}.global-branding-preview{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid #dce5e1;border-radius:14px;background:#f8fbf9;margin-bottom:18px}.global-branding-preview img,.global-branding-preview .brand-mark{width:56px;height:56px;object-fit:contain;border-radius:14px}.global-branding-preview strong,.global-branding-preview small{display:block}.global-branding-preview small{margin-top:4px;color:#74817e}.global-branding-note{margin-top:8px;padding:10px 12px;border-radius:11px;background:#eef6f3;color:#47635d;font-size:12px}.global-branding-assets{display:grid;gap:12px}.global-branding-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}@@media(max-width:760px){.global-branding-head{display:grid}.global-branding-actions{justify-content:stretch;flex-direction:column}.global-branding-actions .btn{width:100%}}
    </style>
}

<div id="global-site-cms" class="site-admin-page" v-cloak>
    <script id="global-site-cms-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>
    <div class="page-title-row site-page-head"><div><div class="page-eyebrow">Website chung</div><h1>Trang chủ toàn hệ thống</h1><p>Cấu hình thương hiệu và các section xuất hiện tại <code>/</code>. Trang riêng từng cơ sở tiếp tục cấu hình ở mục Website của cơ sở đó.</p></div><div class="site-head-actions"><a class="btn btn-light" asp-page="/Admin/Site/Index">Trang cơ sở</a><a class="btn btn-light" href="/" target="_blank" rel="noopener">Xem trang chủ ↗</a></div></div>

    <section class="panel global-branding-panel">
        <div class="global-branding-head"><div><span class="page-eyebrow">Thương hiệu chung</span><h2>Logo & nhận diện toàn hệ thống</h2><p>Trường để trống sẽ tự dùng cấu hình của cơ sở duy nhất đang hoạt động. Khi có nhiều cơ sở, chỉ các giá trị ghi đè bên dưới được dùng cho trang chung.</p></div></div>
        <div class="global-branding-preview">
            <img v-if="brandPreviewLogo" v-bind:src="brandPreviewLogo" v-bind:alt="brandPreviewName" />
            <span v-else class="brand-mark">DL</span>
            <span><strong>{{ brandPreviewName }}</strong><small>{{ brandPreviewTagline }}</small></span>
        </div>
        <div class="global-branding-note" v-if="brandingEffective.hasSinglePropertyFallback">Đang có 1 cơ sở: các trường để trống sẽ kế thừa từ <strong>{{ brandingEffective.fallbackPropertyName }}</strong>.</div>
        <div class="form-grid site-form-grid">
            <div class="field"><label>Tên thương hiệu chung</label><input v-model.trim="branding.siteName" v-bind:placeholder="brandingEffective.siteName" /><small>Để trống = kế thừa khi chỉ có 1 cơ sở.</small></div>
            <div class="field"><label>Tagline</label><input v-model.trim="branding.tagline" v-bind:placeholder="brandingEffective.tagline" /></div>
            <div class="field"><label>Meta title</label><input v-model.trim="branding.metaTitle" v-bind:placeholder="brandingEffective.metaTitle" /></div>
            <div class="field"><label>Meta description</label><textarea v-model.trim="branding.metaDescription" rows="3" v-bind:placeholder="brandingEffective.metaDescription"></textarea></div>
        </div>
        <div class="global-branding-assets">
            <div class="field"><label>Logo chung</label><div class="asset-input-row"><input v-model.trim="branding.logoUrl" v-bind:placeholder="brandingEffective.logoUrl || 'Để trống = dùng logo cơ sở nếu chỉ có 1 cơ sở'" /><label class="btn btn-light btn-sm file-btn">{{ brandingUploading === 'logo' ? 'Đang tải…' : 'Tải logo' }}<input type="file" accept="image/png,image/jpeg,image/webp" v-bind:disabled="!!brandingUploading" v-on:change="uploadBrandAsset('logo', 'logoUrl', $event)" /></label></div></div>
            <div class="field"><label>Favicon</label><div class="asset-input-row"><input v-model.trim="branding.faviconUrl" v-bind:placeholder="brandingEffective.faviconUrl || 'Để trống = kế thừa favicon cơ sở'" /><label class="btn btn-light btn-sm file-btn">{{ brandingUploading === 'favicon' ? 'Đang tải…' : 'Tải favicon' }}<input type="file" accept="image/png,image/jpeg,image/webp" v-bind:disabled="!!brandingUploading" v-on:change="uploadBrandAsset('favicon', 'faviconUrl', $event)" /></label></div></div>
            <div class="field"><label>Ảnh Open Graph</label><div class="asset-input-row"><input v-model.trim="branding.ogImageUrl" v-bind:placeholder="brandingEffective.ogImageUrl || 'Để trống = kế thừa ảnh OG cơ sở'" /><label class="btn btn-light btn-sm file-btn">{{ brandingUploading === 'og' ? 'Đang tải…' : 'Tải ảnh OG' }}<input type="file" accept="image/png,image/jpeg,image/webp" v-bind:disabled="!!brandingUploading" v-on:change="uploadBrandAsset('og', 'ogImageUrl', $event)" /></label></div></div>
        </div>
        <div class="global-branding-actions"><button class="btn btn-light" type="button" v-if="brandingEffective.hasSinglePropertyFallback" v-bind:disabled="brandingSaving" v-on:click="useInheritedBranding">Dùng lại cấu hình cơ sở</button><button class="btn btn-primary" type="button" v-bind:disabled="brandingSaving || !!brandingUploading" v-on:click="saveBranding">{{ brandingSaving ? 'Đang lưu…' : 'Lưu thương hiệu chung' }}</button></div>
    </section>

    <section class="site-home-layout"><div class="site-home-toolbar panel"><div><span class="page-eyebrow">Block editor</span><h2>Cấu trúc trang chủ chung</h2><p>RoomGrid có thể lấy tất cả, chia quota theo cơ sở hoặc chọn thủ công từng phòng.</p></div><div class="site-head-actions"><button class="btn btn-light" type="button" v-bind:disabled="applyingPreset" v-on:click="applyHospitalityPreset">{{ applyingPreset ? 'Đang áp dụng…' : 'Áp dụng mẫu khách sạn' }}</button><button class="btn btn-primary" type="button" v-on:click="openCreate"><svg><use href="#i-plus" /></svg>Thêm khối</button></div></div>
        <div id="global-section-list" class="home-section-list"><article class="panel home-section-card" v-for="section in sections" v-bind:key="section.id" v-bind:data-id="section.id" v-bind:class="{ hidden: !section.isVisible }"><button class="home-drag-handle" type="button">⋮⋮</button><div class="home-section-copy"><span class="home-section-type">{{ sectionTypeLabel(section.type) }}</span><strong>{{ section.name }}</strong><small>{{ section.variant }} · {{ section.isVisible ? 'Đang hiển thị' : 'Đang ẩn' }}</small></div><div class="home-section-actions"><button class="btn btn-light btn-sm" type="button" v-on:click="toggleSection(section)">{{ section.isVisible ? 'Ẩn' : 'Hiện' }}</button><button class="btn btn-light btn-sm" type="button" v-on:click="openEdit(section)">Sửa</button></div></article></div>
    </section>

    <div class="modal-backdrop" v-if="editor.open" v-on:click.self="closeEditor"><section class="modal-card home-section-editor" role="dialog" aria-modal="true"><div class="modal-head"><div><h2>{{ editor.mode === 'create' ? 'Thêm khối trang chủ chung' : 'Sửa khối' }}</h2><p class="small muted">Khối dùng dữ liệu public của các cơ sở đang hoạt động.</p></div><button class="icon-btn" type="button" v-on:click="closeEditor">×</button></div><div class="site-modal-body home-editor-scroll">
        <div class="form-grid site-form-grid"><div class="field"><label>Loại khối</label><select v-model="form.type" v-on:change="typeChanged"><option v-for="type in sectionTypes" v-bind:value="type.value">{{ type.label }}</option></select></div><div class="field"><label>Tên quản trị</label><input v-model.trim="form.name" /></div><div class="field"><label>Layout</label><select v-model="form.variant"><option v-for="variant in variantsFor(form.type)" v-bind:value="variant">{{ variant }}</option></select></div><label class="site-toggle"><input type="checkbox" v-model="form.isVisible" /><span><strong>Hiển thị khối</strong></span></label></div>
        <div class="home-content-fields" v-if="form.type === 'Hero'"><div class="field"><label>Eyebrow</label><input v-model="form.content.eyebrow" /></div><div class="field"><label>Tiêu đề</label><textarea v-model="form.content.title" rows="2"></textarea></div><div class="field"><label>Mô tả</label><textarea v-model="form.content.body" rows="4"></textarea></div><div class="form-grid"><div class="field"><label>CTA chính</label><input v-model="form.content.primaryText" /></div><div class="field"><label>URL</label><input v-model="form.content.primaryUrl" /></div><div class="field"><label>CTA phụ</label><input v-model="form.content.secondaryText" /></div><div class="field"><label>URL</label><input v-model="form.content.secondaryUrl" /></div></div><div class="field"><label>Ảnh Hero</label><div class="asset-input-row"><input v-model="form.content.imageUrl" placeholder="/uploads/site/global/section-....webp" /><label class="btn btn-light btn-sm file-btn">{{ uploading ? 'Đang tải…' : 'Tải ảnh' }}<input type="file" accept="image/png,image/jpeg,image/webp" v-bind:disabled="uploading" v-on:change="uploadSectionImage($event)" /></label></div><small>Nếu bỏ trống, website tự ưu tiên ảnh cover cơ sở rồi mới tới ảnh phòng.</small></div></div>
        <div class="home-content-fields" v-else-if="form.type === 'BranchGrid'"><div class="field"><label>Eyebrow</label><input v-model="form.content.eyebrow" /></div><div class="field"><label>Tiêu đề</label><input v-model="form.content.title" /></div><div class="field"><label>Cơ sở hiển thị</label><small>Không chọn = hiển thị tất cả cơ sở active.</small><div class="site-choice-list"><label v-for="property in properties" v-bind:key="property.id"><input type="checkbox" v-bind:checked="includes(form.content.propertyIds, property.id)" v-on:change="toggleArray('propertyIds', property.id)" /><span><strong>{{ property.siteName }}</strong><small>{{ property.roomCount }} phòng · /h/{{ property.siteSlug }}</small></span></label></div></div></div>
        <div class="home-content-fields" v-else-if="form.type === 'RoomGrid'"><div class="field"><label>Eyebrow</label><input v-model="form.content.eyebrow" /></div><div class="field"><label>Tiêu đề</label><input v-model="form.content.title" /></div><div class="form-grid"><div class="field"><label>Cách lấy phòng</label><select v-model="form.content.mode"><option value="all">Tự lấy tất cả</option><option value="byProperty">Chia số lượng theo cơ sở</option><option value="manual">Chọn từng phòng</option></select></div><div class="field"><label>Số phòng tối đa</label><input type="number" min="1" max="24" v-model.number="form.content.limit" /></div></div><div class="field" v-if="form.content.mode === 'byProperty'"><label>Số phòng theo từng cơ sở</label><div class="site-quota-grid"><label v-for="property in properties"><span>{{ property.siteName }}</span><input type="number" min="0" max="24" v-model.number="form.content.propertyQuotas[property.id]" /></label></div></div><div class="field" v-if="form.content.mode === 'manual'"><label>Chọn phòng</label><div class="site-choice-list"><label v-for="room in rooms"><input type="checkbox" v-bind:checked="includes(form.content.roomIds, room.id)" v-on:change="toggleArray('roomIds', room.id)" /><span><strong>{{ room.name }} · {{ room.code }}</strong><small>{{ room.propertyName }}</small></span></label></div></div></div>
        <div class="home-content-fields" v-else-if="form.type === 'AvailabilitySearch'"><div class="field"><label>Tiêu đề</label><input v-model="form.content.title" /></div><small>Layout <strong>booking-bar</strong> phù hợp nhất khi khối này nằm ngay sau Hero.</small></div>
        <div class="home-content-fields" v-else-if="form.type === 'FeatureGrid'"><div class="field"><label>Eyebrow</label><input v-model="form.content.eyebrow" /></div><div class="field"><label>Tiêu đề</label><textarea v-model="form.content.title" rows="2"></textarea></div><div class="field"><label>Mô tả</label><textarea v-model="form.content.body" rows="4"></textarea></div><div class="field"><label>Các mục (mỗi dòng)</label><textarea v-model="form.itemsText" rows="5"></textarea></div><div class="field"><label>Ảnh kể chuyện</label><div class="asset-input-row"><input v-model="form.content.imageUrl" placeholder="Để trống = dùng ảnh cover cơ sở" /><label class="btn btn-light btn-sm file-btn">{{ uploading ? 'Đang tải…' : 'Tải ảnh' }}<input type="file" accept="image/png,image/jpeg,image/webp" v-bind:disabled="uploading" v-on:change="uploadSectionImage($event)" /></label></div><small>Layout <strong>split</strong> hoặc <strong>editorial</strong> sẽ đặt ảnh cạnh nội dung như landing page khách sạn.</small></div></div>
        <div class="home-content-fields" v-else-if="form.type === 'RichText'"><div class="field"><label>Nội dung HTML</label><textarea v-model="form.content.html" rows="12"></textarea></div></div>
        <div class="home-content-fields" v-else-if="form.type === 'Cta'"><div class="field"><label>Tiêu đề</label><input v-model="form.content.title" /></div><div class="field"><label>Mô tả</label><textarea v-model="form.content.body" rows="3"></textarea></div><div class="form-grid"><div class="field"><label>Nút</label><input v-model="form.content.buttonText" /></div><div class="field"><label>URL</label><input v-model="form.content.buttonUrl" /></div></div></div>
    </div><div class="modal-actions"><button v-if="editor.mode === 'edit'" class="btn btn-danger-outline" type="button" v-on:click="deleteSection">Xóa khối</button><span class="modal-spacer"></span><button class="btn btn-light" type="button" v-on:click="closeEditor">Hủy</button><button class="btn btn-primary" type="button" v-bind:disabled="saving" v-on:click="saveSection">{{ saving ? 'Đang lưu…' : 'Lưu khối' }}</button></div></section></div>
    <div class="toast" v-if="toast.show" v-bind:class="toast.type">{{ toast.message }}</div>
</div>
@section Scripts { <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script><script src="~/js/pages/admin-global-site.js" asp-append-version="true"></script> }
