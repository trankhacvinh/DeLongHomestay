@page
@model DeLong.Web.Pages.Admin.Site.PagesModel
@{
    ViewData["Title"] = "Trang nội dung";
}
@section Head {
    <link rel="stylesheet" href="~/css/custom-pages-admin.css" asp-append-version="true" />
}

<div class="custom-pages-admin" data-custom-pages-admin>
    <script type="application/json" data-custom-pages-data>@Html.Raw(Model.PageDataJson)</script>
    <div class="page-title-row custom-pages-head">
        <div><div class="page-eyebrow">Website & nội dung</div><h1>Trang nội dung</h1><p>Tạo các trang Giới thiệu, Liên hệ, Chính sách, Dịch vụ hoặc landing page bằng chính Visual Editor hiện tại.</p></div>
        <div class="custom-pages-head-actions"><button class="btn btn-primary" type="button" data-page-create>＋ Tạo trang</button></div>
    </div>

    <section class="panel custom-pages-scope" data-page-scope></section>
    <section class="custom-pages-summary" data-page-summary></section>
    <section class="custom-pages-list" data-page-list><div class="panel custom-pages-loading">Đang tải danh sách trang…</div></section>

    <div class="modal-backdrop" data-page-modal hidden>
        <section class="modal-card custom-page-modal" role="dialog" aria-modal="true" aria-labelledby="custom-page-modal-title">
            <div class="modal-head"><div><div class="page-eyebrow" data-page-modal-eyebrow>TRANG MỚI</div><h2 id="custom-page-modal-title" data-page-modal-title>Tạo trang nội dung</h2></div><button class="icon-btn" type="button" data-page-modal-close aria-label="Đóng">×</button></div>
            <form data-page-form>
                <div class="custom-page-form-body">
                    <div class="form-grid">
                        <div class="field form-full"><label>Tên trang</label><input name="title" maxlength="200" required placeholder="Ví dụ: Giới thiệu De Long Homestay" /></div>
                        <div class="field"><label>Slug</label><input name="slug" maxlength="120" placeholder="de-trong-de-tu-sinh" /><small>Chỉ chữ thường, số và dấu gạch ngang.</small></div>
                        <div class="field" data-template-field><label>Mẫu khởi tạo</label><select name="template"><option value="blank">Trang trống</option><option value="about">Giới thiệu</option><option value="contact">Liên hệ</option><option value="promo">Landing ưu đãi</option></select></div>
                    </div>
                    <div class="custom-page-flags"><label class="site-toggle"><input type="checkbox" name="published" /><span><strong>Xuất bản</strong><small>Tắt để giữ bản nháp; người ngoài sẽ không truy cập được.</small></span></label><label class="site-toggle"><input type="checkbox" name="hideNavigation" /><span><strong>Ẩn khỏi danh sách điều hướng</strong><small>Trang vẫn có URL public nếu đã xuất bản.</small></span></label></div>
                    <section class="custom-page-seo"><div><span class="page-eyebrow">SEO</span><h3>Thông tin tìm kiếm & chia sẻ</h3></div><div class="field"><label>SEO title</label><input name="seoTitle" maxlength="200" /></div><div class="field"><label>Meta description</label><textarea name="seoDescription" rows="3" maxlength="500"></textarea></div><div class="field"><label>Ảnh Open Graph</label><div class="custom-page-media-row"><input name="ogImageUrl" placeholder="URL ảnh hoặc tải ảnh mới" /><label class="btn btn-light btn-sm file-btn">Tải ảnh<input type="file" accept="image/png,image/jpeg,image/webp" data-page-og-upload /></label></div><small>Ảnh upload sẽ đi qua storage website và được Media Library nhận diện.</small></div></section>
                </div>
                <div class="modal-actions"><button class="btn btn-light" type="button" data-page-modal-close>Hủy</button><button class="btn btn-primary" type="submit" data-page-save>Lưu trang</button></div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/custom-pages-admin.js" asp-append-version="true"></script>
}
