@page
@model DeLong.Web.Pages.Admin.Site.EditorialGlobalModel
@{
    ViewData["Title"] = "Gallery & Blog trang chủ";
}
@section Head {
    <link rel="stylesheet" href="~/css/site-cms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/editorial-admin.css" asp-append-version="true" />
}
<div id="editorial-global" class="site-admin-page" v-cloak>
    <script id="editorial-global-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>
    <div class="page-title-row site-page-head"><div><div class="page-eyebrow">Website chung</div><h1>Gallery & Blog trên trang chủ</h1><p>Chọn chính xác cơ sở, ảnh và bài viết nào được phép xuất hiện tại trang chủ chung.</p></div><div class="site-head-actions"><a class="btn btn-light" href="/Admin/Site/Global">Trang chủ chung</a><a class="btn btn-light" href="/" target="_blank" rel="noopener">Xem website ↗</a></div></div>

    <section v-if="loading" class="panel editorial-loading">Đang tải cấu hình…</section>
    <div v-else class="site-settings-layout">
        <div class="site-settings-main">
            <section class="panel site-section-card"><div class="site-section-title"><span>01</span><div><h2>Gallery trang chủ</h2><p>Có thể lấy ảnh từ tất cả cơ sở, một nhóm cơ sở hoặc chọn thủ công từng ảnh.</p></div></div><div class="form-grid site-form-grid"><label class="site-toggle form-full"><input type="checkbox" v-model="settings.galleryEnabled" /><span><strong>Hiển thị Gallery trên trang chủ</strong></span></label><div class="field"><label>Tiêu đề</label><input v-model="settings.galleryTitle" /></div><div class="field"><label>Số ảnh tối đa</label><input type="number" min="1" max="24" v-model.number="settings.galleryLimit" /></div><div class="field form-full"><label>Nguồn dữ liệu</label><select v-model="settings.galleryMode"><option value="all">Tất cả cơ sở active</option><option value="properties">Chọn cơ sở</option><option value="manual">Chọn từng ảnh</option></select></div><div class="field form-full" v-if="settings.galleryMode==='properties'"><label>Cơ sở được lấy ảnh</label><div class="site-choice-list"><label v-for="property in properties" v-bind:key="property.id"><input type="checkbox" v-bind:checked="includes(settings.galleryPropertyIds,property.id)" v-on:change="toggle('galleryPropertyIds',property.id)" /><span><strong>{{ property.siteName }}</strong><small>{{ property.roomCount }} phòng</small></span></label></div></div><div class="field form-full" v-if="settings.galleryMode==='manual'"><label>Ảnh được hiển thị</label><div class="editorial-global-gallery-choice"><label v-for="item in gallery" v-bind:key="item.id"><input type="checkbox" v-bind:checked="includes(settings.galleryItemIds,item.id)" v-on:change="toggle('galleryItemIds',item.id)" /><img v-bind:src="item.imageUrl" v-bind:alt="item.altText" /><span>{{ item.propertyName }}</span></label></div></div></div></section>

            <section class="panel site-section-card"><div class="site-section-title"><span>02</span><div><h2>Blog trang chủ</h2><p>Chọn bài viết mới nhất theo cơ sở hoặc chỉ định thủ công bài muốn đẩy lên trang chủ.</p></div></div><div class="form-grid site-form-grid"><label class="site-toggle form-full"><input type="checkbox" v-model="settings.blogEnabled" /><span><strong>Hiển thị Blog trên trang chủ</strong></span></label><div class="field"><label>Tiêu đề</label><input v-model="settings.blogTitle" /></div><div class="field"><label>Số bài tối đa</label><input type="number" min="1" max="12" v-model.number="settings.blogLimit" /></div><div class="field form-full"><label>Nguồn dữ liệu</label><select v-model="settings.blogMode"><option value="all">Tất cả cơ sở active</option><option value="properties">Chọn cơ sở</option><option value="manual">Chọn từng bài</option></select></div><div class="field form-full" v-if="settings.blogMode==='properties'"><label>Cơ sở được lấy bài</label><div class="site-choice-list"><label v-for="property in properties" v-bind:key="property.id"><input type="checkbox" v-bind:checked="includes(settings.blogPropertyIds,property.id)" v-on:change="toggle('blogPropertyIds',property.id)" /><span><strong>{{ property.siteName }}</strong><small>{{ property.roomCount }} phòng</small></span></label></div></div><div class="field form-full" v-if="settings.blogMode==='manual'"><label>Bài viết được hiển thị</label><div class="site-choice-list"><label v-for="post in posts" v-bind:key="post.id"><input type="checkbox" v-bind:checked="includes(settings.blogPostIds,post.id)" v-on:change="toggle('blogPostIds',post.id)" /><span><strong>{{ post.title }}</strong><small>{{ post.propertyName }}</small></span></label></div></div></div></section>
        </div>
        <aside class="site-settings-aside"><section class="panel site-media-card"><div class="site-section-title compact"><div><h2>Nguyên tắc hiển thị</h2><p>Nội dung của cơ sở đã tắt hoặc item chưa xuất bản sẽ luôn bị loại khỏi public, kể cả khi từng được chọn thủ công.</p></div></div><div class="site-choice-list"><label><span><strong>All</strong><small>Tự lấy mới nhất từ mọi cơ sở active.</small></span></label><label><span><strong>Chọn cơ sở</strong><small>Chỉ lấy từ những cơ sở bạn đánh dấu.</small></span></label><label><span><strong>Chọn thủ công</strong><small>Giữ đúng thứ tự item bạn đã chọn.</small></span></label></div></section><button class="btn btn-primary site-save-button" type="button" v-bind:disabled="saving" v-on:click="save">{{ saving ? 'Đang lưu…' : 'Lưu cấu hình trang chủ' }}</button></aside>
    </div>
    <div class="toast" v-if="toast.show" v-bind:class="toast.type">{{ toast.message }}</div>
</div>
@section Scripts { <script src="~/js/pages/admin-editorial-global.js" asp-append-version="true"></script> }
