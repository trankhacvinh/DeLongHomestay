@page
@model DeLong.Web.Pages.Admin.Pricing.IndexModel
@{ ViewData["Title"] = "Giá & ngày đặc biệt"; }
@section Head {
    <link rel="stylesheet" href="~/css/entities.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/admin-pricing.css" asp-append-version="true" />
}

<div id="pricing-page" v-cloak>
    <script id="pricing-page-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>
    <div class="page-title-row"><div><div class="page-eyebrow">Doanh thu theo cơ sở</div><h1>Giá & ngày đặc biệt</h1><p>Giá ngày thường, cuối tuần, combo 3 ca, cả ngày và phụ thu lễ.</p></div></div>
    <nav class="pricing-tabs"><button v-bind:class="{active: tab === 'rates'}" v-on:click="tab='rates'">Bảng giá phòng</button><button v-bind:class="{active: tab === 'special'}" v-on:click="tab='special'">Ngày đặc biệt</button><button v-bind:class="{active: tab === 'rules'}" v-on:click="tab='rules'">Quy tắc combo</button></nav>

    <section v-if="tab === 'rates'" class="panel pricing-panel">
        <div class="entity-toolbar"><div><strong>Bảng giá theo phòng</strong><div class="tiny muted">Giá cuối tuần mặc định dùng giá ngày thường; bỏ chọn để nhập giá riêng.</div></div><button v-if="canManage" class="btn btn-primary" v-on:click="saveRates" v-bind:disabled="saving">{{ saving ? 'Đang lưu...' : 'Lưu bảng giá' }}</button></div>
        <div v-for="room in rooms" v-bind:key="room.id" class="price-room">
            <div class="price-room-head"><div><strong>{{ room.name }}</strong><span>{{ room.code }}</span></div><label><input type="checkbox" v-model="room.fullDayPricingEnabled" /> Có giá combo cả ngày</label></div>
            <div v-if="room.fullDayPricingEnabled" class="price-full-day"><label>Combo ngày thường <input type="number" min="0" step="1000" v-model.number="room.fullDayPrice" /></label><label class="check"><input type="checkbox" v-model="room.useWeekdayFullDayPriceOnWeekend" /> Cuối tuần cùng giá</label><label v-if="!room.useWeekdayFullDayPriceOnWeekend">Combo cuối tuần <input type="number" min="0" step="1000" v-model.number="room.weekendFullDayPrice" /></label></div>
            <div class="table-wrap"><table class="data-table compact"><thead><tr><th>Ca</th><th>Thời gian</th><th>Giá ngày thường</th><th>Dùng cùng giá cuối tuần</th><th>Giá cuối tuần</th></tr></thead><tbody><tr v-for="rate in room.rates.filter(x => x.type !== 2)" v-bind:key="rate.id"><td><strong>{{ rate.name }}</strong></td><td>{{ rate.startTime }}–{{ rate.endTime }}</td><td><input type="number" min="0" step="1000" v-model.number="rate.price" /></td><td><input type="checkbox" v-model="rate.useWeekdayPriceOnWeekend" /></td><td><input type="number" min="0" step="1000" v-model.number="rate.weekendPrice" v-bind:disabled="rate.useWeekdayPriceOnWeekend" v-bind:placeholder="rate.useWeekdayPriceOnWeekend ? 'Theo ngày thường' : 'Nhập giá'" /></td></tr></tbody></table></div>
        </div>
    </section>

    <section v-if="tab === 'rules'" class="panel pricing-panel">
        <div class="pricing-form-grid"><label class="check full"><input type="checkbox" v-model="settings.threeSlotDiscountEnabled" /> Bật giảm giá khi chọn đủ số ca liên tục</label><label>Số ca áp dụng<input type="number" min="2" max="20" v-model.number="settings.threeSlotCount" /></label><label>Mức giảm (%)<input type="number" min="0" max="100" step="0.01" v-model.number="settings.threeSlotDiscountPercent" /></label><div class="full"><strong>Ngày cuối tuần</strong><div class="week-days"><label v-for="day in weekDays"><input type="checkbox" v-bind:checked="isWeekend(day.value)" v-on:change="toggleWeekend(day.value)" /> {{ day.label }}</label></div></div></div>
        <div class="panel-actions"><button v-if="canManage" class="btn btn-primary" v-on:click="saveSettings" v-bind:disabled="saving">Lưu quy tắc</button></div>
    </section>

    <section v-if="tab === 'special'" class="panel pricing-panel">
        <div class="entity-toolbar"><div><strong>Ngày lễ / sự kiện</strong><div class="tiny muted">Không cho phép hai khoảng ngày đang bật giao nhau.</div></div><button v-if="canManage" class="btn btn-primary" v-on:click="openDay()">Thêm ngày đặc biệt</button></div>
        <div class="table-wrap"><table class="data-table"><thead><tr><th>Tên</th><th>Ngày áp dụng</th><th>Nền giá</th><th>Phụ thu</th><th>Quyền đặt</th><th>Trạng thái</th><th></th></tr></thead><tbody><tr v-for="day in specialDays" v-bind:key="day.id"><td><strong>{{ day.name }}</strong><div class="tiny muted">{{ categoryText(day.category) }}</div></td><td>{{ formatDate(day.startDate) }}<span v-if="day.endDate !== day.startDate"> – {{ formatDate(day.endDate) }}</span></td><td>{{ profileText(day.basePriceProfile) }}</td><td><strong>{{ day.surchargePercent }}%</strong></td><td>{{ Number(day.bookingMode) === 1 ? 'Chỉ combo cả ngày' : (day.allowThreeSlotCombo ? 'Ca lẻ + combo 3 ca' : 'Ca lẻ, không combo 3 ca') }}</td><td><span class="pill" v-bind:class="day.isActive ? 'success' : 'warning'">{{ day.isActive ? 'Đang bật' : 'Tạm tắt' }}</span></td><td><button v-if="canManage" class="btn btn-light btn-sm" v-on:click="openDay(day)">Sửa</button></td></tr><tr v-if="specialDays.length===0"><td colspan="7" class="empty-state"><strong>Chưa có ngày đặc biệt</strong></td></tr></tbody></table></div>
    </section>

    <div class="modal-backdrop" v-if="editor.open" v-on:click.self="editor.open=false"><section class="modal-card pricing-editor"><div class="modal-head"><div><div class="page-eyebrow">Cấu hình ngày</div><h2>{{ editor.id ? 'Sửa ngày đặc biệt' : 'Thêm ngày đặc biệt' }}</h2></div><button class="icon-btn" v-on:click="editor.open=false">×</button></div><div class="pricing-form-grid"><label>Từ ngày<input ref="startDatePicker" type="text" v-model="editor.form.startDate" placeholder="dd/MM/yyyy" autocomplete="off" /></label><label>Đến ngày<input ref="endDatePicker" type="text" v-model="editor.form.endDate" placeholder="dd/MM/yyyy" autocomplete="off" /></label><label class="full">Tên ngày / sự kiện<input maxlength="200" v-model.trim="editor.form.name" placeholder="Valentine, Lễ 30/4..." /></label><label>Loại ngày<select v-model.number="editor.form.category"><option v-bind:value="0">Ngày đặc biệt</option><option v-bind:value="1">Ngày lễ</option><option v-bind:value="2">Ngày lễ trọng đại</option></select></label><label>Bảng giá nền<select v-model.number="editor.form.basePriceProfile"><option v-bind:value="0">Tự động theo thứ</option><option v-bind:value="1">Giá ngày thường</option><option v-bind:value="2">Giá cuối tuần</option></select></label><label>Phụ thu (%)<input type="number" min="0" max="100" step="0.01" v-model.number="editor.form.surchargePercent" /></label><label>Chế độ đặt<select v-model.number="editor.form.bookingMode"><option v-bind:value="0">Cho đặt ca lẻ</option><option v-bind:value="1">Chỉ combo cả ngày</option></select></label><label class="check"><input type="checkbox" v-model="editor.form.allowThreeSlotCombo" v-bind:disabled="editor.form.bookingMode===1" /> Cho combo 3 ca</label><label class="check"><input type="checkbox" v-model="editor.form.isActive" /> Đang áp dụng</label><label class="full">Ghi chú<textarea maxlength="1000" v-model.trim="editor.form.note"></textarea></label></div><div v-if="editor.error" class="notice danger">{{ editor.error }}</div><div class="modal-actions"><button v-if="editor.id" class="btn btn-danger" v-on:click="archiveDay">Xóa</button><button class="btn btn-light" v-on:click="editor.open=false">Hủy</button><button class="btn btn-primary" v-on:click="saveDay" v-bind:disabled="saving">Lưu</button></div></section></div>
    <div class="toast" v-if="toast.show" v-bind:class="toast.type">{{ toast.message }}</div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/vn.js"></script>
    <script src="~/js/pages/admin-pricing.js" asp-append-version="true"></script>
}
