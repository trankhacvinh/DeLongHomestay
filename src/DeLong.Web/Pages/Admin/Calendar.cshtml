@page
@model DeLong.Web.Pages.Admin.CalendarModel
@{
    ViewData["Title"] = "Lịch phòng";
}
@section Head {
    <link rel="stylesheet" href="~/css/calendar-v2-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/calendar-drag-drop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-booking-guest-details.css" asp-append-version="true" />
}
<div id="calendar-page" v-cloak>
    <script id="calendar-page-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>

    <div class="calendar-page-head">
        <div class="page-title-row">
            <div>
                <div class="page-eyebrow">Vận hành phòng</div>
                <h1>Lịch phòng</h1>
                <p>Giữ phòng, đã xác nhận và đang ở hiển thị theo thời gian chiếm phòng. Yêu cầu chỉ hiện tại ngày bắt đầu; lượt đã kết thúc được lưu ở màn Đặt phòng.</p>
            </div>
            <div class="calendar-controls">
                <button class="btn-icon" type="button" v-on:click="moveRange(-7)" title="7 ngày trước" aria-label="7 ngày trước"><svg><use href="#i-chevron-left" /></svg></button>
                <button class="btn btn-light btn-sm" type="button" v-on:click="goToday">Hôm nay</button>
                <button class="btn-icon" type="button" v-on:click="moveRange(7)" title="7 ngày sau" aria-label="7 ngày sau"><svg><use href="#i-chevron-right" /></svg></button>
                @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff"))
                {
                    <button class="btn btn-primary btn-sm" type="button" v-on:click="openCreate()"><svg><use href="#i-plus" /></svg>Đặt phòng</button>
                }
            </div>
        </div>
    </div>

    <div class="calendar-toolbar-card">
        <div class="calendar-range">
            <strong>{{ rangeLabel }}</strong>
            <span>{{ activeRooms.length }} phòng đang hoạt động · múi giờ {{ timeZoneId }}</span>
        </div>
        <div class="calendar-legend" aria-label="Chú thích trạng thái đặt phòng">
            <span class="calendar-drag-help" v-if="dragEnabled">Kéo thẻ để đổi ngày / phòng</span>
            <span class="legend-item"><i class="legend-dot requested"></i>Yêu cầu</span>
            <span class="legend-item"><i class="legend-dot held"></i>Giữ phòng</span>
            <span class="legend-item"><i class="legend-dot confirmed"></i>Đã xác nhận</span>
            <span class="legend-item"><i class="legend-dot checkedin"></i>Đang ở</span>
        </div>
    </div>

    <div class="calendar-wrap">
        <table class="booking-calendar">
            <thead>
                <tr>
                    <th><span class="tiny muted">PHÒNG</span></th>
                    <th v-for="day in days" v-bind:key="day.key" v-bind:class="{ 'calendar-today': day.key === today }">
                        <div class="day-header" v-bind:class="{ today: day.key === today }">
                            <span class="weekday">{{ day.weekday }}</span>
                            <strong>{{ day.label }}</strong>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="room in activeRooms" v-bind:key="room.id">
                    <th>
                        <div class="room-row-title">
                            <div>
                                <strong>{{ room.name }}</strong>
                                <div class="room-meta">{{ room.code }} · {{ room.capacity }} người</div>
                                <span v-if="room.housekeepingStatus === 1" class="room-state dirty">Phòng bẩn</span>
                                <span v-else-if="room.housekeepingStatus === 2" class="room-state cleaning">Đang dọn</span>
                                <span v-else class="room-state">Sẵn sàng</span>
                            </div>
                        </div>
                    </th>
                    <td v-for="day in days"
                        v-bind:key="room.id + '-' + day.key"
                        class="day-cell"
                        v-bind:class="{
                            'calendar-today': day.key === today,
                            'calendar-drop-target': drag.overKey === dragKey(room.id, day.key)
                        }"
                        v-on:click="openCreate(room, day)"
                        v-on:dragover="dragOverCell(room, day, $event)"
                        v-on:dragleave="dragLeaveCell(room, day, $event)"
                        v-on:drop.stop.prevent="dropBooking(room, day, $event)">
                        <button v-for="booking in bookingsToRender(room.id, day.key)"
                                v-bind:key="booking.id"
                                type="button"
                                class="booking-chip"
                                v-bind:draggable="canDragBooking(booking)"
                                v-bind:title="canDragBooking(booking) ? 'Kéo để đổi ngày hoặc phòng' : null"
                                v-bind:class="[
                                    bookingClass(booking.status),
                                    {
                                        'booking-draggable': canDragBooking(booking),
                                        'booking-multiday': booking.type === 1 && booking.status !== 0,
                                        'booking-requested-stay': booking.type === 1 && booking.status === 0,
                                        'booking-checkedin': booking.status === 3,
                                        'booking-continues-before': booking.type === 1 && booking.status !== 0 && localDateKey(booking.checkInUtc) < startDate,
                                        'booking-continues-after': booking.type === 1 && booking.status !== 0 && localDateKey(booking.checkOutUtc) > days[days.length - 1].key
                                    }
                                ]"
                                v-bind:style="booking.type === 1 && booking.status !== 0 ? { '--booking-span': bookingSpan(booking, day.key) } : null"
                                v-on:click.stop="openBooking(booking)"
                                v-on:dragstart.stop="startBookingDrag(booking, $event)"
                                v-on:dragend="endBookingDrag($event)">
                            <template v-if="booking.type === 1">
                                <strong class="booking-customer">{{ booking.customerName }}</strong>
                                <span class="booking-time" v-if="booking.status === 0">Yêu cầu {{ booking.nightCount || '?' }} đêm · {{ shortDateText(booking.checkInUtc) }} → {{ shortDateText(booking.checkOutUtc) }}</span>
                                <span class="booking-time" v-else>
                                    {{ booking.nightCount || '?' }} đêm ·
                                    {{ localDateKey(booking.checkInUtc) < startDate ? 'tiếp' : shortDateText(booking.checkInUtc) }}
                                    →
                                    {{ localDateKey(booking.checkOutUtc) > days[days.length - 1].key ? 'tiếp' : shortDateText(booking.checkOutUtc) }}
                                </span>
                            </template>
                            <template v-else>
                                <span class="booking-time">{{ timeRange(booking) }}</span>
                                <strong class="booking-customer">{{ booking.customerName }}</strong>
                            </template>
                            <span class="booking-meta"><span>{{ money(booking.totalAmount) }}</span><span class="booking-status-label">{{ statusText(booking.status) }}</span></span>
                            <span class="booking-drag-handle" v-if="canDragBooking(booking)" aria-hidden="true"></span>
                        </button>
                        <span v-if="!cellHasBooking(room.id, day.key)" class="empty-cell-action"><svg><use href="#i-plus" /></svg>Đặt phòng</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="modal-backdrop modal-top" v-if="moveConfirm.open" v-on:click.self="closeMoveConfirm">
        <section class="modal-card modal-small calendar-move-card" role="dialog" aria-modal="true" aria-labelledby="calendar-move-title">
            <div class="modal-head">
                <div>
                    <div class="calendar-move-kicker">Điều phối lịch phòng</div>
                    <h2 id="calendar-move-title">Chuyển lượt đặt?</h2>
                    <p class="small muted">{{ moveConfirm.booking?.code }} · {{ moveConfirm.booking?.customerName }}</p>
                </div>
                <button class="icon-btn" type="button" v-on:click="closeMoveConfirm" aria-label="Đóng">×</button>
            </div>
            <div class="calendar-move-body" v-if="moveConfirm.booking && moveConfirm.room && moveConfirm.day">
                <div class="calendar-move-route">
                    <div class="calendar-move-stop">
                        <span>Từ</span>
                        <strong>{{ moveConfirm.booking.roomName }}</strong>
                        <small>{{ dateKeyText(localDateKey(moveConfirm.booking.checkInUtc)) }} · {{ timeText(moveConfirm.booking.checkInUtc) }}</small>
                    </div>
                    <svg class="calendar-move-arrow" aria-hidden="true"><use href="#i-chevron-right" /></svg>
                    <div class="calendar-move-stop target">
                        <span>Đến</span>
                        <strong>{{ moveConfirm.room.name }}</strong>
                        <small>{{ dateKeyText(moveConfirm.day.key) }}</small>
                    </div>
                </div>
                <div class="calendar-move-note" v-if="moveConfirm.booking.type === 1 && moveConfirm.booking.roomId !== moveConfirm.room.id">
                    <strong>{{ moveConfirm.booking.nightCount }} đêm và giá đã thỏa thuận được giữ nguyên.</strong>
                    Giờ nhận/trả sẽ theo mức “Lưu trú theo đêm” của phòng mới.
                </div>
                <div class="calendar-move-note" v-else>
                    <strong>Giờ, giá và công nợ hiện tại được giữ nguyên.</strong>
                    Hệ thống chỉ đổi ngày/phòng và sẽ kiểm tra trùng trước khi lưu.
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-light" type="button" v-bind:disabled="saving" v-on:click="closeMoveConfirm">Hủy</button>
                <button class="btn btn-primary" type="button" v-bind:disabled="saving" v-on:click="confirmBookingMove">{{ saving ? 'Đang kiểm tra...' : 'Xác nhận chuyển' }}</button>
            </div>
        </section>
    </div>

    <div class="modal-backdrop" v-if="editor.open" v-on:click.self="closeEditor">
        <section class="modal-card booking-editor" role="dialog" aria-modal="true">
            <div class="modal-head">
                <div>
                    <h2>{{ editor.mode === 'view' ? 'Chi tiết lượt đặt' : (editor.mode === 'edit' ? 'Sửa lượt đặt' : 'Đặt phòng') }}</h2>
                    <p class="muted small" v-if="editor.mode === 'create'">Chọn mức giá để điền nhanh giờ/giá; bạn vẫn có thể nhập thời gian linh hoạt.</p>
                    <p class="muted small" v-else>{{ selectedBooking?.code }}</p>
                </div>
                <button class="icon-btn" type="button" v-on:click="closeEditor" aria-label="Đóng">×</button>
            </div>

            <template v-if="editor.mode === 'create' || editor.mode === 'edit'">
                <section class="booking-form-section">
                    <div class="booking-form-title">Phòng & thời gian <span>Thời gian thực tế quyết định phòng có bận hay không</span></div>
                    <div class="form-grid">
                        <div class="field">
                            <label>Phòng *</label>
                            <select v-model="form.roomId" v-on:change="roomChanged">
                                <option value="">Chọn phòng</option>
                                <option v-for="room in activeRooms" v-bind:key="room.id" v-bind:value="room.id">{{ room.name }}</option>
                            </select>
                        </div>
                        <div class="field">
                            <label>Mức giá</label>
                            <select v-model="form.rateId" v-on:change="applyRate">
                                <option value="">Tùy chỉnh giờ/giá</option>
                                <option v-for="rate in selectedRoomRates" v-bind:key="rate.id" v-bind:value="rate.id">{{ rate.name }} · {{ rate.startTime }}–{{ rate.endTime }} · {{ money(rate.price) }}<template v-if="rate.type === 2">/đêm</template></option>
                            </select>
                        </div>
                        <div class="field"><label>Nhận phòng *</label><input type="datetime-local" v-model="form.checkInLocal" /></div>
                        <div class="field"><label>Trả phòng *</label><input type="datetime-local" v-model="form.checkOutLocal" /></div>
                    </div>
                </section>

                <section class="booking-form-section">
                    <div class="booking-form-title">Khách hàng <span>SĐT dùng để nhận diện khách cũ</span></div>
                    <div class="form-grid">
                        <div class="field"><label>Tên khách *</label><input v-model.trim="form.customerName" maxlength="200" placeholder="Ví dụ: Nguyễn Minh Anh" /></div>
                        <div class="field"><label>Số điện thoại *</label><input v-model.trim="form.customerPhone" maxlength="30" inputmode="tel" placeholder="09xx xxx xxx" /></div>
                        <div class="field"><label>Email</label><input v-model.trim="form.customerEmail" type="email" maxlength="254" autocomplete="email" placeholder="ten@email.com" /></div>
                        <div class="field"><label>Số lượng khách *</label><input v-model.number="form.guestCount" type="number" min="1" v-bind:max="selectedRoom?.capacity || 1" /></div>
                        <div class="field">
                            <label>Nguồn</label>
                            <select v-model="form.source">
                                <option value="">Không xác định</option>
                                <option>Facebook</option><option>Zalo</option><option>Điện thoại</option><option>Khách quen</option><option>Walk-in</option><option>Khác</option>
                            </select>
                        </div>
                        <div class="field">
                            <label>Trạng thái</label>
                            <select v-if="editor.mode === 'create'" v-model.number="form.status">
                                <option v-bind:value="1">Giữ phòng</option>
                                <option v-bind:value="2">Đã xác nhận</option>
                                <option v-bind:value="0">Yêu cầu</option>
                            </select>
                            <input v-else v-bind:value="statusText(selectedBooking?.status)" disabled />
                        </div>
                    </div>
                    <div class="admin-booking-identity-editor">
                        <div class="admin-booking-identity-editor-head"><div><strong>CCCD / giấy tờ tùy thân</strong><small>Ảnh được mã hóa trong kho riêng. Nhân viên có thể để trống.</small></div><span>Không bắt buộc</span></div>
                        <div class="admin-booking-id-grid">
                            <label class="admin-booking-id-card"><span class="admin-booking-id-picker"><img v-if="identityPreview('front')" v-bind:src="identityPreview('front')" alt="CCCD mặt trước" /><span v-else class="admin-booking-id-empty"><b>Mặt trước</b><small>Chọn ảnh nếu có</small></span></span><input type="file" accept="image/jpeg,image/png,image/webp" hidden v-on:change="selectIdentity('front', $event)" /></label>
                            <label class="admin-booking-id-card"><span class="admin-booking-id-picker"><img v-if="identityPreview('back')" v-bind:src="identityPreview('back')" alt="CCCD mặt sau" /><span v-else class="admin-booking-id-empty"><b>Mặt sau</b><small>Chọn ảnh nếu có</small></span></span><input type="file" accept="image/jpeg,image/png,image/webp" hidden v-on:change="selectIdentity('back', $event)" /></label>
                        </div>
                    </div>
                </section>

                <section class="booking-form-section">
                    <div class="booking-form-title">Chi phí & ghi chú</div>
                    <div class="booking-money-grid">
                        <div class="field"><label>Giá phòng</label><input type="number" min="0" step="1000" v-model.number="form.roomAmount" /></div>
                        <div class="field"><label>Phụ thu</label><input type="number" min="0" step="1000" v-model.number="form.extraAmount" /></div>
                        <div class="field"><label>Giảm giá</label><input type="number" min="0" step="1000" v-model.number="form.discountAmount" /></div>
                    </div>
                    <div class="field mt-16"><label>Ghi chú</label><textarea v-model.trim="form.note" maxlength="2000" placeholder="Ví dụ: nhận phòng 22:30, thêm gối, khách cần hóa đơn..."></textarea></div>
                </section>

                <div class="summary-box"><div class="summary-line"><span>Tổng lượt đặt</span><strong>{{ money(totalAmount) }}</strong></div></div>
                <div class="modal-actions">
                    <button class="btn btn-light" type="button" v-on:click="closeEditor">Hủy</button>
                    <button class="btn btn-primary" type="button" v-bind:disabled="saving" v-on:click="saveBooking">{{ saving ? 'Đang lưu...' : (editor.mode === 'edit' ? 'Lưu thay đổi' : 'Lưu lượt đặt') }}</button>
                </div>
            </template>

            <template v-else-if="selectedBooking">
                <div class="booking-detail-hero">
                    <div><span>Khách hàng</span><strong>{{ selectedBooking.customerName }}</strong><span>{{ selectedBooking.customerPhone }} · {{ selectedBooking.roomName }}</span></div>
                    <span class="pill" v-bind:class="statusText(selectedBooking.status).includes('xác nhận') || selectedBooking.status === 3 ? 'success' : ''">{{ statusText(selectedBooking.status) }}</span>
                </div>
                <section class="admin-booking-detail-panel">
                    <div class="admin-booking-detail-head"><div><strong>Thông tin người đặt</strong><small>Email, số khách và giấy tờ khách đã cung cấp</small></div></div>
                    <div v-if="guestDetails.loading" class="admin-booking-details-loading">Đang tải email, số khách và CCCD…</div>
                    <div v-else-if="guestDetails.error" class="admin-booking-details-error"><strong>Không tải được thông tin người đặt.</strong><span>{{ guestDetails.error }}</span></div>
                    <template v-else>
                        <div class="admin-booking-guest-grid">
                            <div><span>Email</span><strong>{{ guestDetails.customerEmail || 'Không cung cấp' }}</strong></div>
                            <div><span>Số khách</span><strong>{{ guestDetails.guestCount || 1 }} khách</strong></div>
                        </div>
                        <div class="admin-booking-id-title"><strong>CCCD / giấy tờ tùy thân</strong><span>{{ guestDetails.documents.length }}/2 ảnh</span></div>
                        <div class="admin-booking-detail-id-grid">
                            <div class="admin-booking-detail-id" v-for="side in ['front', 'back']" v-bind:key="side"><strong>{{ side === 'front' ? 'Mặt trước' : 'Mặt sau' }}</strong><a v-if="hasIdentity(side)" v-bind:href="identityUrl(selectedBooking.id, side)" target="_blank" rel="noopener"><img v-bind:src="identityUrl(selectedBooking.id, side)" v-bind:alt="side === 'front' ? 'CCCD mặt trước' : 'CCCD mặt sau'" /></a><span v-else class="empty">Chưa có ảnh</span></div>
                        </div>
                    </template>
                </section>
                <div class="detail-list">
                    <div><span>Kiểu đặt</span><strong>{{ selectedBooking.type === 1 ? 'Lưu trú theo đêm' : 'Theo giờ thực tế' }}</strong></div>
                    <div v-if="selectedBooking.type === 1"><span>Giá lưu trú</span><strong>{{ selectedBooking.nightCount }} đêm × {{ money(selectedBooking.unitPrice) }}</strong></div>
                    <div v-if="selectedBooking.rateName"><span>Mức giá</span><strong>{{ selectedBooking.rateName }}</strong></div>
                    <div><span>Thời gian</span><strong>{{ dateTimeText(selectedBooking.checkInUtc) }} → {{ dateTimeText(selectedBooking.checkOutUtc) }}</strong></div>
                    <div><span>Tổng lượt đặt</span><strong>{{ money(selectedBooking.totalAmount) }}</strong></div>
                    <div><span>Đã thanh toán</span><strong class="text-success">{{ money(selectedBooking.paidAmount) }}</strong></div>
                    <div><span>Còn lại</span><strong v-bind:class="selectedBooking.balanceAmount > 0 ? 'text-danger' : 'text-success'">{{ money(selectedBooking.balanceAmount) }}</strong></div>
                    <div v-if="selectedBooking.note"><span>Ghi chú</span><strong>{{ selectedBooking.note }}</strong></div>
                </div>
                <div class="notice" v-if="selectedBooking.type === 1 && canManage">Lưu trú theo đêm có thể sửa trực tiếp tại đây; đổi ngày nhận/trả sẽ tự tính lại số đêm và tiền phòng theo mức giá đã chọn.</div>
                <div class="modal-actions" v-if="canManage">
                    <button v-if="canEditBooking(selectedBooking)" class="btn btn-light" type="button" v-on:click="openEditBooking(selectedBooking)">Sửa lượt đặt</button>
                    <button v-for="action in nextActions(selectedBooking)" v-bind:key="action.status" type="button" class="btn" v-bind:class="action.className" v-bind:disabled="saving" v-on:click="changeStatus(action.status)">{{ action.label }}</button>
                </div>
            </template>
        </section>
    </div>

    <div class="toast" v-if="toast.show" v-bind:class="toast.type">{{ toast.message }}</div>
</div>

@section Scripts {
    <script>window.DeLongCalendarCanManage = @(User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff") ? "true" : "false");</script>
    <script src="~/js/pages/admin-calendar-nightly.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin-calendar.js" asp-append-version="true"></script>
}
