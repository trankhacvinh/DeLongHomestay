@page
@model DeLong.Web.Pages.Admin.Bookings.IndexModel
@{
    ViewData["Title"] = "Booking";
}
<div id="bookings-page" v-cloak>
    <script id="bookings-page-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>

    <div class="page-title-row">
        <div><h1>Booking</h1><p>Tra cứu, trạng thái và thanh toán; tạo booking mới từ Lịch phòng.</p></div>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff"))
        {
            <a class="btn btn-primary" asp-page="/Admin/Calendar">+ Đặt phòng</a>
        }
    </div>

    <section class="panel">
        <div class="panel-head">
            <div class="toolbar">
                <input class="search-input" v-model.trim="search" placeholder="Mã, khách, SĐT, phòng..." />
                <select class="filter-select" v-model="statusFilter">
                    <option value="">Tất cả trạng thái</option>
                    <option value="0">Yêu cầu</option><option value="1">Giữ phòng</option><option value="2">Đã xác nhận</option>
                    <option value="3">Đang ở</option><option value="4">Hoàn tất</option><option value="5">Đã hủy</option><option value="6">No-show</option>
                </select>
            </div>
            <span class="small muted">{{ filteredBookings.length }} booking</span>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Mã</th><th>Khách</th><th>Phòng</th><th>Thời gian</th><th>Trạng thái</th><th>Tổng</th><th>Còn lại</th><th></th></tr></thead>
                <tbody>
                    <tr v-for="booking in filteredBookings" v-bind:key="booking.id">
                        <td><strong>{{ booking.code }}</strong><div class="tiny muted">{{ booking.source || '—' }}</div></td>
                        <td><strong>{{ booking.customerName }}</strong><div class="tiny muted">{{ booking.customerPhone }}</div></td>
                        <td>{{ booking.roomName }}</td>
                        <td>{{ dateTimeText(booking.checkInUtc) }}<div class="tiny muted">→ {{ dateTimeText(booking.checkOutUtc) }}</div></td>
                        <td><span class="pill" v-bind:class="statusClass(booking.status)">{{ statusText(booking.status) }}</span></td>
                        <td><strong>{{ money(booking.totalAmount) }}</strong><div class="tiny muted">Đã thu {{ money(booking.paidAmount) }}</div></td>
                        <td><strong v-bind:class="{ 'text-success': booking.balanceAmount <= 0, 'text-danger': booking.balanceAmount > 0 }">{{ money(booking.balanceAmount) }}</strong></td>
                        <td><button class="btn btn-light btn-sm" type="button" v-on:click="openBooking(booking)">Xem</button></td>
                    </tr>
                    <tr v-if="filteredBookings.length === 0"><td colspan="8" class="empty-state">Không có booking phù hợp.</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="modal-backdrop" v-if="detail.open" v-on:click.self="closeDetail">
        <section class="modal-card booking-editor" role="dialog" aria-modal="true" v-if="selectedBooking">
            <div class="modal-head">
                <div><h2>{{ selectedBooking.code }}</h2><p class="small muted">{{ statusText(selectedBooking.status) }}</p></div>
                <button class="icon-btn" type="button" v-on:click="closeDetail">×</button>
            </div>
            <div class="detail-list">
                <div><span>Khách</span><strong>{{ selectedBooking.customerName }} · {{ selectedBooking.customerPhone }}</strong></div>
                <div><span>Phòng</span><strong>{{ selectedBooking.roomName }}</strong></div>
                <div><span>Thời gian</span><strong>{{ dateTimeText(selectedBooking.checkInUtc) }} → {{ dateTimeText(selectedBooking.checkOutUtc) }}</strong></div>
                <div><span>Tổng booking</span><strong>{{ money(selectedBooking.totalAmount) }}</strong></div>
                <div><span>Đã thanh toán</span><strong class="text-success">{{ money(selectedBooking.paidAmount) }}</strong></div>
                <div><span>Còn lại</span><strong v-bind:class="selectedBooking.balanceAmount > 0 ? 'text-danger' : 'text-success'">{{ money(selectedBooking.balanceAmount) }}</strong></div>
                <div v-if="selectedBooking.note"><span>Ghi chú</span><strong>{{ selectedBooking.note }}</strong></div>
            </div>

            <div class="panel mt-16">
                <div class="panel-head">
                    <h3>Thanh toán</h3>
                    <button v-if="canManage" class="btn btn-primary btn-sm" type="button" v-on:click="openPayment">+ Ghi nhận</button>
                </div>
                <div class="panel-body">
                    <p v-if="loadingPayments" class="small muted">Đang tải giao dịch...</p>
                    <div v-else-if="payments.length" class="payment-list">
                        <div class="payment-row" v-for="payment in payments" v-bind:key="payment.id" v-bind:class="{ 'payment-voided': payment.isVoided }">
                            <div>
                                <strong v-bind:class="payment.type === 0 ? 'text-success' : 'text-danger'">{{ payment.type === 0 ? '+' : '-' }}{{ money(payment.amount) }}</strong>
                                <div class="tiny muted">{{ paymentMethodText(payment.method) }} · {{ dateTimeText(payment.occurredAtUtc) }}</div>
                                <div class="tiny" v-if="payment.reference">Tham chiếu: {{ payment.reference }}</div>
                                <div class="tiny muted" v-if="payment.isVoided">VOID · {{ payment.voidReason }}</div>
                            </div>
                            <button v-if="canManage && !payment.isVoided" class="btn btn-light btn-sm" type="button" v-on:click="openVoid(payment)">Void</button>
                        </div>
                    </div>
                    <p v-else class="small muted">Chưa có giao dịch thanh toán.</p>
                </div>
            </div>

            <div class="modal-actions" v-if="canManage && nextActions(selectedBooking).length">
                <button v-for="action in nextActions(selectedBooking)" v-bind:key="action.status" type="button" class="btn" v-bind:class="action.className" v-bind:disabled="saving" v-on:click="changeStatus(action.status)">{{ action.label }}</button>
            </div>
        </section>
    </div>

    <div class="modal-backdrop modal-top" v-if="paymentEditor.open" v-on:click.self="closePayment">
        <section class="modal-card" role="dialog" aria-modal="true">
            <div class="modal-head"><div><h2>Ghi nhận thanh toán</h2><p class="small muted">{{ selectedBooking?.code }}</p></div><button class="icon-btn" type="button" v-on:click="closePayment">×</button></div>
            <div class="form-grid">
                <div class="field"><label>Loại</label><select v-model.number="paymentForm.type"><option v-bind:value="0">Thu tiền / Cọc</option><option v-bind:value="1">Hoàn tiền</option></select></div>
                <div class="field"><label>Phương thức</label><select v-model.number="paymentForm.method"><option v-bind:value="1">Chuyển khoản</option><option v-bind:value="0">Tiền mặt</option><option v-bind:value="2">Thẻ</option><option v-bind:value="3">Khác</option></select></div>
                <div class="field"><label>Số tiền *</label><input type="number" min="1" step="1000" v-model.number="paymentForm.amount" /></div>
                <div class="field"><label>Mã/Tham chiếu</label><input v-model.trim="paymentForm.reference" maxlength="200" /></div>
                <div class="field full"><label>Ghi chú</label><textarea v-model.trim="paymentForm.note" maxlength="2000"></textarea></div>
            </div>
            <div class="modal-actions"><button class="btn btn-light" type="button" v-on:click="closePayment">Hủy</button><button class="btn btn-primary" type="button" v-bind:disabled="saving" v-on:click="savePayment">{{ saving ? 'Đang lưu...' : 'Ghi nhận' }}</button></div>
        </section>
    </div>

    <div class="modal-backdrop modal-top" v-if="voidEditor.open" v-on:click.self="closeVoid">
        <section class="modal-card" role="dialog" aria-modal="true">
            <div class="modal-head"><div><h2>Void giao dịch?</h2><p class="small muted">Giao dịch không bị xóa khỏi lịch sử.</p></div><button class="icon-btn" type="button" v-on:click="closeVoid">×</button></div>
            <div class="field"><label>Lý do *</label><textarea v-model.trim="voidEditor.reason" maxlength="1000" placeholder="Nhập sai số tiền, ghi nhận nhầm..."></textarea></div>
            <div class="modal-actions"><button class="btn btn-light" type="button" v-on:click="closeVoid">Hủy</button><button class="btn btn-danger" type="button" v-bind:disabled="saving" v-on:click="confirmVoid">Xác nhận void</button></div>
        </section>
    </div>

    <div class="toast" v-if="toast.show" v-bind:class="toast.type">{{ toast.message }}</div>
</div>
@section Scripts {
    <script>window.DeLongBookingsCanManage = @(User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff") ? "true" : "false");</script>
    <script src="~/js/pages/admin-bookings.js" asp-append-version="true"></script>
}
