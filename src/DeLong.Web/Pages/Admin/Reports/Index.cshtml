@page
@model DeLong.Web.Pages.Admin.Reports.IndexModel
@{
    ViewData["Title"] = "Báo cáo";
}
<div id="reports-page" v-cloak>
    <script id="reports-page-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>

    <div class="page-title-row">
        <div><h1>Báo cáo</h1><p>Tách giá trị booking, tiền thực thu và dòng tiền để tránh hiểu nhầm số liệu.</p></div>
        <div class="toolbar">
            <button class="btn btn-light btn-sm" type="button" v-on:click="moveMonth(-1)">← Tháng trước</button>
            <strong class="pill">{{ monthLabel }}</strong>
            <button class="btn btn-light btn-sm" type="button" v-on:click="moveMonth(1)">Tháng sau →</button>
        </div>
    </div>

    <div class="kpi-grid report-kpis">
        <div class="kpi"><div class="kpi-label">Booking</div><div class="kpi-value">{{ report.bookingCount }}</div><div class="kpi-note">{{ report.bookedHours }} giờ đã đặt</div></div>
        <div class="kpi"><div class="kpi-label">Giá trị booking</div><div class="kpi-value">{{ money(report.bookingValue) }}</div><div class="kpi-note">Theo check-in trong tháng</div></div>
        <div class="kpi"><div class="kpi-label">Tiền thực thu</div><div class="kpi-value text-success">{{ money(report.netReceipts) }}</div><div class="kpi-note">Thu trừ hoàn tiền</div></div>
        <div class="kpi"><div class="kpi-label">Chi phí</div><div class="kpi-value text-danger">{{ money(report.expenses) }}</div><div class="kpi-note">Chi phí hợp lệ trong tháng</div></div>
        <div class="kpi"><div class="kpi-label">Dòng tiền ròng</div><div class="kpi-value" v-bind:class="report.netCashFlow >= 0 ? 'text-success' : 'text-danger'">{{ money(report.netCashFlow) }}</div><div class="kpi-note">Thực thu - chi phí</div></div>
        <div class="kpi"><div class="kpi-label">Công nợ hiện tại</div><div class="kpi-value" v-bind:class="report.outstanding > 0 ? 'text-danger' : 'text-success'">{{ money(report.outstanding) }}</div><div class="kpi-note">Booking chưa hủy/no-show</div></div>
    </div>

    <section class="panel mt-16">
        <div class="panel-head"><h2>Dòng tiền 6 tháng</h2><span class="small muted">Tiền thực thu và chi phí theo tháng</span></div>
        <div class="panel-body">
            <div class="trend-chart">
                <div class="trend-column" v-for="item in report.trend" v-bind:key="item.month">
                    <div class="trend-bars">
                        <span class="trend-bar receipts" v-bind:style="{ height: barHeight(item.netReceipts) + '%' }" v-bind:title="money(item.netReceipts)"></span>
                        <span class="trend-bar expenses" v-bind:style="{ height: barHeight(item.expenses) + '%' }" v-bind:title="money(item.expenses)"></span>
                    </div>
                    <strong>{{ shortMonth(item.month) }}</strong>
                    <small v-bind:class="item.netCashFlow >= 0 ? 'text-success' : 'text-danger'">{{ compactMoney(item.netCashFlow) }}</small>
                </div>
            </div>
            <div class="chart-legend"><span><i class="legend-dot receipts"></i> Thực thu</span><span><i class="legend-dot expenses"></i> Chi phí</span></div>
        </div>
    </section>

    <div class="grid-2 mt-16 report-grid">
        <section class="panel">
            <div class="panel-head"><h2>Theo phòng</h2></div>
            <div class="panel-body report-list">
                <div class="report-row" v-for="room in report.byRoom" v-bind:key="room.roomName">
                    <div><strong>{{ room.roomName }}</strong><div class="tiny muted">{{ room.bookingCount }} booking · {{ room.bookedHours }} giờ</div></div>
                    <strong>{{ money(room.bookingValue) }}</strong>
                </div>
                <p v-if="report.byRoom.length === 0" class="empty-state">Chưa có booking.</p>
            </div>
        </section>
        <section class="panel">
            <div class="panel-head"><h2>Nguồn booking</h2></div>
            <div class="panel-body report-list">
                <div class="report-row" v-for="source in report.bySource" v-bind:key="source.source">
                    <div><strong>{{ source.source }}</strong><div class="tiny muted">{{ source.bookingCount }} booking</div></div>
                    <strong>{{ money(source.bookingValue) }}</strong>
                </div>
                <p v-if="report.bySource.length === 0" class="empty-state">Chưa có booking.</p>
            </div>
        </section>
    </div>
</div>
@section Scripts {
    <script src="~/js/pages/admin-reports.js" asp-append-version="true"></script>
}
