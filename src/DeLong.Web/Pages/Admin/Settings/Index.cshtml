@page
@model DeLong.Web.Pages.Admin.Settings.IndexModel
@{
    ViewData["Title"] = "Cấu hình";
}
<div id="settings-page" v-cloak>
    <script id="settings-page-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>

    <div class="page-title-row">
        <div>
            <div class="page-eyebrow">Hệ thống & giá</div>
            <h1>Cấu hình</h1>
            <p>Cấu hình thông báo đặt phòng, email SMTP và các mức giá của cơ sở.</p>
        </div>
        <div class="settings-title-actions">
            <button class="btn btn-light" type="button" data-quick-rate-open><svg><use href="#i-plus" /></svg>Tạo nhanh bộ khung giờ</button>
            <button class="btn btn-primary" type="button" v-on:click="openCreate"><svg><use href="#i-plus" /></svg>Thêm mức giá</button>
        </div>
    </div>

    <section class="panel notification-settings-panel">
        <div class="panel-head">
            <div>
                <h2>Thông báo đặt phòng</h2>
                <p class="small muted">Thông báo realtime trong trang quản trị và gửi email khi khách gửi yêu cầu đặt phòng từ website.</p>
            </div>
            <span class="pill success" v-if="notification.inAppBookingEnabled">Realtime</span>
        </div>
        <div class="panel-body">
            <div class="notification-settings-grid">
                <label class="check-row full"><input type="checkbox" v-model="notification.inAppBookingEnabled" /> Hiện thông báo realtime trong trang quản trị</label>
                <label class="check-row full"><input type="checkbox" v-model="notification.emailBookingEnabled" /> Gửi email khi có yêu cầu đặt phòng mới</label>
                <div class="field full"><label for="notification-recipients">Email nhận thông báo</label><textarea id="notification-recipients" rows="2" v-model.trim="notification.emailRecipients" placeholder="owner@example.com; staff@example.com"></textarea></div>
                <div class="field"><label for="smtp-host">SMTP host</label><input id="smtp-host" v-model.trim="notification.smtpHost" maxlength="300" autocomplete="off" placeholder="smtp.gmail.com" /></div>
                <div class="field"><label for="smtp-port">Port</label><input id="smtp-port" type="number" min="1" max="65535" v-model.number="notification.smtpPort" /></div>
                <label class="check-row full"><input type="checkbox" v-model="notification.smtpUseSsl" /> Bật SSL/TLS (STARTTLS với port 587)</label>
                <div class="field"><label for="smtp-user">SMTP username</label><input id="smtp-user" v-model.trim="notification.smtpUsername" maxlength="300" autocomplete="username" /></div>
                <div class="field"><label for="smtp-password">SMTP password</label><div class="notification-settings-secret"><input id="smtp-password" type="password" v-model="notification.smtpPassword" autocomplete="new-password" placeholder="Để trống để giữ password hiện tại" /><small>{{ notification.smtpPasswordConfigured ? 'Đã lưu mã hóa' : 'Chưa có' }}</small></div></div>
                <label v-if="notification.smtpPasswordConfigured" class="check-row full"><input type="checkbox" v-model="notification.clearSmtpPassword" /> Xóa SMTP password đang lưu</label>
                <div class="field"><label for="smtp-from-email">Email người gửi</label><input id="smtp-from-email" type="email" v-model.trim="notification.smtpFromEmail" maxlength="320" autocomplete="email" placeholder="booking@example.com" /></div>
                <div class="field"><label for="smtp-from-name">Tên người gửi</label><input id="smtp-from-name" v-model.trim="notification.smtpFromName" maxlength="240" placeholder="De Long Homestay" /></div>
            </div>
            <div class="notification-settings-status error" v-if="notification.lastEmailError"><strong>Lỗi email gần nhất:</strong><span>{{ notification.lastEmailError }}</span></div>
            <div class="notification-settings-status" v-else-if="notification.lastEmailSentAtUtc"><strong>Email hoạt động:</strong><span>Gửi thành công {{ notificationDate(notification.lastEmailSentAtUtc) }}</span></div>
            <div class="notification-settings-status" v-else><strong>SMTP:</strong><span>{{ notification.smtpHost && notification.smtpFromEmail ? 'Đã nhập cấu hình. Hãy gửi email thử để xác nhận.' : 'Chưa cấu hình đầy đủ.' }}</span></div>
            <div class="notification-settings-actions">
                <button class="btn btn-light" type="button" v-bind:disabled="testingEmail || savingNotifications" v-on:click="sendTestEmail">{{ testingEmail ? 'Đang gửi...' : 'Gửi email thử' }}</button>
                <button class="btn btn-primary" type="button" v-bind:disabled="savingNotifications || testingEmail" v-on:click="saveNotificationSettings">{{ savingNotifications ? 'Đang lưu...' : 'Lưu thông báo' }}</button>
            </div>
        </div>
    </section>

    <div class="settings-room-grid">
        <section class="panel settings-room" v-for="room in activeRooms" v-bind:key="room.id">
            <div class="panel-head">
                <div class="settings-room-title">
                    <span class="room-cell-icon" aria-hidden="true"><svg><use href="#i-bed" /></svg></span>
                    <div>
                        <h2>{{ room.name }}</h2>
                        <div class="tiny muted">{{ room.code }} · {{ room.capacity }} người · {{ sortedRates(room).length }} mức giá</div>
                    </div>
                </div>
                <button class="btn btn-light btn-sm" type="button" v-on:click="openCreate(room)"><svg><use href="#i-plus" /></svg>Mức giá</button>
            </div>
            <div class="panel-body">
                <div class="rate-settings-list" v-if="sortedRates(room).length">
                    <article class="rate-settings-row" v-for="rate in sortedRates(room)" v-bind:key="rate.id" v-bind:class="{ 'rate-inactive': !rate.isActive }">
                        <div class="rate-settings-main">
                            <div class="rate-settings-name">
                                <strong>{{ rate.name }}</strong>
                                <span v-if="rate.type === 1" class="pill">Qua đêm</span>
                                <span v-if="rate.type === 2" class="pill success">Theo đêm</span>
                                <span v-if="!rate.isActive" class="pill danger">Ngừng</span>
                            </div>
                            <div class="rate-settings-meta">
                                <template v-if="rate.type === 2">Nhận {{ rate.startTime }} · Trả {{ rate.endTime }} · {{ money(rate.price) }}/đêm</template>
                                <template v-else>{{ rate.startTime }} → {{ rate.endTime }} · Thứ tự {{ rate.sortOrder }}</template>
                            </div>
                        </div>
                        <div class="rate-settings-actions">
                            <strong v-if="rate.type !== 2">{{ money(rate.price) }}</strong>
                            <button class="btn btn-light btn-sm" type="button" v-on:click="openEdit(room, rate)">Sửa</button>
                            <button v-if="rate.isActive" class="btn btn-danger btn-sm" type="button" v-on:click="openArchive(room, rate)">Ngừng</button>
                        </div>
                    </article>
                </div>
                <div v-else class="empty-state"><strong>Chưa có mức giá</strong>Thêm giá theo khung giờ hoặc giá lưu trú theo đêm cho phòng này.</div>
            </div>
        </section>
    </div>

    <div class="modal-backdrop" v-if="editor.open" v-on:click.self="closeEditor">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="rate-editor-title">
            <div class="modal-head">
                <div>
                    <h2 id="rate-editor-title">{{ editor.mode === 'create' ? 'Thêm mức giá' : 'Sửa mức giá' }}</h2>
                    <p class="small muted" v-if="form.type === 2">Giá này dùng cho lưu trú nhiều ngày. Giờ bắt đầu là giờ nhận phòng; giờ kết thúc là giờ trả phòng ngày cuối.</p>
                    <p class="small muted" v-else>Khung giờ và qua đêm là các gói đặt nhanh trong một ngày.</p>
                </div>
                <button class="icon-btn" type="button" v-on:click="closeEditor" aria-label="Đóng">×</button>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label for="rate-room">Phòng *</label>
                    <select id="rate-room" v-model="form.roomId" v-bind:disabled="editor.mode === 'edit'">
                        <option value="">Chọn phòng</option>
                        <option v-for="room in activeRooms" v-bind:key="room.id" v-bind:value="room.id">{{ room.name }}</option>
                    </select>
                </div>
                <div class="field">
                    <label for="rate-type">Loại giá *</label>
                    <select id="rate-type" v-model.number="form.type" v-on:change="onTypeChanged">
                        <option v-bind:value="0">Khung giờ</option>
                        <option v-bind:value="1">Qua đêm</option>
                        <option v-bind:value="2">Lưu trú theo đêm</option>
                    </select>
                </div>
                <div class="field full"><label for="rate-name">Tên mức giá *</label><input id="rate-name" v-model.trim="form.name" maxlength="100" autocomplete="off" placeholder="Ví dụ: Lưu trú theo đêm" /></div>
                <div class="field"><label for="rate-start">{{ form.type === 2 ? 'Giờ nhận phòng *' : 'Bắt đầu *' }}</label><input id="rate-start" type="time" v-model="form.startTime" /></div>
                <div class="field"><label for="rate-end">{{ form.type === 2 ? 'Giờ trả phòng *' : 'Kết thúc *' }}</label><input id="rate-end" type="time" v-model="form.endTime" /></div>
                <div class="field"><label for="rate-price">{{ form.type === 2 ? 'Giá mỗi đêm *' : 'Giá *' }}</label><input id="rate-price" type="number" inputmode="numeric" min="0" step="1000" v-model.number="form.price" /></div>
                <div class="field"><label for="rate-sort">Thứ tự</label><input id="rate-sort" type="number" inputmode="numeric" min="0" max="999" v-model.number="form.sortOrder" /></div>
                <label v-if="editor.mode === 'edit'" class="check-row full"><input type="checkbox" v-model="form.isActive" /> Mức giá đang hoạt động</label>
            </div>
            <div class="notice mt-16" v-if="form.type === 2">Mỗi phòng chỉ có một giá lưu trú theo đêm đang hoạt động. Khách có thể chọn ngày nhận/trả; tổng tiền = giá/đêm × số đêm.</div>
            <div class="notice mt-16" v-else>Giá theo khung giờ chỉ giúp chọn nhanh. Nhân viên vẫn có thể sửa giờ nhận/trả thực tế của từng lượt đặt.</div>
            <div class="modal-actions">
                <button class="btn btn-light" type="button" v-on:click="closeEditor">Hủy</button>
                <button class="btn btn-primary" type="button" v-bind:disabled="saving" v-on:click="saveRate">{{ saving ? 'Đang lưu...' : 'Lưu mức giá' }}</button>
            </div>
        </section>
    </div>

    <div class="modal-backdrop modal-top" v-if="archiveEditor.open" v-on:click.self="closeArchive">
        <section class="modal-card modal-small" role="dialog" aria-modal="true" aria-labelledby="archive-rate-title">
            <div class="modal-head">
                <div><h2 id="archive-rate-title">Ngừng mức giá?</h2><p class="small muted">Mức giá sẽ không còn xuất hiện để đặt mới nhưng lịch sử không bị xóa.</p></div>
                <button class="icon-btn" type="button" v-on:click="closeArchive" aria-label="Đóng">×</button>
            </div>
            <p class="archive-copy" v-if="archiveEditor.rate"><strong>{{ archiveEditor.rate.name }}</strong> · {{ archiveEditor.room?.name }}</p>
            <div class="modal-actions">
                <button class="btn btn-light" type="button" v-on:click="closeArchive">Hủy</button>
                <button class="btn btn-danger" type="button" v-bind:disabled="saving" v-on:click="confirmArchive">Xác nhận ngừng</button>
            </div>
        </section>
    </div>

    <div class="toast" v-if="toast.show" v-bind:class="toast.type" aria-live="polite">{{ toast.message }}</div>
</div>
@section Scripts {
    <script src="~/js/pages/admin-settings.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin-settings-quick-rate.js" asp-append-version="true"></script>
}
