@page
@model DeLong.Web.Pages.Admin.Finance.IndexModel
@{
    ViewData["Title"] = "Thu chi";
}
<div id="finance-page" class="finance-page" v-cloak>
    <script id="finance-page-data" type="application/json">@Html.Raw(Model.PageDataJson)</script>

    <div class="page-title-row finance-page-head">
        <div>
            <div class="page-eyebrow">Tài chính vận hành</div>
            <h1>Thu chi</h1>
            <p>Theo dõi tiền khách đã trả, hoàn tiền, chi phí và công nợ theo từng cơ sở hoặc toàn bộ cơ sở được phân quyền.</p>
        </div>
        <div class="toolbar finance-toolbar" aria-label="Bộ lọc tài chính">
            <a class="btn btn-light finance-export-btn" v-bind:href="exportUrl" title="Xuất sổ thu chi đang xem ra Excel">Xuất Excel</a>
            <select class="property-scope-select" v-model="scope" v-on:change="changeScope" aria-label="Phạm vi cơ sở">
                <option v-if="properties.length > 1" value="all">Tất cả cơ sở</option>
                <option v-for="property in properties" v-bind:key="property.id" v-bind:value="property.id">{{ property.name }}</option>
            </select>
            <select class="finance-period-select" v-model="period" v-on:change="changePeriod" aria-label="Kỳ xem thu chi">
                <option value="day">Theo ngày</option>
                <option value="week">Theo tuần</option>
                <option value="month">Theo tháng</option>
                <option value="quarter">Theo quý</option>
            </select>
            <input class="finance-anchor-input" type="date" v-model="anchorDate" v-on:change="changeAnchor" aria-label="Chọn ngày làm mốc" />
            <button class="btn-icon" type="button" v-on:click="movePeriod(-1)" aria-label="Kỳ trước"><svg><use href="#i-chevron-left" /></svg></button>
            <div class="month-selector finance-period-label"><svg><use href="#i-calendar" /></svg><strong>{{ periodLabel }}</strong></div>
            <button class="btn-icon" type="button" v-on:click="movePeriod(1)" aria-label="Kỳ sau"><svg><use href="#i-chevron-right" /></svg></button>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <button v-if="canMutateScope" class="btn btn-primary" type="button" v-on:click="openExpense"><svg><use href="#i-plus" /></svg> Ghi chi phí</button>
            }
        </div>
    </div>

    <div v-if="canManage && !canMutateScope" class="scope-readonly-note">
        <strong>Đang xem {{ scopeName }} ở chế độ tổng hợp.</strong>
        <span>Để ghi hoặc void chi phí, hãy chuyển “cơ sở đang làm việc” trên thanh trên sang đúng cơ sở rồi mở lại Thu chi.</span>
    </div>

    <section class="finance-overview" v-bind:aria-label="'Tổng quan tài chính theo ' + periodName">
        <article class="finance-stat receipt">
            <div class="finance-stat-top"><span class="finance-stat-label">Thu khách</span><span class="finance-stat-icon"><svg><use href="#i-wallet" /></svg></span></div>
            <strong class="finance-stat-value text-success">{{ money(receipts) }}</strong>
            <span class="finance-stat-note">Receipt hợp lệ trong {{ periodName }} đang xem</span>
        </article>
        <article class="finance-stat refund">
            <div class="finance-stat-top"><span class="finance-stat-label">Hoàn tiền</span><span class="finance-stat-icon"><svg><use href="#i-wallet" /></svg></span></div>
            <strong class="finance-stat-value text-danger">{{ money(refunds) }}</strong>
            <span class="finance-stat-note">Refund hợp lệ trong {{ periodName }} đang xem</span>
        </article>
        <article class="finance-stat expense">
            <div class="finance-stat-top"><span class="finance-stat-label">Chi phí</span><span class="finance-stat-icon"><svg><use href="#i-chart" /></svg></span></div>
            <strong class="finance-stat-value text-danger">{{ money(expenseTotal) }}</strong>
            <span class="finance-stat-note">Không tính khoản đã void</span>
        </article>
        <article class="finance-stat net" v-bind:class="netCash < 0 ? 'negative' : ''">
            <div class="finance-stat-top"><span class="finance-stat-label">Dòng tiền ròng</span><span class="finance-stat-icon"><svg><use href="#i-chart" /></svg></span></div>
            <strong class="finance-stat-value" v-bind:class="netCash >= 0 ? 'text-success' : 'text-danger'">{{ money(netCash) }}</strong>
            <span class="finance-stat-note">Thu − hoàn − chi</span>
        </article>
    </section>

    <div class="finance-debt-strip" v-bind:class="{ 'has-debt': outstanding > 0 }">
        <div>
            <span>Công nợ booking hiện tại</span>
            <strong>{{ money(outstanding) }}</strong>
        </div>
        <p>Khoản khách còn phải thanh toán trong phạm vi {{ scopeName }}.</p>
        <a class="btn btn-light btn-sm" asp-page="/Admin/Bookings/Index" asp-route-propertyId="@Model.PropertyId">Mở booking cơ sở đang làm việc</a>
    </div>

    <section class="panel finance-combined-ledger">
        <div class="panel-head finance-panel-head finance-ledger-head">
            <div><h2>Sổ thu chi chi tiết</h2><span>Hợp nhất tiền thu, hoàn tiền và chi phí theo thời gian phát sinh</span></div>
            <div class="finance-ledger-tools">
                <strong v-bind:class="ledgerNet >= 0 ? 'text-success' : 'text-danger'">Ròng {{ money(ledgerNet) }}</strong>
                <select v-model="ledgerFilter" aria-label="Lọc sổ thu chi">
                    <option value="all">Tất cả ({{ ledgerEntries.length }})</option>
                    <option value="in">Tiền vào</option>
                    <option value="out">Tiền ra</option>
                    <option value="void">Đã void</option>
                </select>
            </div>
        </div>
        <div class="table-wrap finance-detail-table-wrap">
            <table class="data-table responsive-ledger finance-detail-table">
                <thead><tr><th>Thời gian</th><th>Loại</th><th>Nội dung</th><th>Cơ sở</th><th>Phương thức</th><th class="text-right">Thu</th><th class="text-right">Chi</th><th>Trạng thái</th></tr></thead>
                <tbody>
                    <tr v-for="entry in filteredLedgerEntries" v-bind:key="entry.id" v-bind:class="{ 'row-voided': entry.isVoided }">
                        <td data-label="Thời gian"><span class="ledger-date">{{ dateTimeText(entry.occurredAtUtc, entry.propertyId) }}</span></td>
                        <td data-label="Loại"><span class="ledger-type" v-bind:class="entry.kind">{{ entry.typeLabel }}</span></td>
                        <td data-label="Nội dung"><div class="ledger-primary"><strong>{{ entry.title }}</strong><span>{{ entry.description }}</span><small v-if="entry.reference">Ref: {{ entry.reference }}</small></div></td>
                        <td data-label="Cơ sở"><span class="ledger-method">{{ propertyLabel(entry.propertyId) }}</span></td>
                        <td data-label="Phương thức"><span class="ledger-method">{{ paymentMethodText(entry.method) }}</span></td>
                        <td data-label="Thu" class="text-right"><strong v-if="entry.receipt" class="ledger-amount text-success">+{{ money(entry.receipt) }}</strong><span v-else>—</span></td>
                        <td data-label="Chi" class="text-right"><strong v-if="entry.outflow" class="ledger-amount text-danger">−{{ money(entry.outflow) }}</strong><span v-else>—</span></td>
                        <td data-label="Trạng thái"><span v-if="entry.isVoided" class="void-badge">VOID</span><span v-else class="ledger-valid">Hợp lệ</span></td>
                    </tr>
                    <tr v-if="filteredLedgerEntries.length === 0" class="ledger-empty-row"><td colspan="8" class="empty-state"><strong>Không có dữ liệu phù hợp</strong>Hãy đổi bộ lọc hoặc kỳ đang xem.</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="finance-ledger-grid">
        <section class="panel finance-ledger-panel">
            <div class="panel-head finance-panel-head">
                <div><h2>Thanh toán booking</h2><span>Tiền vào / hoàn tiền từ khách</span></div>
                <span class="count-badge">{{ payments.length }} giao dịch</span>
            </div>
            <div class="table-wrap finance-table-wrap">
                <table class="data-table finance-table responsive-ledger" style="min-width:0;table-layout:fixed">
                    <thead><tr><th>Ngày</th><th>Booking / Khách</th><th>Phương thức</th><th class="text-right">Số tiền</th></tr></thead>
                    <tbody>
                        <tr v-for="payment in payments" v-bind:key="payment.id" v-bind:class="{ 'row-voided': payment.isVoided }">
                            <td data-label="Ngày"><span class="ledger-date">{{ dateTimeText(payment.occurredAtUtc, payment.propertyId) }}</span></td>
                            <td data-label="Booking"><div class="ledger-primary"><strong>{{ payment.bookingCode }}</strong><span>{{ payment.customerName }}</span><small v-if="properties.length > 1">{{ propertyLabel(payment.propertyId) }}</small></div></td>
                            <td data-label="Phương thức"><div class="ledger-primary"><strong>{{ paymentMethodText(payment.method) }}</strong><span v-if="payment.reference">{{ payment.reference }}</span></div></td>
                            <td data-label="Số tiền" class="text-right"><strong class="ledger-amount" v-bind:class="payment.type === 0 ? 'text-success' : 'text-danger'">{{ payment.type === 0 ? '+' : '−' }}{{ money(payment.amount) }}</strong><span v-if="payment.isVoided" class="void-badge">VOID</span></td>
                        </tr>
                        <tr v-if="payments.length === 0" class="ledger-empty-row"><td colspan="4" class="empty-state"><strong>Chưa có giao dịch</strong>Không có thanh toán booking trong {{ periodName }} đang xem.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel finance-ledger-panel">
            <div class="panel-head finance-panel-head">
                <div><h2>Chi phí vận hành</h2><span>Các khoản chi đã ghi nhận</span></div>
                <span class="count-badge">{{ expenses.length }} khoản</span>
            </div>
            <div class="table-wrap finance-table-wrap">
                <table class="data-table finance-table responsive-ledger expense-ledger" style="min-width:0;table-layout:fixed">
                    <thead><tr><th>Ngày</th><th>Nội dung</th><th>Phương thức</th><th class="text-right">Số tiền</th><th></th></tr></thead>
                    <tbody>
                        <tr v-for="expense in expenses" v-bind:key="expense.id" v-bind:class="{ 'row-voided': expense.isVoided }">
                            <td data-label="Ngày"><span class="ledger-date">{{ dateTimeText(expense.occurredAtUtc, expense.propertyId) }}</span></td>
                            <td data-label="Nội dung"><div class="ledger-primary"><strong>{{ expense.category }}</strong><span>{{ expense.description }}</span><small v-if="properties.length > 1">{{ propertyLabel(expense.propertyId) }}</small><small v-if="expense.vendor">{{ expense.vendor }}</small><small v-if="expense.isVoided">VOID · {{ expense.voidReason }}</small></div></td>
                            <td data-label="Phương thức"><strong class="ledger-method">{{ paymentMethodText(expense.method) }}</strong></td>
                            <td data-label="Số tiền" class="text-right"><strong class="ledger-amount text-danger">−{{ money(expense.amount) }}</strong></td>
                            <td data-label="Thao tác" class="ledger-action">
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <button v-if="canMutateScope && !expense.isVoided" class="btn btn-light btn-sm" type="button" v-on:click="openVoid(expense)">Void</button>
                                }
                            </td>
                        </tr>
                        <tr v-if="expenses.length === 0" class="ledger-empty-row"><td colspan="5" class="empty-state"><strong>Chưa có chi phí</strong>Không có khoản chi vận hành trong {{ periodName }} đang xem.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="modal-backdrop" v-if="expenseEditor.open" v-on:click.self="closeExpense">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="expense-modal-title">
            <div class="modal-head"><div><h2 id="expense-modal-title">Ghi chi phí</h2><p class="small muted">Khoản chi sau khi lưu chỉ có thể void, không xóa.</p></div><button class="icon-btn" type="button" v-on:click="closeExpense" aria-label="Đóng">×</button></div>
            <div class="form-grid">
                <div class="field"><label for="expense-category">Nhóm chi phí *</label><select id="expense-category" v-model="expenseForm.category"><option>Dọn phòng</option><option>Điện nước</option><option>Giặt ủi</option><option>Vật tư</option><option>Sửa chữa</option><option>Marketing</option><option>Phí nền tảng</option><option>Khác</option></select></div>
                <div class="field"><label for="expense-amount">Số tiền *</label><input id="expense-amount" type="number" min="1" step="1000" inputmode="numeric" v-model.number="expenseForm.amount" /></div>
                <div class="field full"><label for="expense-description">Nội dung *</label><input id="expense-description" v-model.trim="expenseForm.description" maxlength="500" placeholder="Ví dụ: mua vật tư vệ sinh" /></div>
                <div class="field"><label for="expense-method">Phương thức</label><select id="expense-method" v-model.number="expenseForm.method"><option v-bind:value="1">Chuyển khoản</option><option v-bind:value="0">Tiền mặt</option><option v-bind:value="2">Thẻ</option><option v-bind:value="3">Khác</option></select></div>
                <div class="field"><label for="expense-vendor">Nhà cung cấp</label><input id="expense-vendor" v-model.trim="expenseForm.vendor" maxlength="200" /></div>
                <div class="field"><label for="expense-reference">Tham chiếu</label><input id="expense-reference" v-model.trim="expenseForm.reference" maxlength="200" /></div>
                <div class="field full"><label for="expense-note">Ghi chú</label><textarea id="expense-note" v-model.trim="expenseForm.note" maxlength="2000"></textarea></div>
            </div>
            <div class="modal-actions"><button class="btn btn-light" type="button" v-on:click="closeExpense">Hủy</button><button class="btn btn-primary" type="button" v-bind:disabled="saving" v-on:click="saveExpense">{{ saving ? 'Đang lưu...' : 'Ghi chi phí' }}</button></div>
        </section>
    </div>

    <div class="modal-backdrop modal-top" v-if="voidEditor.open" v-on:click.self="closeVoid">
        <section class="modal-card modal-small" role="dialog" aria-modal="true" aria-labelledby="void-expense-title">
            <div class="modal-head"><div><h2 id="void-expense-title">Void khoản chi?</h2><p class="small muted">Lịch sử vẫn được giữ nguyên.</p></div><button class="icon-btn" type="button" v-on:click="closeVoid" aria-label="Đóng">×</button></div>
            <div class="modal-body-pad"><div class="field"><label for="void-reason">Lý do *</label><textarea id="void-reason" v-model.trim="voidEditor.reason" maxlength="1000" placeholder="Nhập lý do void khoản chi"></textarea></div></div>
            <div class="modal-actions"><button class="btn btn-light" type="button" v-on:click="closeVoid">Hủy</button><button class="btn btn-danger" type="button" v-bind:disabled="saving" v-on:click="confirmVoid">Xác nhận void</button></div>
        </section>
    </div>

    <div class="toast" v-if="toast.show" v-bind:class="toast.type">{{ toast.message }}</div>
</div>
@section Head {
    <link rel="stylesheet" href="~/css/finance-reports.css" asp-append-version="true" />
    <style>.property-scope-select{min-height:40px;width:auto;max-width:230px}.scope-readonly-note{display:flex;gap:8px 18px;align-items:center;flex-wrap:wrap;padding:12px 16px;border:1px solid #dce6e2;border-radius:12px;background:#f6faf8;color:var(--muted);font-size:.88rem}.scope-readonly-note strong{color:var(--text)}</style>
}
@section Scripts {
    <script>window.DeLongFinanceCanManage = @(User.IsInRole("Admin") || User.IsInRole("Manager") ? "true" : "false");</script>
    <script src="~/js/pages/admin-finance.js" asp-append-version="true"></script>
}
