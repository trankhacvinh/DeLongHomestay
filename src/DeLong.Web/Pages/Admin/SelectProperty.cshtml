@page
@model DeLong.Web.Pages.Admin.SelectPropertyModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chọn cơ sở";
}

<div class="container-lg py-3 py-md-4">
    <div class="page-header mb-4">
        <div class="page-pretitle">Phạm vi làm việc</div>
        <h1 class="page-title">Bạn đang làm việc tại cơ sở nào?</h1>
        <p class="text-secondary mt-2 mb-0">Tài khoản của bạn được cấp quyền nhiều cơ sở. Hãy chọn một cơ sở để thao tác phòng, booking, lịch, khách hàng và vận hành. Hệ thống sẽ nhớ lựa chọn này cho lần sau.</p>
    </div>

    <div class="row row-cards">
        @foreach (var property in Model.Properties)
        {
            <div class="col-md-6">
                <a class="card card-link card-link-pop h-100" href="@property.Url">
                    <div class="card-body">
                        <span class="badge bg-primary-lt mb-2">@property.Code</span>
                        <h2 class="card-title mb-1">@property.Name</h2>
                        <div class="text-primary fw-semibold">Chọn cơ sở này <span aria-hidden="true">→</span></div>
                    </div>
                </a>
            </div>
        }
    </div>

    <p class="text-secondary small mt-4 mb-0">Bạn chỉ nhìn thấy các cơ sở đã được phân quyền. Có thể đổi cơ sở bất cứ lúc nào từ bộ chọn trên thanh Admin.</p>
</div>
