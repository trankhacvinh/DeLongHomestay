@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject DeLong.Web.Features.Site.SiteContentService SiteContentService
@inject DeLong.Web.Features.Site.PublicPropertyResolver PublicPropertyResolver
@inject DeLong.Web.Common.Security.CurrentPropertyService CurrentPropertyService
@{
    var csrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var isAdmin = Context.Request.Path.StartsWithSegments("/Admin");
    var routePage = Context.Request.RouteValues["page"]?.ToString();
    var needsVue = isAdmin ||
    string.Equals(routePage, "/Booking/Index", StringComparison.OrdinalIgnoreCase) ||
    string.Equals(routePage, "/Booking/Lookup", StringComparison.OrdinalIgnoreCase);
    var publicSiteSlug = !isAdmin ? Context.Request.RouteValues["siteSlug"]?.ToString() : null;
    var isGlobalPublic = !isAdmin && string.IsNullOrWhiteSpace(publicSiteSlug);
    var publicScopePrefix = !isAdmin ? DeLong.Web.Features.Site.PublicPropertyResolver.ScopePrefix(publicSiteSlug) : string.Empty;
    var publicProperties = !isAdmin
        ? await PublicPropertyResolver.GetActiveAsync(Context.RequestAborted)
        : [];
    var showPublicBranches = publicProperties.Count > 1;
    var publicSite = !isAdmin && !isGlobalPublic ? await SiteContentService.GetPublicAsync(publicSiteSlug, Context.RequestAborted) : null;
    var publicSettings = publicSite?.Settings;
    var publicSiteName = string.IsNullOrWhiteSpace(publicSettings?.SiteName) ? "De Long Homestay" : publicSettings.SiteName;
    var publicTagline = string.IsNullOrWhiteSpace(publicSettings?.Tagline) ? "Long Thành · Đồng Nai" : publicSettings.Tagline;
    var path = Context.Request.Path.Value?.TrimEnd('/') ?? string.Empty;
    var editorialTab = string.Equals(Context.Request.Query["tab"].ToString(), "blog", StringComparison.OrdinalIgnoreCase) ? "blog" : "gallery";
    var requestedPropertyValue = Context.Request.Query["propertyId"].ToString();
    Guid? requestedPropertyId = Guid.TryParse(requestedPropertyValue, out var parsedPropertyId) ? parsedPropertyId : null;
    IReadOnlyList<DeLong.Web.Common.Security.CurrentPropertyDto> accessibleProperties = [];
    DeLong.Web.Common.Security.CurrentPropertyDto? currentProperty = null;
    if (isAdmin && User.Identity?.IsAuthenticated == true)
    {
        accessibleProperties = await CurrentPropertyService.GetAccessibleAsync(User, Context.RequestAborted);
        currentProperty = await CurrentPropertyService.ResolveAsync(User, requestedPropertyId, Context.RequestAborted);
    }
    string? propertyId = currentProperty?.Id.ToString();

    var canViewOperations = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff") || User.IsInRole("Viewer");
    var canViewRooms = canViewOperations;
    var canManageSettings = User.IsInRole("Admin") || User.IsInRole("Manager");
    var canManageStaff = User.IsInRole("Admin");
    var canManageProperties = User.IsInRole("Admin");
    var canManageSite = User.IsInRole("Admin") || User.IsInRole("Manager");
    var displayName = User.FindFirst("delong_display_name")?.Value ?? User.Identity?.Name ?? "Tài khoản";
    var roleLabel = User.IsInRole("Admin") ? "Quản trị viên"
        : User.IsInRole("Manager") ? "Quản lý"
        : User.IsInRole("Staff") ? "Nhân viên"
        : User.IsInRole("Housekeeping") ? "Dọn phòng"
        : User.IsInRole("Viewer") ? "Chỉ xem"
        : "Tài khoản";
    var userInitial = string.IsNullOrWhiteSpace(displayName) ? "A" : displayName.Trim().Substring(0, 1).ToUpperInvariant();

    string NavClass(string prefix, bool exact = false)
    {
        var active = exact
            ? string.Equals(path, prefix, StringComparison.OrdinalIgnoreCase)
            : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
        return active ? "side-link active" : "side-link";
    }
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="@csrf" />
    <meta name="theme-color" content="#0d2b2e" />
    @{
        var requestedTitle = ViewData["Title"]?.ToString();
        var isPublicHome = !isAdmin && string.Equals(Context.Request.RouteValues["page"]?.ToString(), "/Index", StringComparison.OrdinalIgnoreCase);
        var documentTitle = isAdmin
            ? $"{requestedTitle} - De Long Homestay"
            : (isPublicHome ? (string.IsNullOrWhiteSpace(requestedTitle) ? publicSiteName : requestedTitle) : $"{requestedTitle} - {publicSiteName}");
        var metaDescription = ViewData["MetaDescription"]?.ToString() ?? publicSettings?.MetaDescription;
        var robots = isAdmin
            ? "noindex,nofollow"
            : (ViewData["Robots"]?.ToString() ?? (publicSettings?.RobotsIndex == false ? "noindex,nofollow" : "index,follow"));
        var configuredBaseUrl = publicSettings?.CanonicalBaseUrl?.Trim().TrimEnd('/');
        var canonicalBaseUrl = !isAdmin
            ? (string.IsNullOrWhiteSpace(configuredBaseUrl) ? $"{Context.Request.Scheme}://{Context.Request.Host}" : configuredBaseUrl)
            : null;
        var canonicalUrlOverride = ViewData["CanonicalUrl"]?.ToString();
        var canonicalPath = ViewData["CanonicalPath"]?.ToString();
        if (string.IsNullOrWhiteSpace(canonicalPath)) canonicalPath = Context.Request.Path.Value ?? "/";
        if (!string.IsNullOrWhiteSpace(canonicalPath) && canonicalPath.Length > 1) canonicalPath = canonicalPath.TrimEnd('/');
        var canonical = !isAdmin
            ? (!string.IsNullOrWhiteSpace(canonicalUrlOverride)
                ? canonicalUrlOverride
                : $"{canonicalBaseUrl}{(canonicalPath!.StartsWith('/') ? canonicalPath : "/" + canonicalPath)}")
            : null;
        var ogTitle = ViewData["OgTitle"]?.ToString() ?? (string.IsNullOrWhiteSpace(publicSettings?.OgTitle) ? documentTitle : publicSettings.OgTitle);
        var ogDescription = ViewData["OgDescription"]?.ToString() ?? publicSettings?.OgDescription ?? metaDescription;
        var ogImage = ViewData["OgImage"]?.ToString() ?? publicSettings?.OgImageUrl;
        var ogType = ViewData["OgType"]?.ToString() ?? "website";
        var structuredDataJson = ViewData["StructuredData"]?.ToString();
        if (!isAdmin && string.IsNullOrWhiteSpace(structuredDataJson))
        {
            var defaultStructuredData = isGlobalPublic
                ? new Dictionary<string, object?>
                {
                    ["@context"] = "https://schema.org",
                    ["@type"] = "WebSite",
                    ["name"] = "De Long Homestay",
                    ["url"] = canonicalBaseUrl,
                    ["description"] = metaDescription
                }
                : new Dictionary<string, object?>
                {
                    ["@context"] = "https://schema.org",
                    ["@type"] = "LodgingBusiness",
                    ["name"] = publicSiteName,
                    ["description"] = metaDescription,
                    ["telephone"] = publicSettings?.Phone,
                    ["email"] = publicSettings?.Email,
                    ["address"] = publicSettings?.Address,
                    ["url"] = canonical,
                    ["logo"] = publicSettings?.LogoUrl,
                    ["image"] = string.IsNullOrWhiteSpace(publicSettings?.OgImageUrl) ? publicSettings?.CoverImageUrl : publicSettings.OgImageUrl
                };
            structuredDataJson = System.Text.Json.JsonSerializer.Serialize(defaultStructuredData);
        }
    }
    <title>@documentTitle</title>
    <meta name="robots" content="@robots" />
    @if (!isAdmin)
    {
        @if (!string.IsNullOrWhiteSpace(metaDescription)) { <meta name="description" content="@metaDescription" /> }
        @if (!string.IsNullOrWhiteSpace(canonical)) { <link rel="canonical" href="@canonical" /> }
        @if (!string.IsNullOrWhiteSpace(publicSettings?.FaviconUrl)) { <link rel="icon" href="@publicSettings.FaviconUrl" type="image/png" /> }
        @if (!string.IsNullOrWhiteSpace(publicSettings?.GoogleSiteVerification)) { <meta name="google-site-verification" content="@publicSettings.GoogleSiteVerification" /> }
        <meta property="og:title" content="@ogTitle" />
        @if (!string.IsNullOrWhiteSpace(ogDescription)) { <meta property="og:description" content="@ogDescription" /> }
        @if (!string.IsNullOrWhiteSpace(ogImage)) { <meta property="og:image" content="@ogImage" /><meta property="og:image:alt" content="@ogTitle" /> }
        @if (!string.IsNullOrWhiteSpace(canonical)) { <meta property="og:url" content="@canonical" /> }
        <meta property="og:type" content="@ogType" />
        <meta property="og:site_name" content="@publicSiteName" />
        <meta name="twitter:card" content="@(string.IsNullOrWhiteSpace(ogImage) ? "summary" : "summary_large_image")" />
        <meta name="twitter:title" content="@ogTitle" />
        @if (!string.IsNullOrWhiteSpace(ogDescription)) { <meta name="twitter:description" content="@ogDescription" /> }
        @if (!string.IsNullOrWhiteSpace(ogImage)) { <meta name="twitter:image" content="@ogImage" /> }
        @if (!string.IsNullOrWhiteSpace(structuredDataJson)) { <script type="application/ld+json">@Html.Raw(structuredDataJson)</script> }
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isAdmin) { <link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true" /> }
    <link rel="stylesheet" href="~/css/operational-polish.css" asp-append-version="true" />
    @if (isAdmin) { <link rel="stylesheet" href="~/css/admin-shell-fixes.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" /> }
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/css/mobile-final.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    @if (!isAdmin) { <link rel="stylesheet" href="~/css/hospitality-shell.css" asp-append-version="true" /> }
    @if (!isAdmin && !isGlobalPublic) { <link rel="stylesheet" href="@(publicScopePrefix + "/site/custom.css")" /> }
</head>
<body class="@(isAdmin ? "admin-body" : "public-body")">
<a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
<svg class="svg-sprite" aria-hidden="true">
    <symbol id="i-grid" viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><path d="M6 3v3M18 3v3M4 8h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z"/></symbol>
    <symbol id="i-booking" viewBox="0 0 24 24"><path d="M5 5h14v15H5zM8 2v5M16 2v5M8 11h8M8 15h5"/></symbol>
