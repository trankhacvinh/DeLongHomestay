</svg>
@if (isAdmin)
{
    <div class="admin-shell">
        <div class="sidebar-overlay" data-sidebar-overlay></div>
        <aside class="sidebar" aria-label="Điều hướng quản trị">
            <div class="sidebar-head">
                <a class="brand admin-brand" asp-page="/Admin/Index" asp-route-propertyId="@propertyId">
                    <span class="brand-mark">DL</span>
                    <span class="brand-copy"><strong>De Long</strong><small>Homestay</small></span>
                </a>
                <button class="sidebar-close btn-icon" type="button" data-sidebar-toggle aria-label="Đóng menu" aria-expanded="false">×</button>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-group">
                    <div class="nav-label">Vận hành</div>
                    <a class="@NavClass("/Admin", true)" asp-page="/Admin/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-grid" /></svg><span>Tổng quan</span></a>
                    @if (canViewOperations)
                    {
                        <a class="@NavClass("/Admin/Calendar")" asp-page="/Admin/Calendar" asp-route-propertyId="@propertyId"><svg><use href="#i-calendar" /></svg><span>Lịch phòng</span></a>
                        <a class="@NavClass("/Admin/Bookings")" asp-page="/Admin/Bookings/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-booking" /></svg><span>Đặt phòng</span></a>
                        <a class="@NavClass("/Admin/Customers")" asp-page="/Admin/Customers/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-users" /></svg><span>Khách hàng</span></a>
                    }
                    <a class="@NavClass("/Admin/Housekeeping")" asp-page="/Admin/Housekeeping/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-sparkles" /></svg><span>Dọn phòng</span></a>
                </div>
                @if (canViewRooms || canManageSettings || canManageStaff || canManageProperties || canManageSite)
                {
                    <div class="nav-group">
                        <div class="nav-label">Quản lý</div>
                        @if (canViewRooms)
                        {
                            <a class="@NavClass("/Admin/Rooms")" asp-page="/Admin/Rooms/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-bed" /></svg><span>Phòng</span></a>
                        }
                        @if (canManageSettings)
                        {
                            <a class="@NavClass("/Admin/Settings")" asp-page="/Admin/Settings/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-settings" /></svg><span>Cấu hình</span></a>
                        }
                        @if (canManageProperties)
                        {
                            <a class="@NavClass("/Admin/Properties")" asp-page="/Admin/Properties/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-bed" /></svg><span>Cơ sở</span></a>
                        }
                        @if (canManageStaff)
                        {
                            <a class="@NavClass("/Admin/Staff")" asp-page="/Admin/Staff/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-users" /></svg><span>Nhân viên</span></a>
                        }
                    </div>
                }
                @if (canManageSite)
                {
                    <div class="nav-group">
                        <div class="nav-label">Website</div>
                        <a class="@NavClass("/Admin/Site", true)" asp-page="/Admin/Site/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-settings" /></svg><span>Trang cơ sở</span></a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="@NavClass("/Admin/Site/Global", true)" asp-page="/Admin/Site/Global"><svg><use href="#i-grid" /></svg><span>Trang chủ chung</span></a>
                        }
                        <a class="@(path.StartsWith("/Admin/Site/Editorial", StringComparison.OrdinalIgnoreCase) && editorialTab == "gallery" ? "side-link active" : "side-link")" asp-page="/Admin/Site/Editorial" asp-route-propertyId="@propertyId" asp-route-tab="gallery"><svg><use href="#i-image" /></svg><span>Gallery</span></a>
                        <a class="@(path.StartsWith("/Admin/Site/Editorial", StringComparison.OrdinalIgnoreCase) && editorialTab == "blog" ? "side-link active" : "side-link")" asp-page="/Admin/Site/Editorial" asp-route-propertyId="@propertyId" asp-route-tab="blog"><svg><use href="#i-article" /></svg><span>Blog</span></a>
                        <a class="side-link" href="/" target="_blank" rel="noopener"><svg><use href="#i-external" /></svg><span>Xem website</span></a>
                    </div>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Viewer"))
                {
                    <div class="nav-group">
                        <div class="nav-label">Tài chính</div>
                        <a class="@NavClass("/Admin/Finance")" asp-page="/Admin/Finance/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-wallet" /></svg><span>Thu chi</span></a>
                        <a class="@NavClass("/Admin/Reports")" asp-page="/Admin/Reports/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-chart" /></svg><span>Báo cáo</span></a>
                    </div>
                }
            </nav>
            <div class="sidebar-foot"><div class="sidebar-hint"><span class="status-dot"></span><span>Hệ thống đang hoạt động</span></div></div>
        </aside>
        <main class="admin-main">
            <header class="admin-topbar">
                <button class="mobile-menu btn-icon" type="button" data-sidebar-toggle aria-label="Mở menu" aria-expanded="false"><svg><use href="#i-menu" /></svg></button>
                <div class="topbar-context">
                    @if (accessibleProperties.Count > 1 && currentProperty is not null)
                    {
                        <select class="property-context-select" data-property-switcher aria-label="Cơ sở hiện tại" title="Chọn cơ sở đang làm việc">
                            @foreach (var property in accessibleProperties)
                            {
                                if (property.Id == currentProperty.Id)
                                {
                                    <option value="@property.Id" selected>@property.Name · @property.Code</option>
                                }
                                else
                                {
                                    <option value="@property.Id">@property.Name · @property.Code</option>
                                }
                            }
                        </select>
                    }
                    else
                    {
                        var contextName = currentProperty?.Name ?? (accessibleProperties.Count > 0 ? "Không xác định cơ sở" : "Chưa có cơ sở");
                        <span class="topbar-property@(currentProperty is null ? " is-empty" : string.Empty)">@contextName</span>
                    }
                    <span class="topbar-page">@ViewData["Title"]</span>
                </div>
                <span class="spacer"></span>
                @if (canViewOperations && currentProperty is not null)
                {
                    <div class="notification-center" data-notification-center data-property-id="@currentProperty.Id">
                        <button class="btn-icon notification-bell" type="button" data-notification-toggle aria-label="Thông báo" aria-expanded="false"><svg><use href="#i-bell" /></svg><span class="notification-badge" data-notification-badge hidden>0</span></button>
                        <section class="notification-popover" data-notification-popover hidden aria-label="Thông báo đặt phòng">
                            <div class="notification-popover-head"><strong>Thông báo</strong><button class="notification-read-all" type="button" data-notification-read-all hidden>Đánh dấu đã đọc</button></div>
                            <div class="notification-list" data-notification-list></div>
                            <div class="notification-empty" data-notification-empty>Chưa có thông báo đặt phòng.</div>
                        </section>
                    </div>
                }
                <div class="user-chip"><span class="user-avatar">@userInitial</span><span class="user-copy"><strong>@displayName</strong><small>@roleLabel</small></span></div>
                <form method="post" asp-page="/Account/Logout"><button class="btn-icon logout-btn" type="submit" title="Đăng xuất" aria-label="Đăng xuất"><svg><use href="#i-logout" /></svg></button></form>
            </header>
            <div class="admin-content" id="main-content" tabindex="-1">@RenderBody()</div>
        </main>
    </div>
}
else
{
    var bookingUrl = isGlobalPublic ? "/booking" : DeLong.Web.Features.Site.PublicUrlBuilder.Booking(publicSiteSlug!);
    var lookupUrl = isGlobalPublic ? "/booking/lookup" : DeLong.Web.Features.Site.PublicUrlBuilder.BookingLookup(publicSiteSlug!);
    <header class="public-site-header">
        <div class="public-container public-site-nav">
            <a class="public-site-brand" href="@(isGlobalPublic ? "/" : DeLong.Web.Features.Site.PublicUrlBuilder.PropertyHome(publicSiteSlug!))">
                @if (!string.IsNullOrWhiteSpace(publicSettings?.LogoUrl)) { <img class="public-site-brand-logo" src="@publicSettings.LogoUrl" alt="@publicSiteName" /> }
                else { <span class="brand-mark">DL</span> }
                <span><strong>@publicSiteName</strong><small>@publicTagline</small></span>
            </a>
            <nav class="public-site-links" aria-label="Điều hướng trang khách">
                <a href="/">Trang chủ</a>
                <a href="/rooms">Phòng</a>
                @if (showPublicBranches) { <a href="/#co-so">Cơ sở</a> }
                <a href="@bookingUrl">Đặt phòng</a>
                <a href="@lookupUrl">Tra cứu</a>
            </nav>
            <div class="public-site-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="public-admin-link" asp-page="/Admin/Index">Quản trị</a>
                }
                else
                {
                    <a class="public-admin-link" asp-page="/Account/Login">Đăng nhập</a>
                }
                <a class="public-btn public-btn-primary" href="@bookingUrl">Đặt phòng</a>
            </div>
        </div>
    </header>
    <main class="public-main" id="main-content" tabindex="-1">@RenderBody()</main>
    <footer class="public-hospitality-footer">
        <div class="public-container public-hospitality-footer-grid">
            <div class="public-footer-brand">
                <a class="public-site-brand public-footer-brand-link" href="@(isGlobalPublic ? "/" : DeLong.Web.Features.Site.PublicUrlBuilder.PropertyHome(publicSiteSlug!))">
                    @if (!string.IsNullOrWhiteSpace(publicSettings?.LogoUrl)) { <img class="public-site-brand-logo" src="@publicSettings.LogoUrl" alt="@publicSiteName" /> }
                    else { <span class="brand-mark">DL</span> }
                    <span><strong>@publicSiteName</strong><small>@publicTagline</small></span>
                </a>
                <p>Một nơi để nghỉ chậm lại, chọn phòng rõ ràng và gửi yêu cầu đặt chỗ trực tiếp.</p>
                <a class="public-footer-book" href="@bookingUrl">Đặt phòng →</a>
            </div>
            <div class="public-footer-column">
                <strong>Khám phá</strong>
                <a href="/">Trang chủ</a>
                <a href="/rooms">Phòng</a>
                <a href="@bookingUrl">Đặt phòng</a>
                <a href="@lookupUrl">Tra cứu</a>
            </div>
            @if (showPublicBranches)
            {
                <div class="public-footer-column">
                    <strong>Cơ sở</strong>
                    @foreach (var property in publicProperties)
                    {
                        <a href="@DeLong.Web.Features.Site.PublicUrlBuilder.PropertyHome(property.SiteSlug)">@property.Name</a>
                    }
                </div>
            }
            @if (!isGlobalPublic && publicSettings is not null && (!string.IsNullOrWhiteSpace(publicSettings.Phone) || !string.IsNullOrWhiteSpace(publicSettings.Email) || !string.IsNullOrWhiteSpace(publicSettings.Address)))
            {
                <div class="public-footer-column public-footer-contact">
                    <strong>Liên hệ</strong>
                    @if (!string.IsNullOrWhiteSpace(publicSettings.Address)) { <span>@publicSettings.Address</span> }
                    @if (!string.IsNullOrWhiteSpace(publicSettings.Phone)) { <a href="tel:@publicSettings.Phone">@publicSettings.Phone</a> }
                    @if (!string.IsNullOrWhiteSpace(publicSettings.Email)) { <a href="mailto:@publicSettings.Email">@publicSettings.Email</a> }
                </div>
            }
        </div>
        <div class="public-container public-footer-bottom"><span>© @DateTime.UtcNow.Year De Long Homestay</span><span>Đặt phòng trực tiếp · Giá rõ ràng · Xác nhận bởi nhân viên</span></div>
    </footer>
}
<div id="global-toast-root" class="toast-root" aria-live="polite"></div>
@if (needsVue) { <script src="https://cdn.jsdelivr.net/npm/vue@3.5.40/dist/vue.global.prod.js"></script> }
<script src="~/js/core/api.js" asp-append-version="true"></script>
<script src="~/js/core/shell.js" asp-append-version="true"></script>
@if (isAdmin) { <script src="~/js/core/admin-notifications.js" asp-append-version="true"></script> }
@await RenderSectionAsync("Scripts", required: false)
@if (!isAdmin && !isGlobalPublic) { <script src="@(publicScopePrefix + "/site/custom.js")"></script> }
</body>
</html>