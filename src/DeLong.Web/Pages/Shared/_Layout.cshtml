@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject DeLong.Web.Features.Site.SiteContentService SiteContentService
@inject DeLong.Web.Common.Security.CurrentPropertyService CurrentPropertyService
@{
    var csrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var isAdmin = Context.Request.Path.StartsWithSegments("/Admin");
    var publicSite = !isAdmin ? await SiteContentService.GetPublicAsync(Context.RequestAborted) : null;
    var publicSettings = publicSite?.Settings;
    var publicSiteName = string.IsNullOrWhiteSpace(publicSettings?.SiteName) ? "De Long Homestay" : publicSettings.SiteName;
    var publicTagline = string.IsNullOrWhiteSpace(publicSettings?.Tagline) ? "Long Thành · Đồng Nai" : publicSettings.Tagline;
    var path = Context.Request.Path.Value?.TrimEnd('/') ?? string.Empty;
    var requestedPropertyValue = Context.Request.Query["propertyId"].ToString();
    Guid? requestedPropertyId = Guid.TryParse(requestedPropertyValue, out var parsedPropertyId) ? parsedPropertyId : null;
    IReadOnlyList<DeLong.Web.Common.Security.CurrentPropertyDto> accessibleProperties = [];
    DeLong.Web.Common.Security.CurrentPropertyDto? currentProperty = null;
    if (isAdmin && User.Identity?.IsAuthenticated == true)
    {
        accessibleProperties = await CurrentPropertyService.GetAccessibleAsync(User, Context.RequestAborted);
        currentProperty = await CurrentPropertyService.ResolveAsync(User, requestedPropertyId, Context.RequestAborted);
    }
    string? propertyId = currentProperty?.Id.ToString();

    var canViewOperations = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff") || User.IsInRole("Viewer");
    var canViewRooms = canViewOperations;
    var canManageSettings = User.IsInRole("Admin") || User.IsInRole("Manager");
    var canManageStaff = User.IsInRole("Admin");
    var canManageProperties = User.IsInRole("Admin");
    var canManageSite = User.IsInRole("Admin") || User.IsInRole("Manager");
    var displayName = User.FindFirst("delong_display_name")?.Value ?? User.Identity?.Name ?? "Tài khoản";
    var roleLabel = User.IsInRole("Admin") ? "Quản trị viên"
        : User.IsInRole("Manager") ? "Quản lý"
        : User.IsInRole("Staff") ? "Nhân viên"
        : User.IsInRole("Housekeeping") ? "Dọn phòng"
        : User.IsInRole("Viewer") ? "Chỉ xem"
        : "Tài khoản";
    var userInitial = string.IsNullOrWhiteSpace(displayName) ? "A" : displayName.Trim().Substring(0, 1).ToUpperInvariant();

    string NavClass(string prefix, bool exact = false)
    {
        var active = exact
            ? string.Equals(path, prefix, StringComparison.OrdinalIgnoreCase)
            : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
        return active ? "side-link active" : "side-link";
    }
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="@csrf" />
    <meta name="theme-color" content="#0d2b2e" />
    @{
        var requestedTitle = ViewData["Title"]?.ToString();
        var documentTitle = isAdmin
            ? $"{requestedTitle} - De Long Homestay"
            : (Context.Request.Path == "/" ? (string.IsNullOrWhiteSpace(requestedTitle) ? publicSiteName : requestedTitle) : $"{requestedTitle} - {publicSiteName}");
        var metaDescription = ViewData["MetaDescription"]?.ToString() ?? publicSettings?.MetaDescription;
        var canonical = !isAdmin && !string.IsNullOrWhiteSpace(publicSettings?.CanonicalBaseUrl)
            ? $"{publicSettings.CanonicalBaseUrl.TrimEnd('/')}{Context.Request.Path}"
            : null;
    }
    <title>@documentTitle</title>
    @if (!isAdmin)
    {
        @if (!string.IsNullOrWhiteSpace(metaDescription)) { <meta name="description" content="@metaDescription" /> }
        <meta name="robots" content="@(publicSettings?.RobotsIndex == false ? "noindex,nofollow" : "index,follow")" />
        @if (!string.IsNullOrWhiteSpace(canonical)) { <link rel="canonical" href="@canonical" /> }
        @if (!string.IsNullOrWhiteSpace(publicSettings?.FaviconUrl)) { <link rel="icon" href="@publicSettings.FaviconUrl" type="image/png" /> }
        @if (!string.IsNullOrWhiteSpace(publicSettings?.GoogleSiteVerification)) { <meta name="google-site-verification" content="@publicSettings.GoogleSiteVerification" /> }
        <meta property="og:title" content="@(string.IsNullOrWhiteSpace(publicSettings?.OgTitle) ? documentTitle : publicSettings.OgTitle)" />
        @if (!string.IsNullOrWhiteSpace(publicSettings?.OgDescription ?? metaDescription)) { <meta property="og:description" content="@(publicSettings?.OgDescription ?? metaDescription)" /> }
        @if (!string.IsNullOrWhiteSpace(publicSettings?.OgImageUrl)) { <meta property="og:image" content="@publicSettings.OgImageUrl" /> }
        @if (!string.IsNullOrWhiteSpace(canonical)) { <meta property="og:url" content="@canonical" /> }
        <meta property="og:type" content="website" />
        var structuredData = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "LodgingBusiness",
                ["name"] = publicSiteName,
                ["description"] = metaDescription,
                ["telephone"] = publicSettings?.Phone,
                ["email"] = publicSettings?.Email,
                ["address"] = publicSettings?.Address,
                ["url"] = publicSettings?.CanonicalBaseUrl,
                ["logo"] = publicSettings?.LogoUrl,
                ["image"] = publicSettings?.OgImageUrl
            });
        <script type="application/ld+json">@Html.Raw(structuredData)</script>
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operational-polish.css" asp-append-version="true" />
    @if (isAdmin) { <link rel="stylesheet" href="~/css/admin-shell-fixes.css" asp-append-version="true" /> }
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/css/mobile-final.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    @if (!isAdmin) { <link rel="stylesheet" href="/site/custom.css" /> }
</head>
<body class="@(isAdmin ? "admin-body" : "public-body")">
<a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
<svg class="svg-sprite" aria-hidden="true">
    <symbol id="i-grid" viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><path d="M6 3v3M18 3v3M4 8h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z"/></symbol>
    <symbol id="i-booking" viewBox="0 0 24 24"><path d="M5 5h14v15H5zM8 2v5M16 2v5M8 11h8M8 15h5"/></symbol>
    <symbol id="i-users" viewBox="0 0 24 24"><path d="M16 20v-2a4 4 0 0 0-4-4H7a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM17 11a3 3 0 1 0 0-6M17 14c2.2 0 4 1.8 4 4v2"/></symbol>
    <symbol id="i-sparkles" viewBox="0 0 24 24"><path d="m12 3 1.1 3.2L16 7.5l-2.9 1.3L12 12l-1.1-3.2L8 7.5l2.9-1.3L12 3ZM5 12l.8 2.2L8 15l-2.2.8L5 18l-.8-2.2L2 15l2.2-.8L5 12ZM18 13l1 2.8L22 17l-3 1.2L18 21l-1-2.8L14 17l3-1.2 1-2.8Z"/></symbol>
    <symbol id="i-bed" viewBox="0 0 24 24"><path d="M3 12v7M21 12v7M3 17h18M5 12V7h6a3 3 0 0 1 3 3v2M14 10h4a3 3 0 0 1 3 3v4"/></symbol>
    <symbol id="i-wallet" viewBox="0 0 24 24"><path d="M4 6h14a2 2 0 0 1 2 2v11H4a2 2 0 0 1-2-2V6a3 3 0 0 1 3-3h12M16 11h6v5h-6a2 2 0 0 1 0-5Z"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21h-4v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H3v-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V3h4v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1H21v4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 5H4v14h6M14 8l4 4-4 4M18 12H8"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-chevron-left" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
    <symbol id="i-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
</svg>
@if (isAdmin)
{
    <div class="admin-shell">
        <div class="sidebar-overlay" data-sidebar-overlay></div>
        <aside class="sidebar" aria-label="Điều hướng quản trị">
            <div class="sidebar-head">
                <a class="brand admin-brand" asp-page="/Admin/Index" asp-route-propertyId="@propertyId">
                    <span class="brand-mark">DL</span>
                    <span class="brand-copy"><strong>De Long</strong><small>Homestay</small></span>
                </a>
                <button class="sidebar-close btn-icon" type="button" data-sidebar-toggle aria-label="Đóng menu" aria-expanded="false">×</button>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-group">
                    <div class="nav-label">Vận hành</div>
                    <a class="@NavClass("/Admin", true)" asp-page="/Admin/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-grid" /></svg><span>Tổng quan</span></a>
                    @if (canViewOperations)
                    {
                        <a class="@NavClass("/Admin/Calendar")" asp-page="/Admin/Calendar" asp-route-propertyId="@propertyId"><svg><use href="#i-calendar" /></svg><span>Lịch phòng</span></a>
                        <a class="@NavClass("/Admin/Bookings")" asp-page="/Admin/Bookings/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-booking" /></svg><span>Đặt phòng</span></a>
                        <a class="@NavClass("/Admin/Customers")" asp-page="/Admin/Customers/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-users" /></svg><span>Khách hàng</span></a>
                    }
                    <a class="@NavClass("/Admin/Housekeeping")" asp-page="/Admin/Housekeeping/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-sparkles" /></svg><span>Dọn phòng</span></a>
                </div>
                @if (canViewRooms || canManageSettings || canManageStaff || canManageProperties || canManageSite)
                {
                    <div class="nav-group">
                        <div class="nav-label">Quản lý</div>
                        @if (canViewRooms)
                        {
                            <a class="@NavClass("/Admin/Rooms")" asp-page="/Admin/Rooms/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-bed" /></svg><span>Phòng</span></a>
                        }
                        @if (canManageSettings)
                        {
                            <a class="@NavClass("/Admin/Settings")" asp-page="/Admin/Settings/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-settings" /></svg><span>Cấu hình</span></a>
                        }
                        @if (canManageSite)
                        {
                            <a class="@NavClass("/Admin/Site")" asp-page="/Admin/Site/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-settings" /></svg><span>Website</span></a>
                        }
                        @if (canManageProperties)
                        {
                            <a class="@NavClass("/Admin/Properties")" asp-page="/Admin/Properties/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-bed" /></svg><span>Cơ sở</span></a>
                        }
                        @if (canManageStaff)
                        {
                            <a class="@NavClass("/Admin/Staff")" asp-page="/Admin/Staff/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-users" /></svg><span>Nhân viên</span></a>
                        }
                    </div>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Viewer"))
                {
                    <div class="nav-group">
                        <div class="nav-label">Tài chính</div>
                        <a class="@NavClass("/Admin/Finance")" asp-page="/Admin/Finance/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-wallet" /></svg><span>Thu chi</span></a>
                        <a class="@NavClass("/Admin/Reports")" asp-page="/Admin/Reports/Index" asp-route-propertyId="@propertyId"><svg><use href="#i-chart" /></svg><span>Báo cáo</span></a>
                    </div>
                }
            </nav>
            <div class="sidebar-foot"><div class="sidebar-hint"><span class="status-dot"></span><span>Hệ thống đang hoạt động</span></div></div>
        </aside>
        <main class="admin-main">
            <header class="admin-topbar">
                <button class="mobile-menu btn-icon" type="button" data-sidebar-toggle aria-label="Mở menu" aria-expanded="false"><svg><use href="#i-menu" /></svg></button>
                <div class="topbar-context">
                    @if (accessibleProperties.Count > 1 && currentProperty is not null)
                    {
                        <select class="property-context-select" data-property-switcher aria-label="Cơ sở hiện tại" title="Chọn cơ sở đang làm việc">
                            @foreach (var property in accessibleProperties)
                            {
                                if (property.Id == currentProperty.Id)
                                {
                                    <option value="@property.Id" selected>@property.Name · @property.Code</option>
                                }
                                else
                                {
                                    <option value="@property.Id">@property.Name · @property.Code</option>
                                }
                            }
                        </select>
                    }
                    else
                    {
                        var contextName = currentProperty?.Name ?? (accessibleProperties.Count > 0 ? "Không xác định cơ sở" : "Chưa có cơ sở");
                        <span class="topbar-property@(currentProperty is null ? " is-empty" : string.Empty)">@contextName</span>
                    }
                    <span class="topbar-page">@ViewData["Title"]</span>
                </div>
                <span class="spacer"></span>
                <div class="user-chip"><span class="user-avatar">@userInitial</span><span class="user-copy"><strong>@displayName</strong><small>@roleLabel</small></span></div>
                <form method="post" asp-page="/Account/Logout"><button class="btn-icon logout-btn" type="submit" title="Đăng xuất" aria-label="Đăng xuất"><svg><use href="#i-logout" /></svg></button></form>
            </header>
            <div class="admin-content" id="main-content" tabindex="-1">@RenderBody()</div>
        </main>
    </div>
}
else
{
    <header class="public-site-header">
        <div class="public-container public-site-nav">
            <a class="public-site-brand" asp-page="/Index">
                @if (!string.IsNullOrWhiteSpace(publicSettings?.LogoUrl)) { <img class="public-site-brand-logo" src="@publicSettings.LogoUrl" alt="@publicSiteName" /> }
                else { <span class="brand-mark">DL</span> }
                <span><strong>@publicSiteName</strong><small>@publicTagline</small></span>
            </a>
            <nav class="public-site-links" aria-label="Điều hướng trang khách">
                <a asp-page="/Index">Trang chủ</a>
                <a asp-page="/Rooms/Index">Phòng</a>
                <a asp-page="/Booking/Index">Đặt phòng</a>
                <a asp-page="/Booking/Lookup">Tra cứu</a>
            </nav>
            <div class="public-site-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="public-admin-link" asp-page="/Admin/Index">Quản trị</a>
                }
                else
                {
                    <a class="public-admin-link" asp-page="/Account/Login">Đăng nhập</a>
                }
                <a class="public-btn public-btn-primary" asp-page="/Booking/Index">Kiểm tra phòng</a>
            </div>
        </div>
    </header>
    <main class="public-main" id="main-content" tabindex="-1">@RenderBody()</main>
}
<div id="global-toast-root" class="toast-root" aria-live="polite"></div>
<script src="https://cdn.jsdelivr.net/npm/vue@3.5.40/dist/vue.global.prod.js"></script>
<script src="~/js/core/api.js" asp-append-version="true"></script>
<script src="~/js/core/shell.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
@if (!isAdmin) { <script src="/site/custom.js"></script> }
</body>
</html>