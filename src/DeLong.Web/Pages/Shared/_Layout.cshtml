@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject DeLong.Web.Features.Site.SiteContentService SiteContentService
@inject DeLong.Web.Features.Site.PublicPropertyResolver PublicPropertyResolver
@inject DeLong.Web.Common.Security.CurrentPropertyService CurrentPropertyService
@{
    var csrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var isAdmin = Context.Request.Path.StartsWithSegments("/Admin");
    var routePage = Context.Request.RouteValues["page"]?.ToString();
    var needsVue = isAdmin ||
                   string.Equals(routePage, "/Booking/Index", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(routePage, "/Booking/Lookup", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(routePage, "/Customer/Account", StringComparison.OrdinalIgnoreCase);
    var publicSiteSlug = !isAdmin ? Context.Request.RouteValues["siteSlug"]?.ToString() : null;
    var isGlobalPublic = !isAdmin && string.IsNullOrWhiteSpace(publicSiteSlug);
    var publicScopePrefix = !isAdmin ? DeLong.Web.Features.Site.PublicPropertyResolver.ScopePrefix(publicSiteSlug) : string.Empty;
    var publicSite = !isAdmin && !isGlobalPublic ? await SiteContentService.GetPublicAsync(publicSiteSlug, Context.RequestAborted) : null;
    var publicSettings = publicSite?.Settings;
    IReadOnlyList<DeLong.Web.Features.Site.HomeSectionDto> publicFaqSections = [];
    if (!isAdmin)
    {
        var sections = publicSite?.Sections ?? await SiteContentService.GetGlobalPublicSectionsAsync(Context.RequestAborted);
        publicFaqSections = sections.Where(x => x.IsVisible && x.Type == "Faq").ToList();
    }
    var globalBranding = ViewData["GlobalBranding"] as DeLong.Web.Features.Site.GlobalSiteBrandingDto;
    var publicSiteName = string.IsNullOrWhiteSpace(publicSettings?.SiteName) ? globalBranding?.SiteName ?? "Homestay" : publicSettings.SiteName;
    var brandInitials = string.Concat(publicSiteName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => System.Globalization.StringInfo.GetNextTextElement(x))).ToUpperInvariant();
    var publicLogoUrl = publicSettings?.LogoUrl ?? globalBranding?.LogoUrl;
    var publicTagline = string.IsNullOrWhiteSpace(publicSettings?.Tagline) ? globalBranding?.Tagline ?? string.Empty : publicSettings.Tagline;
    // Footer contact cards: every active property on the global site, only the current property on a property site.
    IReadOnlyList<DeLong.Web.Features.Site.PublicPropertyContactDto> publicContacts = [];
    // Standard theme: the built-in design wins over visual-editor styling, header/footer designer and custom.css.
    var publicThemeStandard = false;
    if (!isAdmin)
    {
        publicThemeStandard = (await SiteContentService.GetPublicThemeAsync(Context.RequestAborted)).IsStandard;
        var allContacts = await SiteContentService.GetPublicContactsAsync(Context.RequestAborted);
        publicContacts = isGlobalPublic
            ? allContacts
            : allContacts.Where(x => string.Equals(x.SiteSlug, publicSiteSlug, StringComparison.OrdinalIgnoreCase)).ToList();
    }
    var path = Context.Request.Path.Value?.TrimEnd('/') ?? string.Empty;
    var isPaymentPage = Context.Request.Path.StartsWithSegments("/payment");
    var editorialTab = string.Equals(Context.Request.Query["tab"].ToString(), "blog", StringComparison.OrdinalIgnoreCase) ? "blog" : "gallery";
    var requestedPropertyValue = Context.Request.Query["propertyId"].ToString();
    Guid? requestedPropertyId = Guid.TryParse(requestedPropertyValue, out var parsedPropertyId) ? parsedPropertyId : null;
    IReadOnlyList<DeLong.Web.Common.Security.CurrentPropertyDto> accessibleProperties = [];
    DeLong.Web.Common.Security.CurrentPropertyDto? currentProperty = null;
    if (isAdmin && User.Identity?.IsAuthenticated == true)
    {
        accessibleProperties = await CurrentPropertyService.GetAccessibleAsync(User, Context.RequestAborted);
        currentProperty = await CurrentPropertyService.ResolveAsync(User, requestedPropertyId, Context.RequestAborted);
    }

    string? propertyId = currentProperty?.Id.ToString();
    var adminBrandName = currentProperty?.Name ?? publicSiteName;
    var adminBrandInitials = string.Concat(adminBrandName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2)
        .Select(x => System.Globalization.StringInfo.GetNextTextElement(x))).ToUpperInvariant();

    var canViewOperations = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff") || User.IsInRole("Viewer");
    var canViewVouchers = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff");
    var canViewRooms = canViewOperations || User.IsInRole("Media");
    var canViewPricing = canViewOperations;
    var canManageSettings = User.IsInRole("Admin") || User.IsInRole("Manager");
    var canManageStaff = User.IsInRole("Admin");
    var canManageProperties = User.IsInRole("Admin");
    var canManageSite = User.IsInRole("Admin") || User.IsInRole("Manager");
    var canManageMedia = canManageSite || User.IsInRole("Media");
    var canUseStaffAi = User.IsInRole("Manager") || User.IsInRole("Staff") || User.IsInRole("Housekeeping") || User.IsInRole("Viewer");
    var displayName = User.FindFirst("delong_display_name")?.Value ?? User.Identity?.Name ?? "Tài khoản";
    var roleLabel = User.IsInRole("Admin") ? "Quản trị viên"
        : User.IsInRole("Manager") ? "Quản lý"
        : User.IsInRole("Staff") ? "Nhân viên"
        : User.IsInRole("Housekeeping") ? "Dọn phòng"
        : User.IsInRole("Media") ? "Media"
        : User.IsInRole("Viewer") ? "Chỉ xem"
        : "Tài khoản";
    var applicationBuild = DeLong.Web.Common.Operations.ApplicationBuildInfo.Current;
    var userInitial = string.IsNullOrWhiteSpace(displayName) ? "A" : displayName.Trim().Substring(0, 1).ToUpperInvariant();

    string NavClass(string prefix, bool exact = false)
    {
        var active = exact
            ? string.Equals(path, prefix, StringComparison.OrdinalIgnoreCase)
            : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
        return active ? "side-link active" : "side-link";
    }
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="csrf-token" content="@csrf"/>
    <meta name="theme-color" content="#0d2b2e"/>
    @{
        var requestedTitle = ViewData["Title"]?.ToString();
        var isPublicHome = !isAdmin && string.Equals(Context.Request.RouteValues["page"]?.ToString(), "/Index", StringComparison.OrdinalIgnoreCase);
        var documentTitle = isAdmin
            ? $"{requestedTitle} - {adminBrandName}"
            : (isPublicHome ? (string.IsNullOrWhiteSpace(requestedTitle) ? publicSiteName : requestedTitle) : $"{requestedTitle} - {publicSiteName}");
        var metaDescription = ViewData["MetaDescription"]?.ToString() ?? publicSettings?.MetaDescription;
        var robots = isAdmin
            ? "noindex,nofollow"
            : (ViewData["Robots"]?.ToString() ?? (publicSettings?.RobotsIndex == false ? "noindex,nofollow" : "index,follow"));
        var configuredBaseUrl = publicSettings?.CanonicalBaseUrl?.Trim().TrimEnd('/');
        var canonicalBaseUrl = !isAdmin
            ? (string.IsNullOrWhiteSpace(configuredBaseUrl) ? $"{Context.Request.Scheme}://{Context.Request.Host}" : configuredBaseUrl)
            : null;
        var canonicalUrlOverride = ViewData["CanonicalUrl"]?.ToString();
        var canonicalPath = ViewData["CanonicalPath"]?.ToString();
        if (string.IsNullOrWhiteSpace(canonicalPath)) canonicalPath = Context.Request.Path.Value ?? "/";
        if (!string.IsNullOrWhiteSpace(canonicalPath) && canonicalPath.Length > 1) canonicalPath = canonicalPath.TrimEnd('/');
        var canonical = !isAdmin
            ? (!string.IsNullOrWhiteSpace(canonicalUrlOverride)
                ? canonicalUrlOverride
                : $"{canonicalBaseUrl}{(canonicalPath!.StartsWith('/') ? canonicalPath : "/" + canonicalPath)}")
            : null;
        var ogTitle = ViewData["OgTitle"]?.ToString() ?? (string.IsNullOrWhiteSpace(publicSettings?.OgTitle) ? documentTitle : publicSettings.OgTitle);
        var ogDescription = ViewData["OgDescription"]?.ToString() ?? publicSettings?.OgDescription ?? metaDescription;
        var ogImage = ViewData["OgImage"]?.ToString() ?? publicSettings?.OgImageUrl;
        var ogType = ViewData["OgType"]?.ToString() ?? "website";
        var structuredDataJson = ViewData["StructuredData"]?.ToString();
        if (!isAdmin && string.IsNullOrWhiteSpace(structuredDataJson))
        {
            var defaultStructuredData = isGlobalPublic
                ? new Dictionary<string, object?>
                {
                    ["@context"] = "https://schema.org",
                    ["@type"] = "WebSite",
                    ["name"] = publicSiteName,
                    ["url"] = canonicalBaseUrl,
                    ["description"] = metaDescription
                }
                : new Dictionary<string, object?>
                {
                    ["@context"] = "https://schema.org",
                    ["@type"] = "LodgingBusiness",
                    ["name"] = publicSiteName,
                    ["description"] = metaDescription,
                    ["telephone"] = publicSettings?.Phone,
                    ["email"] = publicSettings?.Email,
                    ["address"] = publicSettings?.Address,
                    ["url"] = canonical,
                    ["logo"] = publicSettings?.LogoUrl,
                    ["image"] = string.IsNullOrWhiteSpace(publicSettings?.OgImageUrl) ? publicSettings?.CoverImageUrl : publicSettings.OgImageUrl
                };
            structuredDataJson = System.Text.Json.JsonSerializer.Serialize(defaultStructuredData);
        }
    }
    <title>@documentTitle</title>
    <meta name="robots" content="@robots"/>
    @if (!isAdmin)
    {
        @if (!string.IsNullOrWhiteSpace(metaDescription))
        {
            <meta name="description" content="@metaDescription"/>
        }

        @if (!string.IsNullOrWhiteSpace(canonical))
        {
            <link rel="canonical" href="@canonical"/>
        }

        @if (!string.IsNullOrWhiteSpace(publicSettings?.FaviconUrl))
        {
            <link rel="icon" href="@publicSettings.FaviconUrl" type="image/png"/>
        }

        @if (!string.IsNullOrWhiteSpace(publicSettings?.GoogleSiteVerification))
        {
            <meta name="google-site-verification" content="@publicSettings.GoogleSiteVerification"/>
        }

        <meta property="og:title" content="@ogTitle"/>
        @if (!string.IsNullOrWhiteSpace(ogDescription))
        {
            <meta property="og:description" content="@ogDescription"/>
        }

        @if (!string.IsNullOrWhiteSpace(ogImage))
        {
            <meta property="og:image" content="@ogImage"/>
            <meta property="og:image:alt" content="@ogTitle"/>
        }

        @if (!string.IsNullOrWhiteSpace(canonical))
        {
            <meta property="og:url" content="@canonical"/>
        }

        <meta property="og:type" content="@ogType"/>
        <meta property="og:site_name" content="@publicSiteName"/>
        <meta name="twitter:card" content="@(string.IsNullOrWhiteSpace(ogImage) ? "summary" : "summary_large_image")"/>
        <meta name="twitter:title" content="@ogTitle"/>
        @if (!string.IsNullOrWhiteSpace(ogDescription))
        {
            <meta name="twitter:description" content="@ogDescription"/>
        }

        @if (!string.IsNullOrWhiteSpace(ogImage))
        {
            <meta name="twitter:image" content="@ogImage"/>
        }

        @if (!string.IsNullOrWhiteSpace(structuredDataJson))
        {
            <script type="application/ld+json">@Html.Raw(structuredDataJson)</script>
        }
    }
    @if (!isAdmin)
    {
        <link rel="preload" href="~/fonts/brand/be-vietnam-pro-400.woff2?v=446d2bf4dee42971" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="~/fonts/brand/be-vietnam-pro-900.woff2?v=6328bd1e835d03f5" as="font" type="font/woff2" crossorigin />
        @if (ViewData["PublicHomeCssBundle"] is true)
        {
            <link rel="preload" href="~/fonts/brand/be-vietnam-pro-600.woff2?v=005d745804315fcb" as="font" type="font/woff2" crossorigin media="(max-width:820px)" />
            <link rel="preload" href="~/fonts/brand/be-vietnam-pro-700.woff2?v=07f8fd1cdac43745" as="font" type="font/woff2" crossorigin media="(max-width:820px)" />
        }
    }
    @if (!isAdmin && ViewData["PublicHomeCssBundle"] is true)
    {
        <link rel="stylesheet" href="~/css/public-home.bundle.css" asp-append-version="true"
              data-public-row-responsive data-public-row-templates data-public-row-advanced-elements data-public-custom-pages data-booking-core-v2 />
        @await RenderSectionAsync("Head", required: false)
    }
    else
    {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    @if (!isAdmin)
    {
        <link rel="stylesheet" href="~/css/public-ai.css" asp-append-version="true"/>
    }
    <link rel="stylesheet" href="~/css/operational-polish.css" asp-append-version="true"/>
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/css/mobile-final.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true"/>
    @if (!isAdmin)
    {
        <link rel="stylesheet" href="~/css/hospitality-shell.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/public-redesign.css" asp-append-version="true"/>
        @if (publicFaqSections.Count > 0)
        {
            <link rel="stylesheet" href="~/css/public-faq-modal.css" asp-append-version="true"/>
        }
        <link rel="stylesheet" href="~/css/public-lux.css" asp-append-version="true"/>
    }
    }
    @if (!isAdmin && !isGlobalPublic && !publicThemeStandard)
    {
        <link rel="stylesheet" href="@(publicScopePrefix + "/site/custom.css")"/>
    }
    @if (!isAdmin && string.Equals(routePage, "/Booking/Index", StringComparison.OrdinalIgnoreCase) && Context.Request.Query["embed"] == "1")
    {
        <link rel="stylesheet" href="~/css/booking-embed.css" asp-append-version="true"/>
    }
    <link rel="stylesheet" href="~/vendor/flatpickr/flatpickr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/flatpickr/monthSelect.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/date-presentation.css" asp-append-version="true" />
</head>
<body class="@(isAdmin
    ? "admin-body"
    : $"public-body{(publicThemeStandard ? " dl-theme-standard" : " dl-theme-custom")}{(canManageSite && !isPaymentPage ? " public-editor-enabled" : string.Empty)}{(Context.Request.Query["embed"] == "1" ? " public-embedded-page" : string.Empty)}")">
