@{
    var bookingUrl = DeLong.Web.Features.Site.PublicUrlBuilder.BookingHome(publicSiteSlug);
    var lookupUrl = isGlobalPublic ? "/booking/lookup" : DeLong.Web.Features.Site.PublicUrlBuilder.BookingLookup(publicSiteSlug!);
    var customerAccountUrl = isGlobalPublic ? "/customer/account" : $"/h/{publicSiteSlug}/customer/account";
    var customerLoginUrl = isGlobalPublic ? "/customer/login" : $"/h/{publicSiteSlug}/customer/login";
    var publicHomeUrl = isGlobalPublic ? "/" : DeLong.Web.Features.Site.PublicUrlBuilder.PropertyHome(publicSiteSlug!);
    var currentPublicPath = Context.Request.Path.Value ?? "/";
    var isPolicyPath = DeLong.Web.Features.Site.PublicPolicyLinks.All.Any(x => currentPublicPath.TrimEnd('/').EndsWith("/" + x.Slug, StringComparison.OrdinalIgnoreCase));
    var isLookupPath = string.Equals(routePage, "/Booking/Lookup", StringComparison.OrdinalIgnoreCase);
    var isHomePath = string.Equals(routePage, "/Index", StringComparison.OrdinalIgnoreCase);
    var footerFacebookUrl = publicContacts.Select(x => x.FacebookUrl).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
    var footerHotline = publicContacts.Select(x => x.Phone).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
    ViewData["PublicFacebookUrl"] = footerFacebookUrl;
    ViewData["PublicHotline"] = footerHotline;
    ViewData["PublicBookingUrl"] = bookingUrl;
    <header class="public-site-header">
        <span class="lux-scroll-progress" aria-hidden="true"></span>
        <div class="public-container public-site-nav">
            <a class="public-site-brand"
               href="@(isGlobalPublic ? "/" : DeLong.Web.Features.Site.PublicUrlBuilder.PropertyHome(publicSiteSlug!))">
                @if (!string.IsNullOrWhiteSpace(publicLogoUrl))
                {
                    <img class="public-site-brand-logo" src="@publicLogoUrl" alt="@publicSiteName"/>
                }
                else
                {
                    <span class="brand-mark">@brandInitials</span>
                }
                <span><strong>@publicSiteName</strong><small>@publicTagline</small></span>
            </a>
            @if (publicFaqSections.Count > 0)
            {
                <button type="button" class="public-faq-mobile" data-public-faq-open aria-haspopup="dialog" aria-controls="public-faq-dialog">FAQ</button>
            }
            <nav class="public-site-links" aria-label="Điều hướng trang khách">
                <a href="/" aria-current="@(isHomePath ? "page" : null)">Trang chủ</a>
                <a href="@bookingUrl">Lịch phòng</a>
                <a href="/chinh-sach-dat-phong" aria-current="@(isPolicyPath ? "page" : null)">Chính sách</a>
                @if (publicFaqSections.Count > 0)
                {
                    <button type="button" class="public-faq-menu" data-public-faq-open aria-haspopup="dialog" aria-controls="public-faq-dialog">FAQ</button>
                }
                <a href="@lookupUrl" aria-current="@(isLookupPath ? "page" : null)">Tra cứu</a>
            </nav>
            <div class="public-site-actions">
                <a class="public-mobile-lookup" href="@lookupUrl">Tra cứu đơn</a>
                @if (User.IsInRole("Customer"))
                {
                    <a class="public-admin-link public-customer-account-link"
                       href="@customerAccountUrl">@(User.Identity?.Name ?? "Tài khoản")</a>
                    <form class="public-logout-form" method="post" asp-page="/Account/Logout">
                        <button class="public-admin-link public-logout-link" type="submit" title="Đăng xuất">Đăng xuất</button>
                    </form>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="public-admin-link" asp-page="/Admin/Index">Quản trị</a>
                }
                else
                {
                    <a class="public-admin-link public-customer-login-link" href="@customerLoginUrl">Đăng nhập</a>
                }
                <a class="public-btn public-btn-primary" href="@bookingUrl">Đặt phòng</a>
            </div>
        </div>
    </header>
    <main class="public-main" id="main-content" tabindex="-1">@RenderBody()</main>
    <footer class="public-hospitality-footer">
        <section class="lux-footer-cta" aria-label="Đặt phòng">
            <div class="public-container">
                <h2>Đến nghỉ <em>một chút.</em></h2>
                <div class="lux-footer-cta-actions">
                    <a class="public-btn public-btn-primary" href="@bookingUrl">Đặt phòng</a>
                    @if (!string.IsNullOrWhiteSpace(footerFacebookUrl))
                    {
                        <a class="public-btn public-btn-ghost" href="@footerFacebookUrl" target="_blank" rel="noopener">Nhắn Facebook</a>
                    }
                    else if (!string.IsNullOrWhiteSpace(footerHotline))
                    {
                        <a class="public-btn public-btn-ghost" href="tel:@footerHotline.Replace(" ", string.Empty)">Gọi @footerHotline</a>
                    }
                </div>
            </div>
        </section>
        @if (publicContacts.Count > 0)
        {
            <section class="public-container public-footer-contacts" aria-labelledby="public-footer-contacts-title">
                <div class="public-footer-contacts-head">
                    <div>
                        <span class="public-eyebrow">liên hệ</span>
                        <h2 id="public-footer-contacts-title">@(publicContacts.Count > 1 ? "Liên hệ từng cơ sở" : "Liên hệ với chúng tôi")</h2>
                    </div>
                    <a class="public-btn public-btn-primary" href="@bookingUrl">Đặt phòng ngay</a>
                </div>
                <div class="public-footer-contact-grid@(publicContacts.Count == 1 ? " is-single" : string.Empty)">
                    @foreach (var contact in publicContacts)
                    {
                        var contactHome = DeLong.Web.Features.Site.PublicUrlBuilder.PropertyHome(contact.SiteSlug);
                        var contactInitials = string.Concat(contact.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => char.ToUpperInvariant(word[0])));
                        var contactTel = contact.Phone.Replace(" ", string.Empty);
                        // Map: an embed link is used as is; otherwise the address is shown on an embedded Google map.
                        var mapEmbed = contact.GoogleMapsUrl.Contains("/maps/embed", StringComparison.OrdinalIgnoreCase)
                            ? contact.GoogleMapsUrl
                            : !string.IsNullOrWhiteSpace(contact.Address) ? $"https://www.google.com/maps?q={Uri.EscapeDataString(contact.Address)}&output=embed" : string.Empty;
                        var mapLink = !string.IsNullOrWhiteSpace(contact.GoogleMapsUrl) && !contact.GoogleMapsUrl.Contains("/maps/embed", StringComparison.OrdinalIgnoreCase)
                            ? contact.GoogleMapsUrl
                            : !string.IsNullOrWhiteSpace(contact.Address) ? $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(contact.Address)}" : contact.GoogleMapsUrl;
                        var contactEmpty = string.IsNullOrWhiteSpace(contact.Address) && string.IsNullOrWhiteSpace(contact.Phone) && string.IsNullOrWhiteSpace(contact.ZaloUrl) && string.IsNullOrWhiteSpace(contact.FacebookUrl) && string.IsNullOrWhiteSpace(mapLink);
                        <article class="public-footer-contact-card">
                            <div class="public-footer-contact-info">
                                <a class="public-footer-contact-brand" href="@contactHome">
                                    @if (!string.IsNullOrWhiteSpace(contact.LogoUrl))
                                    {
                                        <img src="@contact.LogoUrl" alt="" loading="lazy"/>
                                    }
                                    else
                                    {
                                        <span class="brand-mark" aria-hidden="true">@contactInitials</span>
                                    }
                                    <span><strong>@contact.Name</strong>@if (!string.IsNullOrWhiteSpace(contact.Tagline)) { <small>@contact.Tagline</small> }</span>
                                </a>
                                @if (!string.IsNullOrWhiteSpace(contact.Address))
                                {
                                    <address class="public-footer-contact-address"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>@contact.Address</address>
                                }
                                @if (!string.IsNullOrWhiteSpace(contact.Phone))
                                {
                                    <a class="public-footer-contact-hotline" href="tel:@contactTel"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>@contact.Phone</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(contact.ZaloUrl) || !string.IsNullOrWhiteSpace(contact.FacebookUrl))
                                {
                                    <div class="public-footer-contact-social">
                                        @if (!string.IsNullOrWhiteSpace(contact.ZaloUrl))
                                        {
                                            <a class="is-zalo" href="@contact.ZaloUrl" target="_blank" rel="noopener"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4Z"/></svg>Zalo</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(contact.FacebookUrl))
                                        {
                                            <a class="is-facebook" href="@contact.FacebookUrl" target="_blank" rel="noopener"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 3h-3a4 4 0 0 0-4 4v3H5v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3Z"/></svg>Facebook</a>
                                        }
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(mapEmbed) || !string.IsNullOrWhiteSpace(mapLink))
                            {
                                <div class="public-footer-contact-map@(string.IsNullOrWhiteSpace(mapEmbed) ? " is-link-only" : string.Empty)">
                                    @if (!string.IsNullOrWhiteSpace(mapEmbed))
                                    {
                                        <iframe data-map-src="@mapEmbed" title="Bản đồ @contact.Name" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                                    }
                                    else
                                    {
                                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2ZM9 4v14M15 6v14"/></svg>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(mapLink))
                                    {
                                        <a class="public-footer-contact-directions" href="@mapLink" target="_blank" rel="noopener">Chỉ đường ↗</a>
                                    }
                                </div>
                            }
                            @if (contactEmpty)
                            {
                                <p class="public-footer-contact-empty">
                                    @if (canManageSite)
                                    {
                                        <span>Chưa có địa chỉ, hotline, Zalo, Facebook hay bản đồ cho cơ sở này.</span>
                                        <a href="/Admin/Site?propertyId=@contact.PropertyId">Nhập thông tin liên hệ →</a>
                                    }
                                    else
                                    {
                                        <a href="@DeLong.Web.Features.Site.PublicUrlBuilder.PropertyHome(contact.SiteSlug)">Xem các phòng tại @contact.Name →</a>
                                    }
                                </p>
                            }
                        </article>
                    }
                </div>
            </section>
        }
        <div class="public-container public-hospitality-footer-grid">
            <div class="public-footer-brand">
                <a class="public-site-brand public-footer-brand-link"
                   href="@(isGlobalPublic ? "/" : DeLong.Web.Features.Site.PublicUrlBuilder.PropertyHome(publicSiteSlug!))">
                    @if (!string.IsNullOrWhiteSpace(publicLogoUrl))
                    {
                        <img class="public-site-brand-logo" src="@publicLogoUrl" alt="@publicSiteName"/>
                    }
                    else
                    {
                        <span class="brand-mark">@brandInitials</span>
                    }
                    <span><strong>@publicSiteName</strong><small>@publicTagline</small></span>
                </a>
                <p>Một nơi để nghỉ chậm lại, chọn phòng rõ ràng và gửi yêu cầu đặt chỗ trực tiếp.</p>
                <a class="public-footer-book" href="@bookingUrl">Đặt phòng →</a>
            </div>
            <div class="public-footer-column">
                <strong>Khám phá</strong>
                <a href="/">Trang chủ</a>
                <a href="@bookingUrl">Đặt phòng</a>
                <a href="@lookupUrl">Tra cứu</a>
            </div>
            <div class="public-footer-column public-footer-policies">
                <strong>Chính sách</strong>
                @foreach (var policy in DeLong.Web.Features.Site.PublicPolicyLinks.All)
                {
                    <a href="/@policy.Slug">@policy.Title</a>
                }
            </div>

            @if (!isGlobalPublic && publicSettings is not null && !string.IsNullOrWhiteSpace(publicSettings.Email))
            {
                <div class="public-footer-column public-footer-contact">
                    <strong>Email</strong>
                    <a href="mailto:@publicSettings.Email">@publicSettings.Email</a>
                </div>
            }
        </div>
        <div class="public-container public-footer-bottom"><span>© @DateTime.UtcNow.Year @publicSiteName</span><span>Đặt phòng trực tiếp · Giá rõ ràng · Xác nhận bởi nhân viên</span>
        </div>
        <div class="public-footer-wordmark" aria-hidden="true">@publicSiteName.ToUpperInvariant()</div>
    </footer>
}
@if (!isAdmin && !isPaymentPage)
{
    <button class="public-ai-launch" type="button" data-public-ai-open aria-label="Mở trợ lý đặt phòng" hidden>AI</button>
    <div class="public-ai-backdrop" data-public-ai-backdrop hidden></div>
    <aside class="public-ai-drawer" data-public-ai-drawer data-site-slug="@publicSiteSlug" hidden aria-label="Trợ lý đặt phòng">
        <header><div><strong>Trợ lý đặt phòng</strong><small>Hỏi về phòng, tiện nghi và giá</small></div><nav><button type="button" data-public-ai-history title="Lịch sử" aria-label="Xem lịch sử">☰</button><button type="button" data-public-ai-new title="Chat mới" aria-label="Tạo chat mới">＋</button><button type="button" data-public-ai-close aria-label="Đóng">×</button></nav></header>
        <section class="public-ai-history" data-public-ai-history-panel hidden><div><strong>Lịch sử trên thiết bị này</strong><button type="button" data-public-ai-history-close aria-label="Đóng lịch sử">×</button></div><div data-public-ai-history-list></div><small>Lịch sử được lưu trong trình duyệt này trong tối đa 30 ngày.</small></section>
        <div class="public-ai-messages" data-public-ai-messages><div class="public-ai-message assistant">Xin chào! Tôi có thể tư vấn phòng, giá, FAQ, nội quy và chính sách. Bạn cũng có thể tra cứu đơn bằng mã đặt phòng và số điện thoại, hoặc dùng email để nhận thông tin qua hộp thư.</div></div>
        <form data-public-ai-form><textarea rows="2" maxlength="1000" data-public-ai-input placeholder="Ví dụ: Phòng nào phù hợp cho 3 người?"></textarea><button type="submit">Gửi</button></form>
    </aside>
}
@if (!isAdmin && publicFaqSections.Count > 0)
{
    <partial name="_PublicFaqModal" model="publicFaqSections" />
    <script src="~/js/core/public-faq-modal.js" asp-append-version="true"></script>
}
<div id="global-toast-root" class="toast-root" aria-live="polite"></div>
@if (needsVue)
{
    <script src="~/vendor/vue/vue.global.prod.js" asp-append-version="true"></script>
}
<script src="~/vendor/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
<script src="~/vendor/flatpickr/vn.js" asp-append-version="true"></script>
<script src="~/vendor/flatpickr/monthSelect.js" asp-append-version="true"></script>
<script src="~/js/core/date-presentation.js" asp-append-version="true"></script>
<script src="~/js/core/rich-text-tools.js" asp-append-version="true"></script>
<script src="~/js/core/image-upload.js" asp-append-version="true"></script>
<script src="~/js/core/api.js" asp-append-version="true"></script>
<script src="~/js/core/password-strength.js" asp-append-version="true"></script>
<script src="~/js/core/shell.js" asp-append-version="true"></script>
@if (!isAdmin && !isPaymentPage)
{
    <script src="~/js/core/public-ai-chat.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
@if (!isAdmin && !isGlobalPublic)
{
    <script src="@(publicScopePrefix + "/site/custom.js")"></script>
}
</body>
</html>
