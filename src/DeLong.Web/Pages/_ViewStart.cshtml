@inject DeLong.Web.Data.AppDbContext BrandingDb
@inject DeLong.Web.Features.Site.SiteContentService BrandingContent
@inject DeLong.Web.Features.Site.PublicPropertyResolver BrandingProperties
@{
    Layout = "_Layout";
    if (!Context.Request.Path.StartsWithSegments("/setup"))
    {
        var properties = await BrandingProperties.GetActiveAsync(Context.RequestAborted);
        ViewData["GlobalBranding"] = await DeLong.Web.Features.Site.GlobalSiteBrandingStore.ResolveAsync(
            BrandingDb, BrandingContent, properties, Context.RequestAborted);
    }
}
