@page
@model DeLong.Web.Pages.Blog.DetailsModel
@{
    ViewData["Title"] = Model.Post.Title;
    ViewData["MetaDescription"] = Model.Post.Excerpt;
    ViewData["CanonicalPath"] = $"/h/{Model.Post.PropertySiteSlug}/blog/{Model.Post.Slug}";
    ViewData["OgTitle"] = Model.Post.Title;
    ViewData["OgDescription"] = Model.Post.Excerpt;
    ViewData["OgImage"] = Model.Post.CoverImageUrl;
    ViewData["OgType"] = "article";
    var articleStructuredData = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Article",
        ["headline"] = Model.Post.Title,
        ["description"] = Model.Post.Excerpt,
        ["image"] = string.IsNullOrWhiteSpace(Model.Post.CoverImageUrl) ? null : Model.Post.CoverImageUrl,
        ["datePublished"] = Model.Post.PublishedAtUtc?.ToUniversalTime().ToString("O"),
        ["dateModified"] = Model.Post.PublishedAtUtc?.ToUniversalTime().ToString("O"),
        ["author"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = Model.Post.PropertyName },
        ["publisher"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = "De Long Homestay" }
    };
    ViewData["StructuredData"] = System.Text.Json.JsonSerializer.Serialize(articleStructuredData);
}
@section Head {
    <link rel="stylesheet" href="~/css/public-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hospitality-editorial.css" asp-append-version="true" />
}
<article class="public-blog-article">
    <div class="public-container">
        <nav class="public-breadcrumb" aria-label="Breadcrumb"><a href="/">Trang chủ</a><span>›</span><a href="/h/@Model.Post.PropertySiteSlug">@Model.Post.PropertyName</a><span>›</span><a href="/h/@Model.Post.PropertySiteSlug/blog">Blog</a><span>›</span><span aria-current="page">@Model.Post.Title</span></nav>
        <div class="public-blog-article-shell">
            <header class="public-blog-article-header"><span class="public-eyebrow">@Model.Post.PropertyName</span><h1>@Model.Post.Title</h1><p>@Model.Post.Excerpt</p>@if (Model.Post.PublishedAtUtc.HasValue) { <small>@Model.Post.PublishedAtUtc.Value.ToString("dd/MM/yyyy")</small> }</header>
            @if (!string.IsNullOrWhiteSpace(Model.Post.CoverImageUrl)) { <figure class="public-blog-article-cover"><img src="@Model.Post.CoverImageUrl" alt="@Model.Post.Title" /></figure> }
            <div class="public-blog-body">@Html.Raw(Model.Post.BodyHtml)</div>
        </div>
    </div>
</article>
