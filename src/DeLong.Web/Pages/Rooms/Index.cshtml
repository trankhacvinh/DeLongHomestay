@page "/rooms"
@using DeLong.Web.Features.Site
@model DeLong.Web.Pages.Rooms.IndexModel
@{
    var activePropertyCount = Model.GlobalCatalog.Properties.Count;
    var hasMultipleProperties = Model.IsGlobal && activePropertyCount > 1;
    var singlePropertyName = Model.IsGlobal && activePropertyCount == 1 ? Model.GlobalCatalog.Properties[0].SiteName : null;
    ViewData["Title"] = Model.IsGlobal ? "Tất cả phòng" : $"Phòng · {Model.PropertyName}";
    ViewData["MetaDescription"] = Model.IsGlobal ? "Khám phá các phòng đang mở tại De Long Homestay, so sánh không gian, tiện nghi và mức giá." : $"Khám phá các phòng đang mở tại {Model.PropertyName}, xem tiện nghi và chọn cách lưu trú phù hợp.";
    ViewData["CanonicalPath"] = Model.IsGlobal ? "/rooms" : PublicUrlBuilder.Rooms(Model.SiteSlug);
}

@section Head {
    <link rel="stylesheet" href="~/css/public-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-room-content.css" asp-append-version="true" />
}

<section class="public-page-hero public-rooms-hero public-rooms-hero-v2"><div class="public-container public-page-hero-inner"><div><span class="public-eyebrow">@(Model.IsGlobal ? $"{Model.DisplayRooms.Count} phòng đang hiển thị" : $"{Model.Catalog.Rooms.Count} phòng")</span><h1>@(Model.IsGlobal ? (hasMultipleProperties ? "Khám phá phòng ở tất cả cơ sở." : $"Khám phá phòng tại {singlePropertyName ?? "De Long Homestay"}.") : $"Phòng tại {Model.PropertyName}")</h1><p>@(Model.IsGlobal ? (hasMultipleProperties ? "Lọc theo cơ sở hoặc tìm theo tên, mã phòng, tiện nghi. Mỗi phòng luôn hiển thị rõ đang thuộc chi nhánh nào." : "Tìm theo tên, mã phòng hoặc tiện nghi để chọn không gian phù hợp.") : "Chọn theo phong cách, tiện nghi và cách lưu trú phù hợp.")</p></div>@if (!Model.IsGlobal && !string.IsNullOrWhiteSpace(Model.SiteSlug)) { <a class="public-btn public-btn-primary" href="@PublicUrlBuilder.Booking(Model.SiteSlug)">Đặt phòng</a> }</div></section>

@if (Model.IsGlobal && Model.GlobalCatalog.Rooms.Count > 0)
{
    <section class="public-room-filter-section"><div class="public-container"><form class="public-room-filter" method="get" action="/rooms">@if (hasMultipleProperties) { <label><span>Cơ sở</span><select name="property"><option value="">Tất cả cơ sở</option>@foreach (var property in Model.GlobalCatalog.Properties) { <option value="@property.SiteSlug" selected="@(string.Equals(Model.PropertyFilter, property.SiteSlug, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@property.SiteName (@property.RoomCount)</option> }</select></label> }<label class="public-room-filter-search"><span>Tìm phòng</span><input name="q" value="@Model.Search" placeholder="Tên, mã phòng, tiện nghi…" /></label><button class="public-btn public-btn-primary" type="submit">Lọc</button>@if (!string.IsNullOrWhiteSpace(Model.PropertyFilter) || !string.IsNullOrWhiteSpace(Model.Search)) { <a class="public-btn public-btn-ghost" href="/rooms">Xóa lọc</a> }</form></div></section>
}

<section class="public-section public-room-catalog-section public-room-catalog-v2"><div class="public-container">
@if (Model.IsGlobal)
{
    if (Model.DisplayRooms.Count == 0) { <div class="public-empty-state"><strong>Không tìm thấy phòng phù hợp.</strong><p>@(hasMultipleProperties ? "Thử đổi cơ sở hoặc từ khóa tìm kiếm." : "Thử đổi từ khóa tìm kiếm.")</p></div> }
    else { <div class="public-room-grid public-room-grid-catalog-v2">@foreach (var item in Model.DisplayRooms) { var room = item.Room; <article class="public-room-card-v2"><a class="public-room-card-v2-media" href="@PublicUrlBuilder.Room(item.PropertySiteSlug, room.Slug)">@if (!string.IsNullOrWhiteSpace(room.CoverCardUrl)) { <img src="@room.CoverCardUrl" alt="@room.Name" width="900" height="675" loading="lazy" /> } else { <span class="public-room-poster public-room-poster-v2" data-room-code="@room.Code"><small>@(hasMultipleProperties ? item.PropertyName : room.Code)</small><strong>@room.Name</strong></span> }<span class="public-room-code-badge">@room.Code</span><div class="public-room-media-badges">@if (hasMultipleProperties) { <span>@item.PropertyName</span> }<span>@room.Capacity người</span>@if (room.HasBathtub) { <span>Bồn tắm</span> }</div></a><div class="public-room-card-v2-body"><div class="public-room-card-v2-heading">@if (hasMultipleProperties) { <span class="public-room-property-link"><a href="@PublicUrlBuilder.PropertyHome(item.PropertySiteSlug)">@item.PropertyName</a></span> }<h2><a href="@PublicUrlBuilder.Room(item.PropertySiteSlug, room.Slug)">@room.Name</a></h2><p>@(string.IsNullOrWhiteSpace(room.ShortDescription) ? "Không gian riêng tư với nhiều lựa chọn thời gian." : room.ShortDescription)</p></div><div class="public-room-price-grid"><div><small>Đặt nhanh từ</small><strong>@room.QuickFromPrice.ToString("N0")đ</strong></div>@if (room.NightlyPrice.HasValue) { <div><small>Lưu trú</small><strong>@room.NightlyPrice.Value.ToString("N0")đ<em>/đêm</em></strong></div> }</div><div class="public-room-card-v2-footer"><a class="public-text-link" href="@PublicUrlBuilder.Room(item.PropertySiteSlug, room.Slug)">Xem phòng →</a></div></div></article> }</div> }
}
else
{
    <div class="public-room-grid public-room-grid-catalog-v2">@foreach (var room in Model.Catalog.Rooms) { <article class="public-room-card-v2"><a class="public-room-card-v2-media" href="@PublicUrlBuilder.Room(Model.SiteSlug!, room.Slug)">@if (!string.IsNullOrWhiteSpace(room.CoverCardUrl)) { <img src="@room.CoverCardUrl" alt="@room.Name" width="900" height="675" loading="lazy" /> } else { <span class="public-room-poster public-room-poster-v2" data-room-code="@room.Code"><small>@room.Code</small><strong>@room.Name</strong></span> }<span class="public-room-code-badge">@room.Code</span><div class="public-room-media-badges"><span>@room.Capacity người</span>@if (room.HasBathtub) { <span>Bồn tắm</span> }</div></a><div class="public-room-card-v2-body"><div class="public-room-card-v2-heading"><h2><a href="@PublicUrlBuilder.Room(Model.SiteSlug!, room.Slug)">@room.Name</a></h2><p>@(string.IsNullOrWhiteSpace(room.ShortDescription) ? "Không gian riêng tư với nhiều lựa chọn thời gian." : room.ShortDescription)</p></div><div class="public-room-price-grid"><div><small>Đặt nhanh từ</small><strong>@room.QuickFromPrice.ToString("N0")đ</strong></div>@if (room.NightlyPrice.HasValue) { <div><small>Lưu trú</small><strong>@room.NightlyPrice.Value.ToString("N0")đ<em>/đêm</em></strong></div> }</div><div class="public-room-card-v2-footer"><a class="public-text-link" href="@PublicUrlBuilder.Room(Model.SiteSlug!, room.Slug)">Xem phòng →</a></div></div></article> }</div>
}
</div></section>
