@page "/rooms/{code}"
@using DeLong.Web.Domain.Enums
@model DeLong.Web.Pages.Rooms.DetailsModel
@{
    ViewData["Title"] = Model.Room.Name;
    var quickRates = Model.Room.Rates.Where(rate => rate.Type != RoomRateType.Nightly).ToList();
    var nightlyRate = Model.Room.Rates.FirstOrDefault(rate => rate.Type == RoomRateType.Nightly);
    var cover = Model.Room.Images.FirstOrDefault(image => image.IsCover) ?? Model.Room.Images.FirstOrDefault();
}

@section Head {
    <link rel="stylesheet" href="~/css/public-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-room-content.css" asp-append-version="true" />
}

<section class="public-room-detail-hero public-rich-room-hero">
    <div class="public-container public-rich-room-layout">
        <div class="public-rich-room-media">
            @if (cover is not null)
            {
                <figure class="public-room-cover-hero">
                    <img src="@cover.LargeUrl" alt="@cover.AltText" width="1600" height="1200" />
                </figure>
                @if (Model.Room.Images.Count > 1)
                {
                    <div class="public-room-gallery-strip" aria-label="Thư viện ảnh @Model.Room.Name">
                        @foreach (var image in Model.Room.Images.Take(5))
                        {
                            <a href="@image.LargeUrl" target="_blank" rel="noopener" aria-label="Mở ảnh @image.AltText">
                                <img src="@image.ThumbnailUrl" alt="@image.AltText" width="480" height="360" loading="lazy" />
                            </a>
                        }
                        @if (Model.Room.Images.Count > 5)
                        {
                            <span class="public-gallery-more">+@(Model.Room.Images.Count - 5)</span>
                        }
                    </div>
                }
            }
            else
            {
                <div class="public-room-detail-art public-room-art" data-room-code="@Model.Room.Code">
                    <span class="public-room-poster public-room-poster-detail">
                        <small>DE LONG STAY · @Model.Room.Code</small>
                        <strong>@Model.Room.Name</strong>
                    </span>
                </div>
            }
        </div>

        <div class="public-room-detail-copy public-rich-room-copy">
            <span class="public-eyebrow">@Model.Room.Code</span>
            <h1>@Model.Room.Name</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Room.ShortDescription))
            {
                <p>@Model.Room.ShortDescription</p>
            }
            else
            {
                <p>Một không gian riêng tư dành cho tối đa @Model.Room.Capacity người, có lựa chọn nghỉ ngắn theo khung và lưu trú nhiều ngày khi giá theo đêm được mở.</p>
            }

            @if (Model.Room.Tags.Count > 0)
            {
                <div class="public-room-tag-row public-room-tag-row-detail">
                    @foreach (var tag in Model.Room.Tags) { <span>@tag</span> }
                </div>
            }

            <div class="public-room-detail-facts">
                <div><small>Sức chứa</small><strong>@Model.Room.Capacity người</strong></div>
                <div><small>Đặt nhanh</small><strong>@quickRates.Count lựa chọn</strong></div>
                <div><small>Giá từ</small><strong>@Model.Room.FromPrice.ToString("N0")đ</strong></div>
            </div>

            @if (Model.Room.Highlights.Count > 0)
            {
                <div class="public-room-highlights">
                    @foreach (var highlight in Model.Room.Highlights.Take(5))
                    {
                        <div><span>✓</span><strong>@highlight</strong></div>
                    }
                </div>
            }

            <a class="public-btn public-btn-primary" asp-page="/Booking/Index" asp-route-room="@Model.Room.Code">Kiểm tra phòng trống</a>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Room.DescriptionHtml) || Model.Room.Amenities.Count > 0)
{
    <section class="public-section public-room-story-section">
        <div class="public-container public-room-story-grid">
            <article class="public-room-story">
                <span class="public-eyebrow">Không gian</span>
                <h2>Về @Model.Room.Name</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Room.DescriptionHtml))
                {
                    <div class="public-room-richtext">@Html.Raw(Model.Room.DescriptionHtml)</div>
                }
                else
                {
                    <p class="public-room-story-fallback">Nội dung chi tiết đang được cập nhật.</p>
                }
            </article>
            @if (Model.Room.Amenities.Count > 0)
            {
                <aside class="public-room-amenities">
                    <span class="public-eyebrow">Tiện nghi</span>
                    <h3>Có sẵn trong phòng</h3>
                    <div class="public-amenity-grid">
                        @foreach (var amenity in Model.Room.Amenities)
                        {
                            <span>@amenity</span>
                        }
                    </div>
                </aside>
            }
        </div>
    </section>
}

<section class="public-section public-room-detail-rates">
    <div class="public-container public-detail-content-grid">
        <div>
            @if (nightlyRate is not null)
            {
                <span class="public-eyebrow">Lưu trú nhiều ngày</span>
                <h2>Ở lâu hơn với giá theo đêm riêng</h2>
                <div class="public-rate-list">
                    <a class="public-rate-row" asp-page="/Booking/Index" asp-route-room="@Model.Room.Code">
                        <div>
                            <strong>@nightlyRate.Name</strong>
                            <span>Nhận @nightlyRate.StartTime · trả @nightlyRate.EndTime ngày cuối</span>
                        </div>
                        <strong>@nightlyRate.Price.ToString("N0")đ/đêm</strong>
                    </a>
                </div>
            }

            <span class="public-eyebrow" style="margin-top:@(nightlyRate is null ? "0" : "28px")">Đặt nhanh</span>
            <h2>Chọn khoảng thời gian phù hợp</h2>
            <div class="public-rate-list">
                @foreach (var rate in quickRates)
                {
                    <a class="public-rate-row" asp-page="/Booking/Index" asp-route-room="@Model.Room.Code" asp-route-rate="@rate.Id">
                        <div>
                            <strong>@rate.Name</strong>
                            <span>@rate.StartTime → @rate.EndTime @(rate.Type == RoomRateType.Overnight ? "· qua đêm" : "")</span>
                        </div>
                        <strong>@rate.Price.ToString("N0")đ</strong>
                    </a>
                }
            </div>
        </div>
        <aside class="public-detail-note">
            <span class="public-eyebrow">Lưu ý</span>
            <h3>Giờ trên website là giờ cấu hình của từng gói.</h3>
            <p>Với lưu trú nhiều ngày, hệ thống kiểm tra phòng trống liên tục từ giờ nhận ngày đầu đến giờ trả ngày cuối. De Long sẽ liên hệ xác nhận trước khi giữ phòng chính thức.</p>
            <ul>
                <li>Yêu cầu online chưa tự động khóa phòng.</li>
                <li>Giá lưu trú nhiều ngày được tính theo số đêm.</li>
                <li>Phòng chỉ được giữ sau khi nhân viên xác nhận.</li>
            </ul>
        </aside>
    </div>
</section>
