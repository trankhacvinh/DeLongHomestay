@page "/rooms/{code}"
@using DeLong.Web.Domain.Enums
@using DeLong.Web.Features.Site
@model DeLong.Web.Pages.Rooms.DetailsModel
@{
    ViewData["Title"] = Model.Room.Name;
    var timeSlotRates = Model.Room.Rates.Where(rate => rate.Type == RoomRateType.TimeSlot).ToList();
    var overnightRate = Model.Room.Rates.FirstOrDefault(rate => rate.Type == RoomRateType.Overnight);
    var nightlyRate = Model.Room.Rates.FirstOrDefault(rate => rate.Type == RoomRateType.Nightly);
    var cover = Model.Room.Images.FirstOrDefault(image => image.IsCover) ?? Model.Room.Images.FirstOrDefault();
    var orderedImages = cover is null
        ? Model.Room.Images
        : new[] { cover }.Concat(Model.Room.Images.Where(x => x.Id != cover.Id)).ToList();
    string AmenitySymbol(string amenity)
    {
        var text = (amenity ?? string.Empty).Trim().ToLowerInvariant();
        if (text.Contains("wifi") || text.Contains("wi-fi")) return "⌁";
        if (text.Contains("máy lạnh") || text.Contains("điều hòa")) return "❄";
        if (text.Contains("bồn tắm") || text.Contains("bathtub")) return "♨";
        if (text.Contains("netflix") || text.Contains("tv") || text.Contains("tivi")) return "▣";
        if (text.Contains("máy sấy")) return "≈";
        if (text.Contains("bãi xe") || text.Contains("đỗ xe")) return "P";
        if (text.Contains("tủ lạnh")) return "◇";
        return "✦";
    }
}

@section Head {
    <link rel="stylesheet" href="~/css/public-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.css" />
    <link rel="stylesheet" href="~/css/public-room-content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-room-richtext-media.css" asp-append-version="true" />
}

<main class="public-room-page">
    <section class="public-room-intro">
        <div class="public-container">
            <nav class="public-breadcrumb" aria-label="Breadcrumb"><a href="/">Trang chủ</a><span>›</span><a href="@PublicUrlBuilder.PropertyHome(Model.SiteSlug!)">@Model.PropertyName</a><span>›</span><a href="@PublicUrlBuilder.Rooms(Model.SiteSlug)">Phòng</a><span>›</span><span aria-current="page">@Model.Room.Name</span></nav>
            <div class="public-room-intro-row">
                <div>
                    <span class="public-eyebrow">@Model.Room.Code</span>
                    <h1>@Model.Room.Name</h1>
                    <p>@(string.IsNullOrWhiteSpace(Model.Room.ShortDescription)
                        ? $"Không gian riêng tư dành cho tối đa {Model.Room.Capacity} người tại {Model.PropertyName}."
                        : Model.Room.ShortDescription)</p>
                </div>
                @if (Model.Room.Tags.Count > 0)
                {
                    <div class="public-room-tag-row public-room-intro-tags">
                        @foreach (var tag in Model.Room.Tags.Take(5)) { <span>@tag</span> }
                    </div>
                }
            </div>

            @if (orderedImages.Count > 0)
            {
                <div id="room-gallery" class="public-room-mosaic pswp-gallery public-room-mosaic-count-@Math.Min(orderedImages.Count, 5)" aria-label="Thư viện ảnh @Model.Room.Name">
                    @for (var i = 0; i < Math.Min(orderedImages.Count, 5); i++)
                    {
                        var image = orderedImages[i];
                        var isPrimary = i == 0;
                        <a class="public-room-mosaic-item @(isPrimary ? "is-primary" : "")"
                           href="@image.LargeUrl"
                           data-pswp-width="@image.LargeWidth"
                           data-pswp-height="@image.LargeHeight"
                           data-cropped="true"
                           target="_blank"
                           rel="noopener"
                           aria-label="Xem ảnh: @image.AltText">
                            <img src="@(isPrimary ? image.LargeUrl : image.CardUrl)"
                                 alt="@image.AltText"
                                 width="@(isPrimary ? image.LargeWidth : 900)"
                                 height="@(isPrimary ? image.LargeHeight : 675)"
                                 style="object-position:@(image.FocalX * 100)% @(image.FocalY * 100)%"
                                 loading="@(isPrimary ? "eager" : "lazy")" />
                            @if (i == Math.Min(orderedImages.Count, 5) - 1 && orderedImages.Count > 1)
                            {
                                <span class="public-gallery-count">Xem tất cả @orderedImages.Count ảnh</span>
                            }
                        </a>
                    }
                    @foreach (var image in orderedImages.Skip(5))
                    {
                        <a class="public-room-gallery-hidden"
                           href="@image.LargeUrl"
                           data-pswp-width="@image.LargeWidth"
                           data-pswp-height="@image.LargeHeight"
                           target="_blank"
                           rel="noopener"
                           aria-label="Xem ảnh: @image.AltText"></a>
                    }
                </div>
            }
            else
            {
                <div class="public-room-detail-art public-room-art public-room-fallback-art" data-room-code="@Model.Room.Code">
                    <span class="public-room-poster public-room-poster-detail"><small>@Model.PropertyName · @Model.Room.Code</small><strong>@Model.Room.Name</strong></span>
                </div>
            }
        </div>
    </section>

    <section class="public-room-content-section">
        <div class="public-container public-room-content-layout">
            <div class="public-room-content-main">
                @if (Model.Room.Highlights.Count > 0)
                {
                    <section class="public-room-content-block public-room-highlight-block">
                        <span class="public-eyebrow">Điểm nổi bật</span>
                        <div class="public-room-highlight-grid">
                            @foreach (var highlight in Model.Room.Highlights.Take(6))
                            {
                                <div><span>✓</span><strong>@highlight</strong></div>
                            }
                        </div>
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Room.DescriptionHtml))
                {
                    <section class="public-room-content-block public-room-story">
                        <span class="public-eyebrow">Không gian</span>
                        <h2>Về @Model.Room.Name</h2>
                        <div class="public-room-richtext">@Html.Raw(Model.Room.DescriptionHtml)</div>
                    </section>
                }

                @if (Model.Room.Amenities.Count > 0)
                {
                    <section class="public-room-content-block">
                        <span class="public-eyebrow">Tiện nghi</span>
                        <h2>Có sẵn trong phòng</h2>
                        <div class="public-amenity-grid public-amenity-grid-wide public-amenity-icon-grid">
                            @foreach (var amenity in Model.Room.Amenities)
                            {
                                <span><i aria-hidden="true">@AmenitySymbol(amenity)</i><b>@amenity</b></span>
                            }
                        </div>
                    </section>
                }

                <section class="public-room-content-block public-room-rate-block">
                    <span class="public-eyebrow">Giá & thời gian</span>
                    <h2>Chọn cách bạn muốn ở</h2>
                    <div class="public-rate-groups">
                        @if (timeSlotRates.Count > 0)
                        {
                            <div class="public-rate-group">
                                <div class="public-rate-group-title"><strong>Đặt nhanh</strong><span>Nghỉ theo khung giờ</span></div>
                                <div class="public-rate-compact-list">
                                    @foreach (var rate in timeSlotRates)
                                    {
                                        <a href="@PublicUrlBuilder.Booking(Model.SiteSlug!, room: Model.Room.Code, rate: rate.Id)">
                                            <span><strong>@rate.Name</strong><small>@rate.StartTime → @rate.EndTime</small></span>
                                            <b>@rate.Price.ToString("N0")đ</b>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        @if (overnightRate is not null)
                        {
                            <div class="public-rate-group">
                                <div class="public-rate-group-title"><strong>Qua đêm</strong><span>Một đêm ngắn</span></div>
                                <a class="public-rate-feature" href="@PublicUrlBuilder.Booking(Model.SiteSlug!, room: Model.Room.Code, rate: overnightRate.Id)">
                                    <span><strong>@overnightRate.StartTime → @overnightRate.EndTime</strong><small>@overnightRate.Name</small></span>
                                    <b>@overnightRate.Price.ToString("N0")đ</b>
                                </a>
                            </div>
                        }
                        @if (nightlyRate is not null)
                        {
                            <div class="public-rate-group public-rate-group-nightly">
                                <div class="public-rate-group-title"><strong>Lưu trú nhiều ngày</strong><span>Giá riêng theo đêm</span></div>
                                <a class="public-rate-feature" href="@PublicUrlBuilder.Booking(Model.SiteSlug!, room: Model.Room.Code)">
                                    <span><strong>Nhận @nightlyRate.StartTime · trả @nightlyRate.EndTime</strong><small>Tính theo số đêm lưu trú</small></span>
                                    <b>@nightlyRate.Price.ToString("N0")đ/đêm</b>
                                </a>
                            </div>
                        }
                    </div>
                </section>
            </div>

            <aside class="public-room-booking-aside">
                <div class="public-room-booking-card public-room-booking-card-v3">
                    <span class="public-eyebrow">Đặt @Model.Room.Name</span>
                    <div class="public-room-booking-price">
                        <small>Giá từ</small>
                        <strong>@Model.Room.QuickFromPrice.ToString("N0")đ</strong>
                    </div>
                    <div class="public-room-booking-facts">
                        <span><b>@Model.Room.Capacity người</b></span>
                        @if (Model.Room.HasBathtub) { <span><b>Có bồn tắm</b></span> }
                        @if (Model.Room.OvernightPrice.HasValue) { <span><b>Qua đêm @Model.Room.OvernightPrice.Value.ToString("N0")đ</b></span> }
                        @if (Model.Room.NightlyPrice.HasValue) { <span><b>Lưu trú @Model.Room.NightlyPrice.Value.ToString("N0")đ/đêm</b></span> }
                    </div>
                    <form class="public-room-quick-book" method="get" action="@PublicUrlBuilder.Booking(Model.SiteSlug!)">
                        <input type="hidden" name="room" value="@Model.Room.Code" />
                        <label><span>Ngày sử dụng</span><input type="date" name="date" /></label>
                        <button class="public-btn public-btn-primary public-room-booking-cta" type="submit">Đặt phòng</button>
                    </form>
                    <div class="public-room-booking-trust"><span>✓ Gửi yêu cầu online nhanh</span><span>✓ Nhân viên xác nhận trước khi giữ phòng</span></div>
                    <p>Bạn chưa cần thanh toán chỉ để gửi yêu cầu. Giờ thực tế có thể được xác nhận lại theo tình trạng phòng.</p>
                </div>
            </aside>
        </div>
    </section>
</main>

@section Scripts {
    <script type="module" src="~/js/pages/public-room-gallery.js" asp-append-version="true"></script>
}