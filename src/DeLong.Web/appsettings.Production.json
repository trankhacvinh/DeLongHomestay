{
  "Database": {
    "AutoMigrate": false,
    "SeedOnStartup": false
  },
  "Storage": {
    "DataRoot": "App_Data",
    "MediaPublicRoot": "wwwroot/uploads/rooms",
    "MediaRequestPath": "/uploads/rooms",
    "RequirePersistent": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
