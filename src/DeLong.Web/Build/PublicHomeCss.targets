<Project>
  <UsingTask TaskName="BuildPublicHomeCss" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Inputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var root = Path.GetDirectoryName(Path.GetFullPath(Destination));
        var reading = new HashSet<string>(StringComparer.Ordinal);
        Func<string, string> expand = null;
        expand = file => {
            file = Path.GetFullPath(file);
            if (!string.Equals(Path.GetDirectoryName(file), root, StringComparison.Ordinal))
                throw new InvalidOperationException("Public CSS inputs must share the bundle directory: " + file);
            if (!reading.Add(file)) throw new InvalidOperationException("Circular CSS import: " + file);
            var css = File.ReadAllText(file);
            css = Regex.Replace(css, @"@import\s+url\([""']?(?<path>[^""')]+)[""']?\)\s*;",
                match => expand(Path.Combine(root, match.Groups["path"].Value)));
            if (Regex.IsMatch(css, @"@import\b")) throw new InvalidOperationException("Unsupported CSS import: " + file);
            reading.Remove(file);
            return "\n/* " + Path.GetFileName(file) + " */\n" + css + "\n";
        };
        var output = new StringBuilder("/* Generated by PublicHomeCss.targets. Edit the source CSS files. */\n");
        foreach (var input in Inputs) output.Append(expand(input.ItemSpec));
        var text = output.ToString();
        if (!File.Exists(Destination) || File.ReadAllText(Destination) != text)
            File.WriteAllText(Destination, text, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <ItemGroup>
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/site.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public-ai.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/operational-polish.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public-polish.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public-room-content.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/homepage-cms.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/hospitality-home.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/hospitality-editorial.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/property-storytelling.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public-availability-calendar.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/mobile-final.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/hospitality-shell.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public-redesign.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public-faq-modal.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public-row-responsive.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public-row-templates.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public-row-advanced-elements.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/public-custom-pages.css" />
    <PublicHomeCss Include="$(MSBuildProjectDirectory)/wwwroot/css/booking-core-v2.css" />
    <Content Remove="wwwroot/css/public-home.bundle.css" />
    <Content Include="wwwroot/css/public-home.bundle.css" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GeneratePublicHomeCss" BeforeTargets="PrepareForBuild">
    <BuildPublicHomeCss Inputs="@(PublicHomeCss)" Destination="$(MSBuildProjectDirectory)/wwwroot/css/public-home.bundle.css" />
  </Target>
</Project>
