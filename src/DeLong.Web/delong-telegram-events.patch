+    public async Task NotifyBookingStatusChangedAsync(
+        Guid propertyId,
+        Guid bookingId,
+        BookingStatus status,
+        string? note = null,
+        CancellationToken cancellationToken = default)
+    {
+        if (status is not (BookingStatus.Confirmed or BookingStatus.Cancelled or BookingStatus.CheckedIn or BookingStatus.Completed))
+            return;
+
+        try
+        {
+            var telegram = await GetTelegramSettingsAsync(propertyId, cancellationToken);
+            if (telegram is null) return;
+            var booking = await GetTelegramBookingAsync(propertyId, bookingId, cancellationToken);
+            if (booking is null) return;
+
+            var timeZone = TimeZoneInfo.FindSystemTimeZoneById(booking.TimeZoneId);
+            var checkInLocal = ToLocal(booking.CheckInUtc, timeZone);
+            var checkOutLocal = ToLocal(booking.CheckOutUtc, timeZone);
+            var eventLocal = ToLocal(DateTime.UtcNow, timeZone);
+            var remaining = Math.Max(0m, booking.Total - booking.Paid);
+
+            var (type, title, header) = status switch
+            {
+                BookingStatus.Confirmed => (BookingConfirmedType, $"Booking đã xác nhận · {booking.Code}", $"✅ {booking.PropertyName} · BOOKING ĐƯỢC XÁC NHẬN"),
+                BookingStatus.Cancelled => (BookingCancelledType, $"Booking đã hủy · {booking.Code}", $"❌ {booking.PropertyName} · BOOKING BỊ HỦY"),
+                BookingStatus.CheckedIn => (BookingCheckedInType, $"Khách đã check-in · {booking.Code}", $"🏠 {booking.PropertyName} · CHECK-IN"),
+                _ => (BookingCheckedOutType, $"Khách đã check-out · {booking.Code}", $"🏠 {booking.PropertyName} · CHECK-OUT / HOÀN TẤT")
+            };
+
+            var notification = new PropertyNotification
+            {
+                PropertyId = propertyId,
+                BookingId = bookingId,
+                Type = type,
+                Title = title,
+                Message = $"{booking.CustomerName} · {booking.RoomName}",
+                ActionUrl = $"/Admin/Bookings?propertyId={propertyId}&bookingId={bookingId}"
+            };
+            db.Add(notification);
+
+            var lines = new List<string>
+            {
+                header,
+                $"Mã: {booking.Code}",
+                $"Khách: {booking.CustomerName}",
+                $"SĐT: {booking.CustomerPhone}",
+                $"Phòng: {booking.RoomName}",
+                $"Nhận: {checkInLocal:dd/MM/yyyy HH:mm}",
+                $"Trả: {checkOutLocal:dd/MM/yyyy HH:mm}"
+            };
+
+            if (status == BookingStatus.Confirmed)
+            {
+                lines.Add($"Tổng tiền: {booking.Total:N0} VND");
+                lines.Add($"Đã thanh toán: {booking.Paid:N0} VND");
+                lines.Add($"Còn lại: {remaining:N0} VND");
+            }
+            else if (status is BookingStatus.CheckedIn or BookingStatus.Completed)
+            {
+                lines.Add($"Thao tác lúc: {eventLocal:dd/MM/yyyy HH:mm}");
+            }
+
+            if (!string.IsNullOrWhiteSpace(note))
+                lines.Add($"Ghi chú: {TrimForTelegram(note, 500)}");
+
+            QueueTelegram(telegram, notification, string.Join(Environment.NewLine, lines));
+            await db.SaveChangesAsync(cancellationToken);
+        }
+        catch (Exception ex)
+        {
+            logger.LogError(ex, "Could not create Telegram status notification {Status} for booking {BookingId}.", status, bookingId);
+            DetachAddedNotificationEntries();
+        }
+    }
