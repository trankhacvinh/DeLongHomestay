+    private async Task<PropertyNotificationSettings?> GetTelegramSettingsAsync(Guid propertyId, CancellationToken cancellationToken)
+    {
+        var settings = await db.Set<PropertyNotificationSettings>().AsNoTracking()
+            .SingleOrDefaultAsync(x => x.PropertyId == propertyId, cancellationToken);
+        return settings is { TelegramBookingEnabled: true } &&
+               !string.IsNullOrWhiteSpace(settings.TelegramChatIds) &&
+               !string.IsNullOrWhiteSpace(settings.TelegramBotTokenProtected)
+            ? settings
+            : null;
+    }
+
+    private async Task<TelegramBookingData?> GetTelegramBookingAsync(Guid propertyId, Guid bookingId, CancellationToken cancellationToken) =>
+        await db.Bookings.AsNoTracking()
+            .Where(x => x.PropertyId == propertyId && x.Id == bookingId)
+            .Select(x => new TelegramBookingData(
+                x.Id,
+                x.Code,
+                x.Customer.Name,
+                x.Customer.Phone,
+                x.Room.Name,
+                x.Property.Name,
+                x.Property.TimeZoneId,
+                x.CheckInUtc,
+                x.CheckOutUtc,
+                x.RoomAmount + x.SpecialSurchargeAmount + x.ExtraAmount - x.DiscountAmount,
+                x.Payments.Where(p => !p.IsVoided)
+                    .Sum(p => p.Type == PaymentType.Receipt ? p.Amount : -p.Amount)))
+            .SingleOrDefaultAsync(cancellationToken);
+
+    private void QueueTelegram(PropertyNotificationSettings settings, PropertyNotification notification, string messageText)
+    {
+        db.Add(new NotificationTelegramOutbox
+        {
+            PropertyId = notification.PropertyId,
+            NotificationId = notification.Id,
+            ChatIds = settings.TelegramChatIds,
+            MessageText = TrimForTelegram(messageText, 4096),
+            NextAttemptAtUtc = DateTime.UtcNow
+        });
+    }
+
+    private void DetachAddedNotificationEntries()
+    {
+        foreach (var entry in db.ChangeTracker.Entries()
+                     .Where(x => x.State == EntityState.Added &&
+                                 x.Entity is PropertyNotification or NotificationEmailOutbox or NotificationTelegramOutbox))
+            entry.State = EntityState.Detached;
+    }
+
+    private static DateTime ToLocal(DateTime utc, TimeZoneInfo timeZone) =>
+        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), timeZone);
+
+    private static string FormatPaymentMethod(PaymentMethod method) => method switch
+    {
+        PaymentMethod.Cash => "Tiền mặt",
+        PaymentMethod.BankTransfer => "Chuyển khoản",
+        PaymentMethod.Card => "Thẻ",
+        PaymentMethod.Pay2S => "Pay2S",
+        _ => "Khác"
+    };
+
+    private static string TrimForTelegram(string value, int maxLength) =>
+        value.Length <= maxLength ? value : value[..Math.Max(0, maxLength - 1)] + "…";
+
+    private sealed record TelegramBookingData(
+        Guid Id, string Code, string CustomerName, string CustomerPhone, string RoomName,
+        string PropertyName, string TimeZoneId, DateTime CheckInUtc, DateTime CheckOutUtc,
+        decimal Total, decimal Paid);
+
